    },
    "./echelons": {
      "types": "./dist/echelons.d.ts",
      "default": "./dist/echelons.js"
    },
    "./redaction": {
      "types": "./dist/redaction.d.ts",
      "default": "./dist/redaction.js"
    },
    "./world": {
      "types": "./dist/world.d.ts",
      "default": "./dist/world.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint:part": "eslint"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
