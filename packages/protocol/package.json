    },
    "./locales": {
      "types": "./dist/locales.d.ts",
      "default": "./dist/locales.js"
    },
    "./approval-policy": {
      "types": "./dist/approval-policy.d.ts",
      "default": "./dist/approval-policy.js"
    },
    "./efforts": {
      "types": "./dist/efforts.d.ts",
      "default": "./dist/efforts.js"
    },
    "./link": {
      "types": "./dist/link.d.ts",
      "default": "./dist/link.js"
    },
    "./map": {
      "types": "./dist/map.d.ts",
      "default": "./dist/map.js"
    },
    "./pipeline-report": {
      "types": "./dist/pipeline-report.d.ts",
