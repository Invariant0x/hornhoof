#!/bin/sh
# Operator commands for the Hornhoof relay. Run as root on the droplet.
#   hornhoof-relay list                 every binding, when it was made and last seen
#   hornhoof-relay add <name>           a binding made by us (no rate limit); prints {name, key} once, keep it secret
#   hornhoof-relay ban <name> [reason]  block a name now: 410 at once, its tunnel dropped within 90 s, nobody can take it
#   hornhoof-relay unban <name>
#   hornhoof-relay release <name>       free a name (its tunnel is dropped within 90 s)
set -eu
relay() { runuser -u hornhoof-relay -- /usr/bin/python3 /usr/local/lib/hornhoof-relay/relay.py admin "$@"; }
relay "$@"
case "${1:-}" in
  ban | unban)
    relay banned-caddy > /etc/caddy/blocked.caddy.new
    mv /etc/caddy/blocked.caddy.new /etc/caddy/blocked.caddy
    chmod 644 /etc/caddy/blocked.caddy
    systemctl reload caddy
    ;;
esac
