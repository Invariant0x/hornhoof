+"""Separate test failures from invalid runs and invalid mutants."""
+
+from __future__ import annotations
+
+import re
+
+from mutator.runner import CommandResult
+
+_ANSI = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]")
+_NO_TESTS = re.compile(
+    r"\bno (?:test files|tests)(?: found)?\b|\bTests\s+0\s+(?:passed|total)\b|"
+    r"\bRan\s+0\s+tests\b|\bcollected\s+0\s+items\b|^# tests 0\s*$",
+    re.IGNORECASE | re.MULTILINE,
+)
+_SKIPPED = re.compile(r"^\s*Tests\s+[^\n]*\b(?:skipped|todo)\b", re.I | re.M)
+_EXECUTED = re.compile(r"^\s*Tests\s+[^\n]*\b[1-9]\d* (?:passed|failed)\b", re.I | re.M)
+_CONFIG = re.compile(
+    r"TSCONFIG_ERROR|failed to load config|cannot find (?:module|package)|"
+    r"cannot resolve.*(?:config|setup)|failed to resolve import|"
+    r"command not found|not recognized as an internal|startup error",
+    re.IGNORECASE,
+)
+_COMPILE = re.compile(
+    r"\berror TS\d+\b|\bTSError\b|\bSyntaxError\b|Transform failed|"
+    r"compilation (?:failed|error)|failed to compile|build failed|"
+    r"error: could not compile|\[build failed\]",
+    re.IGNORECASE,
+)
+
+_TEST_FAILURE = re.compile(
+    r"AssertionError|\bFAIL(?:ED)?\b|\b[1-9]\d*\s+(?:failed|failures|errors)\b|"
+    r"Failures:\s*[1-9]|Errors:\s*[1-9]",
+    re.IGNORECASE,
+)
+
+
+class RunError(RuntimeError):
+    """The command did not execute a valid test run."""
+
+
+def no_tests(text: str) -> bool:
+    return bool(_NO_TESTS.search(text) or (_SKIPPED.search(text) and not _EXECUTED.search(text)))
+
+
+def classify(result: CommandResult) -> str:
+    text = _ANSI.sub("", result.output)
+    if result.timed_out:
+        return "timeout"
+    if _CONFIG.search(text) or result.code in {126, 127, 137, 143} or result.code < 0:
+        raise RunError("test configuration or runner error\n" + text[-4000:])
+    if _COMPILE.search(text):
+        return "compile_error"
+    if no_tests(text):
+        raise RunError("no tests\n" + text[-4000:])
+    if result.code == 0:
+        return "survived"
+    if _TEST_FAILURE.search(text):
+        return "killed"
+    raise RunError("test command failed without test failure evidence\n" + text[-4000:])
+
+
+def require_baseline(result: CommandResult) -> None:
+    if classify(result) != "survived":
+        raise RunError("unmutated tests failed\n" + result.output[-4000:])
