+def worker_modules(root: Path, relative: str) -> set[str]:
+    """Keep JS/TS bootstrap modules inside Vite's worker root too.
+
+    Test setup and configuration can load modules that no test imports.
+    A symlink to one of them resolves outside the worker and Vitest refuses
+    it before running any tests, which looks like a killed mutant.
+    """
+
+    if Path(relative).suffix in _EXTENSIONS:
+        return {source.relative_to(root).as_posix() for source in _source_files(root)}
+    return importers_of(root, relative)
+
+
