{
  "name": "@hornhoof/server",
  "description": "The Hornhoof server: the company's database, its API and the agents' work, and the web app it serves.",
  "license": "MIT",
  "author": "Ivan Korol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invariant0x/hornhoof.git",
    "directory": "apps/server"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/migrate.ts && tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/modules/program-operator/fonts', 'dist/modules/program-operator/fonts', { recursive: true })\"",
    "start": "node dist/migrate.js && node dist/main.js",
    "pretest": "npm run build -w @hornhoof/protocol",
    "test": "vitest run",
    "test:real": "sh test/real/run.sh",
    "test:lab": "vitest run --config vitest.lab.config.ts",
    "lint:part": "eslint . --ignore-pattern \"test/**\" --ignore-pattern \"src/modules/[t-z]*/**\" && eslint \"src/modules/[t-z]*/**\" && eslint test --ignore-pattern \"test/[m-z]*.ts\" && eslint \"test/[m-s]*.ts\" && eslint \"test/[t-z]*.ts\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.4",
    "@hornhoof/protocol": "*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@peculiar/x509": "1.14.3",
    "@resvg/resvg-js": "^2.6.2",
    "acme-client": "5.4.0",
    "age-encryption": "0.3.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "libpg-query": "17.7.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "smtp-server": "^3.21.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "version": "0.44.0"
}
