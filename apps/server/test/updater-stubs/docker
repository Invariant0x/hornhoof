#!/usr/bin/env bash
# The host's Docker as the updater sees it. STUB_COMMITS words are "tag=commit": what each build of the app image is.
# STUB_MIGRATIONS words are "tag=count": the migrations each build applies when it starts. STUB_STATE/migrations holds
# how many the database has now. STUB_DIGESTS words are "tag=digest": the build each tag points at in the registry,
# which also keeps every build by its digest. STUB_RUNNING_IMAGES words are "service=image": the image each service
# runs now, as Docker keeps it by digest. STUB_PLAN_NODES words are "name=plan=image": the other nodes on this computer,
# with the plan on their label and the image they run. STUB_BUILD_SERVICES words are "tag=service,service": the services the compose
# file of that build names; STUB_SERVICES answers for any other file. STUB_PROJECT_CONTAINERS words are "id=service":
# the containers of the compose project.
# The databases are files in STUB_STATE that hold how many migrations each has: migrations for hornhoof, restored for
# hornhoof_restore, db-<name> for any other; closed-<name> is there while a database takes no connections, and
# oid-<name> holds the number the server knows it by, which it keeps under every name. STUB_FOLDS: the server keeps the
# name of a database in capitals, as a real one keeps it in small letters, whatever it was asked.
printf 'docker %s\n' "$*" >> "$STUB_LOG"
word() {
  local key=$1 w
  shift
  for w in "$@"; do [ "${w%%=*}" = "$key" ] && { printf '%s' "${w#*=}"; return; }; done
}
commit_of() { word "$1" ${STUB_COMMITS:-}; }
digest_of() { word "$1" ${STUB_DIGESTS:-}; }
running_image() { word "$1" ${STUB_RUNNING_IMAGES:-}; }
build_services() { word "$1" ${STUB_BUILD_SERVICES:-}; }
project_service() { word "$1" ${STUB_PROJECT_CONTAINERS:-}; }
db_file() {
  case "$1" in
    hornhoof) printf '%s/migrations' "$STUB_STATE" ;;
    hornhoof_restore) printf '%s/restored' "$STUB_STATE" ;;
    *) printf '%s/db-%s' "$STUB_STATE" "$1" ;;
  esac
}
# The number of a database that is there, given when it is first asked for.
oid_of() {
  local next
  [ -f "$(db_file "$1")" ] || return 1
  if [ ! -f "$STUB_STATE/oid-$1" ]; then
    next=$(($(cat "$STUB_STATE/oids" 2> /dev/null || echo 1000) + 1))
    printf '%s' "$next" > "$STUB_STATE/oids"
    printf '%s' "$next" > "$STUB_STATE/oid-$1"
  fi
  cat "$STUB_STATE/oid-$1"
}
# One statement psql was given with -c, as the database server takes it; it fails as that one would.
statement() {
  local from to
  case "$1" in
    'DROP DATABASE IF EXISTS '* | 'DROP DATABASE '*)
      from=${1#DROP DATABASE }; from=${from#IF EXISTS }; from=${from%% *}
      rm -f "$(db_file "$from")" "$STUB_STATE/closed-$from" "$STUB_STATE/oid-$from" ;;
    'ALTER DATABASE '*' RENAME TO '*)
      from=${1#ALTER DATABASE }; from=${from%% *}; to=${1##* RENAME TO }
      # STUB_RENAME=fail: the loaded database cannot take the place of the one in use.
      [ "${STUB_RENAME:-ok}" = fail ] && [ "$from" = hornhoof_restore ] && return 1
      [ -z "${STUB_FOLDS:-}" ] || [ "$to" = hornhoof ] || to=$(printf '%s' "$to" | tr 'a-z' 'A-Z')
      [ -f "$(db_file "$from")" ] && [ ! -f "$(db_file "$to")" ] || return 1
      oid_of "$from" > /dev/null
      mv "$(db_file "$from")" "$(db_file "$to")"
      mv "$STUB_STATE/oid-$from" "$STUB_STATE/oid-$to"
      [ ! -f "$STUB_STATE/closed-$from" ] || mv "$STUB_STATE/closed-$from" "$STUB_STATE/closed-$to" ;;
    'ALTER DATABASE '*' WITH ALLOW_CONNECTIONS false')
      from=${1#ALTER DATABASE }; from=${from%% *}
      [ -f "$(db_file "$from")" ] || return 1
      touch "$STUB_STATE/closed-$from" ;;
    # STUB_BACK=fail: the database server does not let the old database open again.
    'ALTER DATABASE '*' WITH ALLOW_CONNECTIONS true')
      from=${1#ALTER DATABASE }; from=${from%% *}
      [ "${STUB_BACK:-ok}" != fail ] && [ -f "$(db_file "$from")" ] || return 1
      rm -f "$STUB_STATE/closed-$from" ;;
  esac
}
tag_of() { for w in ${STUB_DIGESTS:-}; do [ "${w#*=}" = "$1" ] && { printf '%s' "${w%%=*}"; return; }; done; }
# An image by digest or by tag: what tag it is a build of, and the id of the build it is.
ref_tag() { case "$1" in *@*) tag_of "${1#*@}" ;; *) printf '%s' "${1##*:}" ;; esac; }
ref_id() { case "$1" in *@*) printf 'id-%s' "${1#*@}" ;; *) printf 'id-%s' "$(digest_of "${1##*:}")" ;; esac; }
image_by_id() {
  for w in ${STUB_RUNNING_IMAGES:-}; do [ "$(ref_id "${w#*=}")" = "$1" ] && { printf '%s' "${w#*=}"; return; }; done
  for w in ${STUB_PLAN_NODES:-}; do [ "$(ref_id "${w##*=}")" = "$1" ] && { printf '%s' "${w##*=}"; return; }; done
}
# The compose file a command reads: the one it names, else the one in the folder it runs in.
compose_file() {
  while [ $# -gt 0 ]; do
    [ "$1" = -f ] && { printf '%s' "$2"; return; }
    shift
  done
  printf 'compose.yaml'
}
# The services a compose file names, by the build unpacking wrote into it.
services_in() {
  local names service
  names=$(build_services "$(sed -n 's/^# build //p' "$1" 2> /dev/null)")
  if [ -n "$names" ]; then
    printf '%s\n' "$names" | tr ',' '\n'
    return
  fi
  for service in ${STUB_SERVICES:-db app node updater}; do echo "$service"; done
}
case "$1 $2" in
  # The running nodes of one server, on a computer that is not the server's: STUB_FOREIGN_NODES work for another server.
  'ps --filter')
    for w in ${STUB_PLAN_NODES:-}; do
      case " $* " in *' label=hornhoof.server='*) case " ${STUB_FOREIGN_NODES:-} " in *" ${w%%=*} "*) continue ;; esac ;; esac
      rest=${w#*=}; printf '%s %s\n' "${w%%=*}" "${rest%%=*}"
    done ;;
  # STUB_NODES_UPDATERS: the containers of the updater of a server's nodes there are now, and STUB_NODES_UPDATER_IMAGE the
  # image the one of its name runs.
  'ps -aq') for w in ${STUB_NODES_UPDATERS:-}; do echo "$w"; done ;;
  # The containers of the compose project, by id and service, or the other nodes on this computer, by name and plan.
  'ps -a')
    case "$*" in
      *com.docker.compose.project*) for w in ${STUB_PROJECT_CONTAINERS:-}; do printf '%s %s\n' "${w%%=*}" "${w#*=}"; done ;;
      *) for w in ${STUB_PLAN_NODES:-}; do rest=${w#*=}; printf '%s %s\n' "${w%%=*}" "${rest%%=*}"; done ;;
    esac ;;
  'compose ps')
    case " $* " in *' db '*) echo dbcid ;; *' app '*) echo appcid ;; *' keeper '*) echo keepercid ;; *' node '*) [ -n "${STUB_NO_NODE:-}" ] || echo nodecid ;; *' updater '*) echo updatercid ;; esac ;;
  # The container of front holds the web port until it goes. STUB_RM_FAILS names containers that cannot be removed.
  # A command that runs on the computer ends as its container goes.
  'rm -f')
    [ ! -p "$STUB_STATE/computer-removed" ] || echo removed > "$STUB_STATE/computer-removed"
    [ "$(project_service "$3")" = front ] && rm -f "$STUB_STATE/port-holder"
    case " ${STUB_RM_FAILS:-} " in *" $3 "*) exit 1 ;; esac ;;
  'exec dbcid')
    case "$*" in
      # Each copy says which one it is. STUB_DUMP=fail: the database cannot be saved.
      *pg_dump*)
        [ "${STUB_DUMP:-ok}" = fail ] && { echo 'pg_dump: error: connection to server failed' >&2; exit 1; }
        copy=$(($(cat "$STUB_STATE/copies" 2> /dev/null || echo 0) + 1))
        printf '%s' "$copy" > "$STUB_STATE/copies"
        printf -- '-- a dump of the hornhoof database\n-- migrations %s\n-- copy %s\n' "$(cat "$STUB_STATE/migrations")" "$copy" ;;
      # What the updater had said by the time it first asked the database.
      *'FROM drizzle.__drizzle_migrations'*)
        [ -f "$STUB_STATE/status-when-asked" ] || cp "$HORNHOOF_CONTROL_DIR/status.json" "$STUB_STATE/status-when-asked"
        cat "$STUB_STATE/migrations" ;;
      # Whether the session that reads the old database of a restore is on it.
      *'FROM pg_stat_activity'*) if [ -f "$STUB_STATE/cutover-open" ]; then echo 1; else echo 0; fi ;;
      *"SELECT oid FROM pg_database WHERE datname = 'hornhoof'"*) oid_of hornhoof || true ;;
      # The name the database with that number goes by now; nothing when there is none.
      *'FROM pg_database WHERE oid = '*)
        want=${!#}; want=${want##* }
        for file in "$STUB_STATE"/oid-*; do
          [ -f "$file" ] && [ "$(cat "$file")" = "$want" ] && printf '%s\n' "${file##*/oid-}"
        done ;;
      *'FROM pg_database'*)
        names=''
        for file in "$STUB_STATE/migrations" "$STUB_STATE/restored" "$STUB_STATE"/db-*; do
          [ -f "$file" ] || continue
          case "${file##*/}" in migrations) names="$names hornhoof" ;; restored) names="$names hornhoof_restore" ;; *) names="$names ${file##*/db-}" ;; esac
        done
        printf '%s\n' "${names# }" ;;
      # Each statement in its turn, and none after one that failed.
      *)
        while [ $# -gt 0 ]; do
          if [ "$1" = -c ]; then statement "$2" || { echo 'psql: error' >&2; exit 3; }; fi
          shift
        done ;;
    esac ;;
  'exec -i')
    case " $* " in
      # The session that stays on the database a restore closes. It answers once the connections are off: the term,
      # machine and cluster of that database, and STUB_CARRY when it was asked who may get in. STUB_CUTOVER=fail: it
      # never gets onto the database; left: another session would not end.
      *' PGAPPNAME=hornhoof-cutover '*)
        asked=$(cat)
        [ "${STUB_CUTOVER:-ok}" = fail ] && { echo 'psql: error: connection refused' >&2; exit 2; }
        touch "$STUB_STATE/cutover-open"
        looks=0
        until [ -f "$STUB_STATE/closed-hornhoof" ]; do
          looks=$((looks + 1))
          [ "$looks" -lt 400 ] || { rm -f "$STUB_STATE/cutover-open"; exit 3; }
          /bin/sleep 0.05
        done
        rm -f "$STUB_STATE/cutover-open"
        [ "${STUB_CUTOVER:-ok}" = left ] && { echo 'ERROR:  sessions left' >&2; exit 3; }
        printf '{"term": %s, "machine": "m-old", "cluster": "c-old"}\n' "${STUB_TERM:-7}"
        case "$asked" in
          *recoveryKeys*) printf 'cutover with the carry\n' >> "$STUB_LOG"; printf '%s\n' "${STUB_CARRY:-}" ;;
          *) printf 'cutover alone\n' >> "$STUB_LOG" ;;
        esac ;;
      # The loaded database taking over what the closed one went by. STUB_ADOPT=fail: it cannot.
      *' term='*)
        cat > /dev/null
        [ "${STUB_ADOPT:-ok}" = fail ] && exit 3 ;;
      # A dump going into the copy of the database that takes the place of the one there.
      *)
        [ "${STUB_RESTORE:-ok}" = fail ] && { echo 'psql: error: out of disk space' >&2; exit 3; }
        dump=$(cat)
        printf '%s\n' "$dump" | sed -n 's/^-- migrations //p' | tr -d '\n' > "$STUB_STATE/restored"
        printf '%s\n' "$dump" | sed -n 's/^-- copy //p' | tr -d '\n' > "$STUB_STATE/restored-copy" ;;
    esac ;;
  'image inspect')
    last=${!#}
    case "${4:-}" in
      '{{.Id}}') ref_id "$last" ;;
      # The image of a running service by its digest, after the digest of a copy of it in another repository.
      *RepoDigests*) image=$(image_by_id "$last"); [ -n "$image" ] && printf 'ghcr.io/acme/copy@sha256:%064d %s\n' 0 "$image" ;;
      *) commit_of "$(ref_tag "$last")" ;;
    esac ;;
  'inspect --format')
    case "$3" in
      '{{.Image}}')
        case "${!#}" in
          *cid) image=$(running_image "${4%cid}"); if [ -n "$image" ]; then ref_id "$image"; else printf 'img-%s\n' "${4%cid}"; fi ;;
          *) for w in ${STUB_PLAN_NODES:-}; do [ "${w%%=*}" = "${!#}" ] && ref_id "${w##*=}"; done ;;
        esac ;;
      *.Config.Image*) printf '%s\n' "${STUB_NODES_UPDATER_IMAGE:-}" ;;
      *) case "${!#}" in appcid | keepercid) printf '%s\n' "${STUB_RUNNING_COMMIT:-}" ;; esac ;;
    esac ;;
  *)
    case "$1" in
      # STUB_PULL=images: the app image comes, the other images of its compose file do not.
      compose)
        case " $* " in
          *' pull '*)
            printf 'pull with HORNHOOF_VERSION=%s HORNHOOF_APP_REF=%s HORNHOOF_NODE_REF=%s HORNHOOF_UPDATER_REF=%s\n' "${HORNHOOF_VERSION:-}" "${HORNHOOF_APP_REF:-}" "${HORNHOOF_NODE_REF:-}" "${HORNHOOF_UPDATER_REF:-}" >> "$STUB_LOG"
            [ "${STUB_PULL:-ok}" = images ] && { echo "manifest unknown" >&2; exit 1; } ;;
          *' config --services '*) services_in "$(compose_file "$@")" ;;
          # STUB_UPDATER_UP=fail: this build's updater does not start, the one named by HORNHOOF_UPDATER_REF does;
          # never: no updater starts.
          *' up '*' updater '*)
            printf 'updater up HORNHOOF_UPDATER_REF=%s\n' "${HORNHOOF_UPDATER_REF:-}" >> "$STUB_LOG"
            case "${STUB_UPDATER_UP:-ok}" in
              never) exit 1 ;;
              fail) [ -n "${HORNHOOF_UPDATER_REF:-}" ] || exit 1 ;;
            esac ;;
        esac ;;
      pull)
        [ "${STUB_PULL:-ok}" = fail ] && { echo "pull access denied" >&2; exit 1; }
        [ "${STUB_STOP_IN:-}" = pull ] && [ ! -f "$STUB_STATE/stopped" ] && { touch "$STUB_STATE/stopped"; kill -9 "$PPID"; } ;;
      # A command on the computer is made, then started. With STUB_COMPUTER_RUNS it runs until its container is removed,
      # else it ends at once; STUB_COMPUTER_EXIT is how it ends. The CEO closes access while it runs with
      # STUB_COMPUTER_CLOSES, and while it is made with STUB_CLOSE_ON_CREATE.
      create)
        case " $* " in
          *' --entrypoint bash '*)
            printf '%s' "${!#}" > "$STUB_STATE/computer-command"
            [ -z "${STUB_CLOSE_ON_CREATE:-}" ] || echo '{"untilSec":null,"until":null,"asked":null}' > "$HORNHOOF_CONTROL_DIR/computer.json"
            echo cid-computer ;;
          *) echo "cid-$(ref_tag "$2")" ;;
        esac ;;
      # Any other container than a command's only starts.
      start)
        [ "$2" = -a ] || exit 0
        echo "ran: $(cat "$STUB_STATE/computer-command")"
        [ -z "${STUB_COMPUTER_CLOSES:-}" ] || echo '{"untilSec":null,"until":null,"asked":null}' > "$HORNHOOF_CONTROL_DIR/computer.json"
        if [ -n "${STUB_COMPUTER_RUNS:-}" ]; then
          mkfifo "$STUB_STATE/computer-removed"
          touch "$STUB_STATE/computer-runs"
          read -r _ < "$STUB_STATE/computer-removed"
          rm -f "$STUB_STATE/computer-removed" "$STUB_STATE/computer-runs"
        fi
        exit "${STUB_COMPUTER_EXIT:-0}" ;;
      # The host's own interfaces, as a container on the host's network reads them: STUB_IP, or a failure with STUB_IP=fail.
      run)
        case " $* " in
          *' --entrypoint ip '*)
            [ "${STUB_IP:-}" != fail ] || exit 1
            printf '%s\n' "${STUB_IP:-}" ;;
        esac ;;
      # The container goes, and a command that runs in it ends.
      rm) [ ! -p "$STUB_STATE/computer-removed" ] || echo removed > "$STUB_STATE/computer-removed" ;;
      cp)
        tag=${2%%:*}; tag=${tag#cid-}
        case "$2" in
          *:/app/scripts/install.sh)
            # The installer of that build: records how it was run and starts that build, unless it is broken.
            cat > "$3" <<SCRIPT
#!/usr/bin/env bash
# STUB_STOP_IN names a build whose installer stops the updater that runs it, once, as a restart of its container would;
# "pull" stops it while it downloads.
[ -z "${STUB_INSTALLER_FAILS:-}" ] || { echo 'the installer failed' >&2; exit 1; }
case " ${STUB_STOP_IN:-} " in *" $tag "*) [ -f "$STUB_STATE/stopped" ] || { touch "$STUB_STATE/stopped"; kill -9 "\$PPID"; exit 0; } ;; esac
[ -z "\${HORNHOOF_NODES_FREE:-}" ] || printf 'installer told the nodes are free\n' >> "$STUB_LOG"
[ -z "\${HORNHOOF_NODES_ONLY:-}" ] || printf 'installer told only %s\n' "\$HORNHOOF_NODES_ONLY" >> "$STUB_LOG"
# As the real installer, it writes the server folder's compose file and .env before it starts anything.
cp "\$HORNHOOF_COMPOSE_FILE" "\$HORNHOOF_SERVER_DIR/compose.yaml"
grep -v '^HORNHOOF_VERSION=' "\$HORNHOOF_SERVER_DIR/.env" > "\$HORNHOOF_SERVER_DIR/.env.new"; printf 'HORNHOOF_VERSION=%s\n' "\$HORNHOOF_VERSION" >> "\$HORNHOOF_SERVER_DIR/.env.new"; mv "\$HORNHOOF_SERVER_DIR/.env.new" "\$HORNHOOF_SERVER_DIR/.env"
# STUB_HANDS_OVER names builds whose installer, run by an updater from before revision 2, starts this build's updater,
# and compose replacing the updater that runs it stops it. STUB_HANDOVER=fail: it could not start that updater.
if [ -z "\${HORNHOOF_UPDATER_REV:-}" ]; then
  case " ${STUB_HANDS_OVER:-} " in
    *" $tag "*)
      [ "${STUB_HANDOVER:-}" != fail ] || { echo 'Could not start the updater of this build, so nothing changed.'; exit 1; }
      echo 'installer hands over' >> "$STUB_LOG"
      kill -9 "\$PPID"
      exit 0 ;;
  esac
fi
printf 'installer %s HORNHOOF_VERSION=%s HORNHOOF_FROM_UPDATER=%s HORNHOOF_SERVER_DIR=%s HORNHOOF_COMPOSE_FILE=%s HORNHOOF_PULLED=%s HORNHOOF_APP_REF=%s HORNHOOF_NODE_REF=%s HORNHOOF_UPDATER_REF=%s HORNHOOF_UPDATER_REV=%s\n' "\$*" "\$HORNHOOF_VERSION" "\$HORNHOOF_FROM_UPDATER" "\$HORNHOOF_SERVER_DIR" "\$(basename "\$HORNHOOF_COMPOSE_FILE")" "\${HORNHOOF_PULLED:-}" "\${HORNHOOF_APP_REF:-}" "\${HORNHOOF_NODE_REF:-}" "\${HORNHOOF_UPDATER_REF:-}" "\${HORNHOOF_UPDATER_REV:-}" >> "$STUB_LOG"
# front holds the web port from a build that has it on, so a build without it cannot take the port.
case ",$(build_services "$tag")," in
  *,front,*) touch "$STUB_STATE/port-holder" ;;
  *) [ ! -f "$STUB_STATE/port-holder" ] || { echo 'Bind for 0.0.0.0:8080 failed: port is already allocated'; exit 1; } ;;
esac
# The build migrates the database when it starts, also when it fails afterwards.
want=\$(for w in ${STUB_MIGRATIONS:-}; do [ "\${w%%=*}" = "$tag" ] && printf '%s' "\${w#*=}"; done)
[ -n "\$want" ] && [ "\$want" -gt "\$(cat "$STUB_STATE/migrations")" ] && printf '%s' "\$want" > "$STUB_STATE/migrations"
case " ${STUB_BROKEN:-} " in *" $tag "*) echo dead > "$STUB_STATE/running" ;; *) printf '%s' "$(commit_of "$tag")" > "$STUB_STATE/running" ;; esac
SCRIPT
            ;;
          # The build's name in a comment, so services_in can tell whose file it is.
          *:/app/compose.yaml) printf '# build %s\nservices: {}\n' "$tag" > "$3" ;;
          # The overlay a worker adds. STUB_NO_OVERLAY names builds that have none.
          *:/app/compose.worker.yaml)
            case " ${STUB_NO_OVERLAY:-} " in *" $tag "*) exit 1 ;; esac
            printf '# build %s\nservices: {}\n' "$tag" > "$3" ;;
        esac ;;
    esac ;;
esac
exit 0
