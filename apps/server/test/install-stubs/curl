#!/usr/bin/env bash
. "$STUB_SRC/_log.sh"
url='' out='' fmt=''
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out=$2; shift ;;
    -w) fmt=$2; shift ;;
    --data-binary) case "$2" in @*) printf 'curl-data %s\n' "$(cat "${2#@}")" >> "$STUB_LOG" ;; esac; shift ;;
    http://*|https://*) url=$1 ;;
  esac
  shift
done
reply() { if [ -n "$out" ]; then printf '%b' "$1" > "$out"; else printf '%b' "$1"; fi; }
case "$url" in
  */api/health)
    if [ "${STUB_HEALTH:-ok}" = fail ]; then echo "curl: (7) Failed to connect" >&2; exit 7; fi
    # STUB_HEALTH_MODES: what the server says of itself at each ask in turn, the last one from then on.
    if [ -n "${STUB_HEALTH_MODES:-}" ]; then
      asked=$(cat "$STUB_STATE/health-asks" 2> /dev/null || echo 0)
      echo $((asked + 1)) > "$STUB_STATE/health-asks"
      # shellcheck disable=SC2086 # the modes are words
      set -- $STUB_HEALTH_MODES
      shift "$((asked < $# ? asked : $# - 1))"
      reply "{\"ok\":true,\"mode\":\"$1\"}"
    else
      reply '{"ok":true}'
    fi ;;
  # The keeper of a machine's core, which says whether it has its place in the company: STUB_KEEPER.
  */api/keeper)
    has_place='{"certificate":true}'
    reply "${STUB_KEEPER:-$has_place}" ;;
  */api/nodes/join)
    reply "${STUB_JOIN_BODY:-}"
    [ -n "$fmt" ] && printf '%s' "${STUB_JOIN_STATUS:-200}" ;;
  # The install scripts of Homebrew and Docker; the tests give the installer their SHA-256.
  https://raw.githubusercontent.com/Homebrew/install/*/install.sh)
    if [ -n "$out" ]; then cat "$STUB_SRC/_brew-install.sh" > "$out"; else cat "$STUB_SRC/_brew-install.sh"; fi ;;
  https://raw.githubusercontent.com/docker/docker-install/*/install.sh)
    if [ -n "$out" ]; then cat "$STUB_SRC/_docker-install.sh" > "$out"; else cat "$STUB_SRC/_docker-install.sh"; fi ;;
  *compose.yaml)
    reply 'services: {}\n' ;;
  # A port probe: STUB_PORTS_TAKEN lists the ports something answers on.
  http://localhost:*/)
    port=${url#http://localhost:}; port=${port%/}
    case " ${STUB_PORTS_TAKEN:-} " in *" $port "*) exit 0 ;; esac
    echo "curl: (7) Failed to connect" >&2; exit 7 ;;
  *) echo "curl stub: unknown url $url" >&2; exit 22 ;;
esac
