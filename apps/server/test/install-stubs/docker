#!/usr/bin/env bash
. "$STUB_SRC/_log.sh"
# The helper of updater.sh --take-over. Without the socket, the server's folder at its own path and the control folder of
# the project .env names, it finds no update and exits 0, as the real one does. STUB_HELPER=replaces: with them, compose
# replaces the updater a moment later, which kills the installer running under it.
take_over_helper() {
  [ "${STUB_HELPER:-}" = replaces ] || return 0
  for word in "$@"; do case "$word" in HORNHOOF_SERVER_DIR=*) dir=${word#*=} ;; esac; done
  project=$(grep '^COMPOSE_PROJECT_NAME=' "${dir:-}/.env" 2> /dev/null | cut -d= -f2-)
  case " $* " in *' -v /var/run/docker.sock:/var/run/docker.sock '*) ;; *) return 0 ;; esac
  case " $* " in *" -v ${dir:-}:${dir:-} "*) ;; *) return 0 ;; esac
  case " $* " in *" -v ${project}_control:/control "*) ;; *) return 0 ;; esac
  printf 'helper replaced the updater\n' >> "$STUB_LOG"
  (sleep 1; kill -9 "$PPID") > /dev/null 2>&1 &
}
# The list of ports and its lock live here, so several installs of one test can share them.
PORTS=${STUB_PORTS_DIR:-$STUB_STATE}
works() {
  case "${STUB_DOCKER:-ok}" in
    ok) return 0 ;;
    sudo_only) [ "${STUB_SUDO:-}" = 1 ] ;;
    *) [ -f "$STUB_STATE/docker-running" ] ;;
  esac
}
# The command line knows its context without the daemon. STUB_CONTEXT names it, as Docker Desktop or OrbStack does.
if [ "${1:-}" = context ] && [ "${2:-}" = show ]; then echo "${STUB_CONTEXT:-desktop-linux}"; exit 0; fi
if ! works; then echo "Cannot connect to the Docker daemon" >&2; exit 1; fi
has() { case " $* " in *" $WORD "*) return 0 ;; esac; return 1; }
stopped() {
  [ -f "$STUB_STATE/stopped-$1" ] && return 0
  case " ${STUB_STOPPED:-} " in
    *" $1 "*) [ ! -f "$STUB_STATE/started-$1" ] ;;
    *) return 1 ;;
  esac
}
CONTAINERS="$STUB_STATE/containers"
restart_of_seed() {
  local w
  for w in ${STUB_RESTART_POLICIES:-}; do [ "${w%%=*}" = "$1" ] && { printf '%s' "${w#*=}"; return; }; done
  printf 'unless-stopped'
}
init_containers() {
  [ -f "$CONTAINERS" ] && return 0
  : > "$CONTAINERS"
  local n name server
  for n in ${STUB_CONTAINERS:-}; do
    name=${n%%=*}
    server=''
    case "$n" in *=*) server=${n#*=} ;; esac
    printf '%s|%s|%s\n' "$name" "$server" "$(restart_of_seed "$name")" >> "$CONTAINERS"
  done
}
has_container() {
  init_containers
  grep -Fq "^$1|" "$CONTAINERS" 2> /dev/null || grep -Eq "^$(printf '%s' "$1" | sed 's/[.[\*^$()+?{|]/\\&/g')\|" "$CONTAINERS" 2> /dev/null
}
container_line() {
  init_containers
  awk -F'|' -v want="$1" '$1 == want { print; exit }' "$CONTAINERS"
}
# STUB_NODE_RUNNING is the image the server's built-in node runs now; STUB_IMAGE_IDS words are "ref=id" for tags that
# point at the same image.
id_of() {
  for w in ${STUB_IMAGE_IDS:-}; do [ "${w%%=*}" = "$1" ] && { printf '%s\n' "${w#*=}"; return; }; done
  printf 'id-%s\n' "$1"
}
# The services a "compose ... up" names: nothing when it starts them all.
up_services() {
  while [ $# -gt 0 ] && [ "$1" != up ]; do shift; done
  [ $# -gt 0 ] && shift
  for word in "$@"; do case "$word" in -*) ;; *) printf '%s ' "$word" ;; esac; done
}
# STUB_BIND_FAIL words are ports something outside Docker holds: the first up that binds one fails.
binds_ports() {
  case " $(up_services "$@") " in '  ' | *' keeper '* | *' front '*) ;; *) return 0 ;; esac
  for port in ${STUB_BIND_FAIL:-}; do
    grep -Eq "^HORNHOOF_(PEER_)?PORT=$port\$" .env || continue
    [ ! -f "$STUB_STATE/bind-failed-$port" ] || continue
    touch "$STUB_STATE/bind-failed-$port"
    if [ "${STUB_BIND_WORDS:-}" = address ]; then
      echo "Error response from daemon: failed to bind port 0.0.0.0:$port/tcp: listen tcp4 0.0.0.0:$port: bind: address already in use" >&2
    else
      echo "Error response from daemon: driver failed programming external connectivity on endpoint front (9f1e): Bind for 0.0.0.0:$port failed: port is already allocated" >&2
    fi
    exit 1
  done
}
# STUB_UP_FAIL words are services whose up fails for a reason that has nothing to do with ports.
up_fails() {
  for service in ${STUB_UP_FAIL:-}; do
    case " $(up_services "$@") " in *" $service "*) echo "service \"$service\" failed to build: something else went wrong" >&2; exit 1 ;; esac
  done
}
# STUB_MIGRATE=fail: compose runs migrate first for every up that starts the app, and migrate fails.
migrate_runs() {
  case " $(up_services "$@") " in '  ' | *' app '*) ;; *) return 0 ;; esac
  if [ "${STUB_MIGRATE:-}" = fail ]; then echo "service \"migrate\" didn't complete successfully: exit 1" >&2; exit 1; fi
}
# Recorded Docker networks live in $PORTS/networks as "id|name|project|subnet|internal|bridge", seeded from
# STUB_DOCKER_NETWORKS so several installs on one simulated computer see each other's networks.
init_networks() {
  [ -f "$PORTS/networks" ] && return 0
  : > "$PORTS/networks"
  local item
  for item in ${STUB_DOCKER_NETWORKS:-}; do
    printf '%s\n' "$item" >> "$PORTS/networks"
  done
}
gateway_of() {
  awk -F. '{ printf "%d.%d.%d.%d", $1, $2, $3, ($4 == 0 ? 1 : $4) }' <<< "${1%%/*}"
}
next_pool_subnet() {
  local cand
  for cand in ${STUB_DOCKER_POOL:-192.168.0.0/20 192.168.16.0/20 192.168.32.0/20 192.168.48.0/20 192.168.64.0/20 192.168.80.0/20}; do
    grep -Fq "|$cand|" "$PORTS/networks" 2> /dev/null || { printf '%s' "$cand"; return 0; }
  done
  printf '192.168.240.0/20'
}
ensure_compose_network() {
  local project=$1 suffix=$2 var=$3 internal=$4 name sub='' has_gw=1 n id made=''
  name="${project}_${suffix}"
  grep -Fq "|$name|" "$PORTS/networks" 2> /dev/null && return 0
  [ -z "${STUB_RUNNING_SERVICES:-}" ] || made=$(made_by "$var")
  if [ -f compose.yaml ] && grep -Fq "$var" compose.yaml; then
    sub=$(grep "^$var=" .env 2> /dev/null | tail -1 | cut -d= -f2-)
    [ -n "$sub" ] || sub=$(sed -n "s/.*${var}:-\\([^}]*\\)}.*/\\1/p" compose.yaml | head -1)
    grep -Fq 'gateway:' compose.yaml || has_gw=0
  fi
  [ -n "$sub" ] || sub=$(next_pool_subnet)
  [ "$has_gw" = 1 ] || sub="${sub},"
  n=$(($(cat "$PORTS/net-count" 2> /dev/null || echo 0) + 1))
  echo "$n" > "$PORTS/net-count"
  id=$(printf 'net%012d' "$n")
  printf '%s|%s|%s|%s|%s||%s\n' "$id" "$name" "$project" "$sub" "$internal" "$made" >> "$PORTS/networks"
}
# A network record's seventh field says how compose made it: "plain" by a compose file that named no subnet for it,
# "subnets" by one that did, nothing when compose kept no mark of it. STUB_RUNNING_SERVICES words are the services of the
# project whose containers run now, kept in $STUB_STATE/running from then on; with them the networks this stub makes are
# marked too. Compose takes a marked network its file asks for otherwise for changed: it stops the services of the up
# that are on it and removes it to make it again, which Docker refuses while another container that runs is on it.
made_by() { if grep -Fq "$1" compose.yaml 2> /dev/null; then echo subnets; else echo plain; fi; }
RUNNING="$STUB_STATE/running"
running() {
  [ -f "$RUNNING" ] || for svc in ${STUB_RUNNING_SERVICES:-}; do echo "$svc"; done > "$RUNNING"
  cat "$RUNNING"
}
# not_running <service>...: those services' containers no longer run.
not_running() {
  local svc list
  list=$(running)
  for svc in "$@"; do list=$(grep -vx "$svc" <<< "$list" || true); done
  printf '%s\n' "$list" | awk 'NF' > "$RUNNING"
}
now_running() {
  { running; for svc in "$@"; do echo "$svc"; done; } | awk 'NF && !seen[$0]++' > "$RUNNING.new"
  mv "$RUNNING.new" "$RUNNING"
}
file_services() { awk '/^services:/ { s = 1; next } /^[^ #]/ { s = 0 } s && /^  [a-z][a-z-]*:/ { sub(":.*", "", $1); print $1 }' compose.yaml 2> /dev/null; }
# The services on each network, as compose.yaml puts them, with the tunnel of a build from before on the default one.
# STUB_STAYS_ON words are containers outside the project on the default network, which no down of it stops.
# shellcheck disable=SC2086 # container names, one word each
on_network() { case "$1" in default) echo front keeper app node updater tunnel ${STUB_STAYS_ON:-} ;; *) echo keeper migrate app db ;; esac; }
networks_diverge() {
  [ -n "${STUB_RUNNING_SERVICES:-}" ] || return 0
  init_networks
  local project chosen suffix var name line made id holders svc
  project=$(grep '^COMPOSE_PROJECT_NAME=' .env 2> /dev/null | tail -1 | cut -d= -f2-)
  [ -n "$project" ] || project=$(basename "$PWD")
  chosen=" $(up_services "$@") "
  [ -n "${chosen// /}" ] || chosen=" $(file_services | tr '\n' ' ') "
  for suffix in default internal; do
    name="${project}_${suffix}"
    line=$(grep -F "|$name|" "$PORTS/networks" | head -1 || true)
    [ -n "$line" ] || continue
    made=$(cut -d'|' -f7 <<< "$line")
    if [ "$suffix" = default ]; then var=HORNHOOF_SUBNET; else var=HORNHOOF_INTERNAL_SUBNET; fi
    [ -n "$made" ] && [ "$made" != "$(made_by "$var")" ] || continue
    holders=''
    for svc in $(on_network "$suffix"); do
      case "$chosen" in *" $svc "*) continue ;; esac
      if running | grep -qx "$svc"; then holders="$holders $svc"; fi
    done
    id=$(cut -d'|' -f1 <<< "$line")
    if [ -n "$holders" ]; then
      printf 'network %s held by%s\n' "$name" "$holders" >> "$STUB_LOG"
      echo "Error response from daemon: error while removing network: network $name id $id has active endpoints" >&2
      exit 1
    fi
    printf 'network %s made again\n' "$name" >> "$STUB_LOG"
    # shellcheck disable=SC2046 # service names, one word each
    not_running $(on_network "$suffix")
    awk -F'|' -v n="$name" '$2 != n' "$PORTS/networks" > "$PORTS/networks.new"
    mv "$PORTS/networks.new" "$PORTS/networks"
  done
}
# What runs once an up or a down is through, and what a stop leaves.
services_run() {
  [ -n "${STUB_RUNNING_SERVICES:-}" ] || return 0
  local chosen
  chosen=$(up_services "$@")
  [ -n "${chosen// /}" ] || chosen=$(file_services | tr '\n' ' ')
  # shellcheck disable=SC2086 # service names, one word each
  now_running $chosen
}
subnets_overlap_fail() {
  local project cidr flag
  project=$(grep '^COMPOSE_PROJECT_NAME=' .env 2> /dev/null | tail -1 | cut -d= -f2-)
  [ -n "$project" ] || project=$(basename "$PWD")
  for cidr in ${STUB_SUBNET_OVERLAP:-}; do
    grep -Fqx "HORNHOOF_SUBNET=$cidr" .env 2> /dev/null || grep -Fqx "HORNHOOF_INTERNAL_SUBNET=$cidr" .env 2> /dev/null || continue
    flag="$STUB_STATE/subnet-failed-$(printf '%s' "$cidr" | tr '/.' '__')"
    [ ! -f "$flag" ] || continue
    touch "$flag"
    echo "Error response from daemon: failed to create network ${project}_default: Error response from daemon: Pool overlaps with other one on this address space" >&2
    exit 1
  done
}
compose_networks_up() {
  [ -f .env ] || [ -f compose.yaml ] || return 0
  init_networks
  local project role
  project=$(grep '^COMPOSE_PROJECT_NAME=' .env 2> /dev/null | tail -1 | cut -d= -f2-)
  [ -n "$project" ] || project=$(basename "$PWD")
  role=$(grep '^HORNHOOF_ROLE=' .env 2> /dev/null | tail -1 | cut -d= -f2-)
  ensure_compose_network "$project" default HORNHOOF_SUBNET false
  if [ "$role" != worker ] || grep -Fq 'HORNHOOF_INTERNAL_SUBNET' compose.yaml 2> /dev/null; then
    ensure_compose_network "$project" internal HORNHOOF_INTERNAL_SUBNET true
  fi
}
compose_networks_down() {
  [ -f "$PORTS/networks" ] || [ -n "${STUB_DOCKER_NETWORKS:-}" ] || return 0
  init_networks
  local project kept=''
  project=$(grep '^COMPOSE_PROJECT_NAME=' .env 2> /dev/null | tail -1 | cut -d= -f2-)
  [ -n "$project" ] || project=$(basename "$PWD")
  if [ -n "${STUB_RUNNING_SERVICES:-}" ]; then
    # A down stops what the file names; the containers of services it names no more stay unless it removes the orphans,
    # and Docker keeps the default network that containers still run on.
    case " $* " in
      *' --remove-orphans '*)
        : > "$RUNNING"
        # shellcheck disable=SC2086 # container names, one word each
        now_running ${STUB_STAYS_ON:-} ;;
      *)
        # shellcheck disable=SC2046 # service names, one word each
        not_running $(file_services) ;;
    esac
    if [ -n "$(running)" ]; then kept="${project}_default"; fi
  fi
  awk -F'|' -v p="$project" -v kept="$kept" '$2 == kept || ($3 != p && $2 != p "_default" && $2 != p "_internal")' "$PORTS/networks" > "$PORTS/networks.new"
  mv "$PORTS/networks.new" "$PORTS/networks"
}
case "$1" in
  info) echo "Server Version: 28.0.0" ;;
  # STUB_PULL: "fail" for every image, "node" for the node's alone. A pull says how far it is, as Docker does.
  pull)
    case "${STUB_PULL:-ok}:$2" in fail:* | node:*hornhoof-node*) echo "pull access denied" >&2; exit 1 ;; esac
    echo "4f4fb700ef54: Pulling fs layer" ;;
  create)
    case "$*" in
      *'--name hornhoof-port-lock'*)
        if [ -f "$PORTS/lock" ]; then echo "Error response from daemon: Conflict. The container name is already in use" >&2; exit 1; fi
        n=$(($(cat "$PORTS/lock-count" 2> /dev/null || echo 0) + 1))
        echo "$n" > "$PORTS/lock-count"
        echo "lock-$n" > "$PORTS/lock"
        echo "lock-$n" ;;
      *) echo cid-app ;;
    esac ;;
  rm)
    if [ "${2:-}" = "$(cat "$PORTS/lock" 2> /dev/null)" ]; then rm -f "$PORTS/lock"; fi
    init_containers
    for arg in "${@:2}"; do
      case "$arg" in -*) continue ;; esac
      awk -F'|' -v gone="$arg" '$1 != gone' "$CONTAINERS" > "$CONTAINERS.new" && mv "$CONTAINERS.new" "$CONTAINERS"
      rm -f "$STUB_STATE/started-$arg" "$STUB_STATE/stopped-$arg" "$STUB_STATE/new-$arg"
    done ;;
  rename)
    init_containers
    from=${2:-}; to=${3:-}
    [ -n "$(container_line "$from")" ] && [ -z "$(container_line "$to")" ] || { echo "Error: cannot rename $from to $to" >&2; exit 1; }
    awk -F'|' -v f="$from" -v t="$to" 'BEGIN { OFS="|" } $1 == f { $1 = t } { print }' "$CONTAINERS" > "$CONTAINERS.new" && mv "$CONTAINERS.new" "$CONTAINERS"
    if [ -f "$STUB_STATE/started-$from" ]; then mv "$STUB_STATE/started-$from" "$STUB_STATE/started-$to"; fi
    if [ -f "$STUB_STATE/stopped-$from" ]; then mv "$STUB_STATE/stopped-$from" "$STUB_STATE/stopped-$to"; fi
    rm -f "$STUB_STATE/new-$from" ;;
  update)
    init_containers
    pol=''
    for arg in "${@:2}"; do
      case "$arg" in --restart=*) pol=${arg#--restart=} ;; esac
    done
    target=${!#}
    [ -n "$(container_line "$target")" ] || exit 1
    if [ -n "$pol" ]; then
      awk -F'|' -v c="$target" -v p="$pol" 'BEGIN { OFS="|" } $1 == c { $3 = p } { print }' "$CONTAINERS" > "$CONTAINERS.new" && mv "$CONTAINERS.new" "$CONTAINERS"
    fi ;;
  start)
    init_containers
    target=${!#}
    [ -n "$(container_line "$target")" ] || exit 1
    rm -f "$STUB_STATE/stopped-$target"
    touch "$STUB_STATE/started-$target" ;;
  # The built-in node's container stops.
  stop)
    if [ -n "${STUB_RUNNING_SERVICES:-}" ] && [ "${!#}" = nodecid ]; then not_running node; fi
    rm -f "$STUB_STATE/started-${!#}"
    touch "$STUB_STATE/stopped-${!#}" ;;
  # STUB_NO_OVERLAY=1: a build from before machines had the company's core.
  cp)
    case "$2" in
      *:/app/compose.yaml) if [ "${STUB_REAL_COMPOSE:-}" = 1 ]; then cp "$STUB_SRC/../../../../compose.yaml" "$3"; else echo 'services: {}' > "$3"; fi ;;
      *:/app/compose.worker.yaml)
        [ -z "${STUB_NO_OVERLAY:-}" ] || exit 1
        if [ "${STUB_REAL_COMPOSE:-}" = 1 ]; then cp "$STUB_SRC/../../../../compose.worker.yaml" "$3"; else echo 'services: {db: {profiles: [data]}}' > "$3"; fi ;;
      *:/data/removed) case " ${STUB_REMOVED:-} " in *" ${2%%:*} "*) exit 0 ;; *) exit 1 ;; esac ;;
    esac ;;
  image)
    if [ "${2:-}" = inspect ] && [ "${3:-}" = --format ]; then
      [ -n "${STUB_NODE_RUNNING:-}${STUB_IMAGE_IDS:-}" ] || exit 1
      id_of "${!#}"
    else
      # STUB_IMAGE_LOCAL: "1" for every image on this computer.
      [ "${STUB_IMAGE_LOCAL:-0}" = 1 ] || exit 1
    fi ;;
  # STUB_STOPPED words are containers that exist and do not run.
  inspect)
    # STUB_NODE_ENV: the settings a node was started with, one per line.
    case "${3:-}" in *.Config.Env*) printf '%b' "${STUB_NODE_ENV:-}"; exit 0 ;; esac
    # STUB_EXTRA_HOSTS words are "name=host:address", one --add-host a container was started with, one line each.
    # STUB_EXTRA_HOSTS_UNREAD words are containers that are there but whose host mappings Docker does not say.
    case "${3:-}" in
      *.HostConfig.ExtraHosts*)
        [ -n "$(container_line "${!#}")" ] || exit 1
        case " ${STUB_EXTRA_HOSTS_UNREAD:-} " in *" ${!#} "*) echo 'Error response from daemon: a fault of the fixture' >&2; exit 1 ;; esac
        for h in ${STUB_EXTRA_HOSTS:-}; do if [ "${h%%=*}" = "${!#}" ]; then echo "${h#*=}"; fi; done
        exit 0 ;;
    esac
    if [ "${3:-}" = '{{.HostConfig.RestartPolicy.Name}}' ]; then
      line=$(container_line "${!#}")
      [ -n "$line" ] || exit 1
      cut -d'|' -f3 <<< "$line"
      exit 0
    fi
    if [ "${3:-}" = '{{.State.Running}} {{.State.Restarting}}' ]; then
      target=${!#}
      [ -n "$(container_line "$target")" ] || exit 1
      run_state=true
      if stopped "$target"; then run_state=false; fi
      if [ -f "$STUB_STATE/new-$target" ]; then
        case " ${STUB_NEW_NODE_STOPPED:-} " in *" $target "*) run_state=false ;; esac
      fi
      rest_state=false
      case " ${STUB_RESTARTING:-} " in *" $target "*) rest_state=true ;; esac
      if [ -f "$STUB_STATE/new-$target" ]; then
        case " ${STUB_NEW_NODE_RESTARTING:-} " in *" $target "*) rest_state=true ;; esac
      fi
      echo "$run_state $rest_state"
      exit 0
    fi
    if [ "${3:-}" = '{{.State.Running}}' ]; then if stopped "${!#}"; then echo false; else echo true; fi; exit 0; fi
    # STUB_NODE_IMAGES words are "name=image", the image a node was started from.
    if [ "${3:-}" = '{{.Config.Image}}' ]; then for n in ${STUB_NODE_IMAGES:-}; do [ "${n%%=*}" = "${!#}" ] && echo "${n#*=}"; done; exit 0; fi
    case "$*" in
      # STUB_LOCK_SINCE is when the lock was made; STUB_LOCK_TAKEN=1 says another install has taken it over since.
      *io.hornhoof.since*) [ -f "$PORTS/lock" ] || exit 1; echo "$(cat "$PORTS/lock") ${STUB_LOCK_SINCE:-$(date +%s)}" ;;
      *hornhoof-port-lock) if [ "${STUB_LOCK_TAKEN:-}" = 1 ]; then echo lock-other; else cat "$PORTS/lock" 2> /dev/null; fi ;;
      *PortBindings*) echo "${STUB_BOUND_PORTS:-}$(for s in ${STUB_SERVERS:-} ${STUB_CORES:-}; do printf ' %s' "${s##*:}"; done)" ;;
      *)
        if [ "${!#}" = nodecid ] && [ -n "${STUB_NODE_RUNNING:-}" ]; then id_of "$STUB_NODE_RUNNING"; exit 0; fi
        if [ "${3:-}" = '{{.Id}}' ]; then [ -n "$(container_line "${!#}")" ] && echo "cid-${!#}" || exit 1; exit 0; fi ;;
    esac ;;
  # STUB_CONTAINERS words are "name" or "name=server", the server label of a node.
  # The server's own command line in its container: STUB_SETUP_LINK is the setup link of a server not set up yet.
  compose)
    # STUB_COMPOSE_VERSION: what "compose version --short" says; nothing unless a test names one.
    case "$*" in 'compose version --short') [ -z "${STUB_COMPOSE_VERSION:-}" ] || echo "$STUB_COMPOSE_VERSION"; exit 0 ;; esac
    case " $* " in *' up '*) up_fails "$@"; binds_ports "$@"; subnets_overlap_fail "$@"; migrate_runs "$@"; networks_diverge "$@"; compose_networks_up "$@"; services_run "$@" ;; esac
    case " $* " in *' down '*) compose_networks_down "$@" ;; esac
    case "$*" in
      *' stop app') [ -z "${STUB_RUNNING_SERVICES:-}" ] || not_running app ;;
      *' down') compose_networks_down "$@" ;;
      *' start --wait '* ) [ "${STUB_COMPOSE_VERSION:-}" != 2.20.0 ] || exit 1 ;;
      *' exec -T db pg_dump '* )
        case "${STUB_DATABASE_DUMP:-fail}" in
          fail) exit 1 ;;
          empty) exit 0 ;;
          invalid) printf 'invalid archive\n' ;;
          ok) printf 'PGDMP test archive\n' ;;
        esac ;;
      *' exec -T db pg_dumpall '* ) printf 'test database globals\n' ;;
      *' exec -T db pg_restore '* ) [ "$(cat)" = 'PGDMP test archive' ] || exit 1 ;;
      *' pull') case "${STUB_PULL:-ok}" in fail) echo "pull access denied" >&2; exit 1 ;; esac ;;
      # STUB_SERVICES: the services the folder's compose files name, with the profiles its settings turn on.
      *' config --services') for s in ${STUB_SERVICES:-}; do echo "$s"; done ;;
      *' ps -q node') [ -n "${STUB_NODE_RUNNING:-}" ] && { [ -z "${STUB_RUNNING_SERVICES:-}" ] || running | grep -qx node; } && echo nodecid ;;
      *'/cli.js setup-link') if [ -n "${STUB_SETUP_LINK:-}" ]; then echo "$STUB_SETUP_LINK"; else echo 'Hornhoof is set up already.'; exit 1; fi ;;
      # STUB_TUNNEL_SETTINGS: what the app wrote for the tunnel once the company has a public link.
      *'cat /control/tunnel.json') if [ -n "${STUB_TUNNEL_SETTINGS:-}" ]; then echo "$STUB_TUNNEL_SETTINGS"; else echo "cat: can't open /control/tunnel.json" >&2; exit 1; fi ;;
    esac ;;
  # STUB_NODES_UPDATER: the container of the updater of this server's nodes, when there is one.
  ps)
    case "$*" in *hornhoof.updater=nodes*) [ -z "${STUB_NODES_UPDATER:-}" ] || echo "$STUB_NODES_UPDATER"; exit 0 ;; esac
    # STUB_BOUND_PORTS are the ports containers publish, so a test that names them need not name the containers. The app
    # container of each server in STUB_SERVERS publishes its port too.
    if [ "$*" = 'ps -aq' ]; then
      if [ -n "${STUB_BOUND_IDS:-}${STUB_BOUND_PORTS:-}${STUB_SERVERS:-}${STUB_CORES:-}" ]; then echo "${STUB_BOUND_IDS:-bound-1}"; fi
      exit 0
    fi
    # STUB_SERVERS and STUB_CORES words are "project:folder:port", the Hornhoof cores anyone on this computer runs.
    case "$*" in
      *com.docker.compose.service=app*) for s in ${STUB_SERVERS:-}; do IFS=: read -r p d _ <<< "$s"; echo "$p|$d|ghcr.io/invariant0x/hornhoof:latest|app-$p"; done; exit 0 ;;
      *com.docker.compose.service=keeper*) for s in ${STUB_CORES:-}; do IFS=: read -r p d _ <<< "$s"; echo "$p|$d|ghcr.io/invariant0x/hornhoof:latest|keeper-$p"; done; exit 0 ;;
      *com.docker.compose.project=*)
        [ "${STUB_PROJECT_LOOKUP:-}" != fail ] || exit 1
        for s in ${STUB_SERVERS:-} ${STUB_CORES:-}; do IFS=: read -r p d _ <<< "$s"; case "$* " in *"com.docker.compose.project=$p "*) echo "$d" ;; esac; done
        exit 0 ;;
    esac
    init_containers
    while IFS='|' read -r name server _; do
      [ -n "$name" ] || continue
      base=$name
      case "$name" in hornhoof-*-*-old-?*) base=${name%-old-*} ;; esac
      echo "$name id-of-$base $server"
    done < "$CONTAINERS" ;;
  network)
    init_networks
    case "${2:-}" in
      ls) awk -F'|' 'NF && $1 != "" { print $1 }' "$PORTS/networks" ;;
      inspect)
        shift 2
        fmt=''
        if [ "${1:-}" = --format ]; then fmt=${2:-}; shift 2; fi
        for want in "$@"; do
          while IFS='|' read -r id name proj sub internal bridge _; do
            [ -n "$id" ] || continue
            [ "$id" = "$want" ] || [ "$name" = "$want" ] || continue
            cidr=${sub%%,*}
            if [ -z "$cidr" ]; then
              cfg=''
            elif [[ "$sub" == *, ]]; then
              if [[ "$fmt" == *'.Gateway'* ]]; then
                echo 'template parsing error: template: :1:201: executing "" at <.Gateway>: map has no entry for key "Gateway"' >&2
                exit 1
              elif [[ "$fmt" == *'{{with index . "Gateway"}}'* ]]; then
                cfg="${cidr},;"
              else
                cfg="${cidr},<no value>;"
              fi
            elif [[ "$sub" == *,* ]]; then
              cfg="${cidr},${sub#*,};"
            else
              gw=$(gateway_of "$cidr")
              cfg="${cidr},${gw};"
            fi
            printf '%s|%s|%s|%s|%s|%s\n' "$id" "$name" "$proj" "$bridge" "${internal:-false}" "$cfg"
          done < "$PORTS/networks"
        done ;;
    esac ;;
  volume)
    if [ "${2:-}" = ls ]; then
      for v in ${STUB_PROJECT_VOLUMES:-}; do
        case "$* " in *"com.docker.compose.project=$v "*) echo "${v}_pgdata" ;; esac
      done
    fi ;;
  run)
    # STUB_WAIT_UPDATE is what the node's wait-update ends with.
    WORD=wait-update; if has "$@"; then exit "${STUB_WAIT_UPDATE:-0}"; fi
    case "$*" in
      # STUB_REGISTRY=fail: the write fails; STUB_REGISTRY=unreadable: the read does.
      *'cat > /ports/registry.new'*)
        if [ "${STUB_REGISTRY:-}" = fail ]; then echo "docker: Error response from daemon: failed to create task" >&2; exit 1; fi
        cat > "$PORTS/registry"
        exit 0 ;;
      *'cat /ports/registry'*)
        if [ "${STUB_REGISTRY:-}" = unreadable ]; then echo "docker: Error response from daemon: failed to create task" >&2; exit 1; fi
        cat "$PORTS/registry" 2> /dev/null
        exit 0 ;;
      *'cat > /ports/subnets.new'*)
        if [ "${STUB_SUBNETS:-}" = fail ]; then echo "docker: Error response from daemon: failed to create task" >&2; exit 1; fi
        cat > "$PORTS/subnets"
        exit 0 ;;
      *'cat /ports/subnets'*)
        if [ "${STUB_SUBNETS:-}" = unreadable ]; then echo "docker: Error response from daemon: failed to create task" >&2; exit 1; fi
        cat "$PORTS/subnets" 2> /dev/null
        exit 0 ;;
    esac
    WORD=set-key; if has "$@"; then IFS= read -r line; printf 'stdin %s\n' "$line" >> "$STUB_LOG"; fi
    # STUB_SET_SERVER=fail: the node cannot be moved to another address.
    WORD=set-server; if has "$@"; then IFS= read -r line; printf 'stdin %s\n' "$line" >> "$STUB_LOG"; [ "${STUB_SET_SERVER:-ok}" != fail ] || exit 1; fi
    WORD=-d; if has "$@"; then
      [ "${STUB_RUN:-ok}" = fail ] && { echo "docker: Error response from daemon: failed to create task" >&2; exit 1; }
      init_containers
      cname=''; srv=''
      prev=''
      for a in "$@"; do
        [ "$prev" = --name ] && cname=$a
        case "$a" in hornhoof.server=*) srv=${a#hornhoof.server=} ;; esac
        prev=$a
      done
      if [ -n "$cname" ]; then
        [ -z "$(container_line "$cname")" ] || { echo "Conflict. The container name \"/$cname\" is already in use" >&2; exit 1; }
        printf '%s|%s|unless-stopped\n' "$cname" "$srv" >> "$CONTAINERS"
        rm -f "$STUB_STATE/stopped-$cname"
        touch "$STUB_STATE/started-$cname" "$STUB_STATE/new-$cname"
      fi
      echo "0123456789ab"
    fi
    WORD=--take-over; if has "$@"; then take_over_helper "$@"; fi ;;
  exec)
    for n in ${STUB_STOPPED:-}; do
      WORD=$n
      if has "$@" && stopped "$n"; then echo "Error response from daemon: Container $n is not running" >&2; exit 1; fi
    done
    WORD=prepare-stop; if has "$@"; then [ "${STUB_STOP_INTENT:-}" = unsupported ] && exit 1; exit 0; fi
    # STUB_NODE_SERVERS words are "name=server", the server a node's own settings name.
    WORD=/data/node.json; if has "$@"; then
      for n in ${STUB_NODE_SERVERS:-}; do WORD=${n%%=*}; if has "$@"; then printf '{\n  "server": "%s",\n  "provider": "kimi"\n}\n' "${n#*=}"; exit 0; fi; done
      exit 1
    fi
    WORD=/data/login-url; if has "$@"; then
      # Each look the installer takes for the link is counted, so a sign-in can last until it has looked.
      WORD=cat; if has "$@"; then [ -n "${STUB_LOGIN_URL:-}" ] && { echo look >> "$STUB_STATE/link-looks"; echo "$STUB_LOGIN_URL"; } || exit 1; fi
      exit 0
    fi
    WORD=login; if has "$@"; then
      IFS= read -r line || true; printf 'tty %s\n' "$line" >> "$STUB_LOG"
      touch "$STUB_STATE/signed-in-$3"
      # STUB_LOGIN_UNTIL_LOOKS: the sign-in lasts until the installer looked for the link that many times, so it has done
      # what it does with each earlier look; it waits for that, not for a time.
      while [ "$(cat "$STUB_STATE/link-looks" 2> /dev/null | wc -l)" -lt "${STUB_LOGIN_UNTIL_LOOKS:-0}" ]; do sleep 0.01; done
      echo "Logged in."; exit "${STUB_LOGIN_EXIT:-0}"
    fi
    WORD=status; if has "$@"; then
      for n in ${STUB_REMOVED:-}; do WORD=$n; if has "$@"; then echo removed; exit 0; fi; done
      # after_login: the node needs its sign-in until it went through the terminal sign-in.
      if [ "${STUB_STATUS:-}" = after_login ]; then [ -f "$STUB_STATE/signed-in-$2" ] && echo ready || echo needs_login; exit 0; fi
      echo "${STUB_STATUS:-ready}"
    fi ;;
  *) ;;
esac
exit 0
