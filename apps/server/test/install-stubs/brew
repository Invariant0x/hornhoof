#!/usr/bin/env bash
. "$STUB_SRC/_log.sh"
case "$*" in
  install*) for f in "$@"; do
    [ "$f" = docker ] && cp "$STUB_SRC/docker" "$STUB_BIN/docker"
    [ "$f" = colima ] && cp "$STUB_SRC/_colima" "$STUB_BIN/colima"
  done ;;
  "services start colima") touch "$STUB_STATE/docker-running" ;;
esac
exit 0
