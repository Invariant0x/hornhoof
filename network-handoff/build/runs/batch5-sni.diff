+if __package__:
+    from .harness import (BIN, Client, KeptConnection, PROXY_V2_SIGNATURE, ROOT, Stack, _tls_socket, _wait,
+                          load_relay_module, read_proxy_v2)
+else:
+    from harness import (BIN, Client, KeptConnection, PROXY_V2_SIGNATURE, ROOT, Stack, _tls_socket, _wait,
+                         load_relay_module, read_proxy_v2)
