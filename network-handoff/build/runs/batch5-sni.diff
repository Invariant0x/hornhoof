+        other_loopback = socket.inet_ntoa(bytes((127, 0, 0, 2)))
+        self.assertEqual(self.peer_caddy_sees('127.0.0.1'), FORGED_VISITOR)
+        self.assertEqual(self.peer_caddy_sees(other_loopback), other_loopback)
