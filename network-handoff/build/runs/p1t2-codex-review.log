   280	def proxy_check(name: str, content: dict) -> str | None:
   281	    """Today's NewProxy checks, then whether this registration may hold the name; None lets it through."""
   282	    if (content.get('user') or {}).get('user'):
   283	        return 'set no user in the tunnel config'
   284	    if content.get('proxy_type') != 'http':
   285	        return 'only http proxies are allowed'
   286	    if content.get('proxy_name') != name:
   287	        return f'the proxy must be named {name}'
   288	    if content.get('subdomain') != name:
   289	        return f'this key serves only {name}.{DOMAIN}'
   290	    if content.get('custom_domains'):
   291	        return 'custom domains are not allowed'
   292	    reason = shared_route_fields(content)
   293	    if reason is not None:
   294	        return reason
   295	    return register_route(name, content)
