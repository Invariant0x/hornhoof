   237	_route_locks_guard = threading.Lock()
   238	_route_locks: dict[str, threading.Lock] = {}
   239	
   240	
   241	def route_lock(name: str) -> threading.Lock:
   242	    with _route_locks_guard:
   243	        lock = _route_locks.get(name)
   244	        if lock is None:
   245	            lock = threading.Lock()
   246	            _route_locks[name] = lock
   247	    return lock
