   426	class Handler(BaseHTTPRequestHandler):
   427	    server_version = 'hornhoof-relay'
   428	    sys_version = ''
   429	    protocol_version = 'HTTP/1.1'
   430	
   431	    def log_message(self, fmt, *args):
   432	        pass
   433	
   434	    def client_ip(self) -> str:
   435	        fwd = self.headers.get('X-Forwarded-For')
   436	        return fwd.split(',')[0].strip() if fwd else self.client_address[0]
   437	
   438	    def send_json(self, status: int, body=None, headers=None) -> None:
   439	        data = b'' if body is None else json.dumps(body).encode()
   440	        self.send_response(status)
   441	        if body is not None:
   442	            self.send_header('Content-Type', 'application/json')
   443	        self.send_header('Content-Length', str(len(data)))
   444	        self.send_header('Cache-Control', 'no-store')
   445	        for k, v in (headers or {}).items():
   446	            self.send_header(k, v)
   447	        self.end_headers()
   448	        self.wfile.write(data)
   449	
   450	    def error(self, status: int, code: str, message: str, headers=None) -> None:
   451	        self.send_json(status, {'error': code, 'message': message}, headers)
   452	
   453	    def read_json(self):
   454	        length = int(self.headers.get('Content-Length') or 0)
   455	        if length > MAX_BODY:
   456	            raise ValueError('body too large')
   457	        raw = self.rfile.read(length) if length else b''
   458	        return json.loads(raw) if raw.strip() else {}
   459	
   460	    def path_parts(self):
   461	        return [p for p in self.path.split('?', 1)[0].split('/') if p]
   462	
   463	    def bearer_key(self) -> str:
   464	        auth = self.headers.get('Authorization') or ''
   465	        return auth[7:].strip() if auth.lower().startswith('bearer ') else ''
   466	
   467	    def wrong_key(self, ip: str):
   468	        """The 401 for a bad key, counted like DELETE; 429 once an address passes 30 bad keys in an hour."""
   469	        wait = bad_keys.allow(ip)
   470	        if wait:
   471	            return self.error(429, 'rate_limited', 'Too many wrong keys, try again later.', {'Retry-After': str(wait)})
   472	        return self.error(401, 'unauthorized', 'Send the binding key as Authorization: Bearer <key>.')
   473	
   474	    def do_GET(self):
   475	        parts = self.path_parts()
   476	        if parts[:3] == ['api', 'v1', 'names'] and len(parts) == 4:
   477	            return self.name_answer(parts[3].lower())
   478	        if parts[:3] == ['api', 'v1', 'links'] and len(parts) == 5 and parts[4] == 'route':
   479	            return self.route_answer(parts[3].lower())
   480	        if parts == ['api', 'v1', 'health']:
   481	            return self.send_json(200, {'ok': True})
   482	        self.error(404, 'not_found', 'Not found.')
   483	
   484	    def name_answer(self, name: str):
   485	        wait = name_checks.allow(self.client_ip())
   486	        if wait:
   487	            return self.error(429, 'rate_limited', 'Too many checks, try again later.', {'Retry-After': str(wait)})
   488	        reason = check_name(name)
   489	        body = {'name': name, 'free': reason is None}
   490	        if reason:
   491	            body['reason'] = reason
   492	        return self.send_json(200, body)
   493	
   494	    def route_answer(self, name: str):
   495	        """GET /api/v1/links/<name>/route: who holds the name (R2.1), never a guess (R2.3)."""
   496	        row = db().execute('SELECT key_hash FROM bindings WHERE name = ?', (name,)).fetchone()
   497	        if row is None:
   498	            return self.error(404, 'not_found', f'There is no binding {name}.')
   499	        key = self.bearer_key()
   500	        if not key or not hmac.compare_digest(row[0], key_hash(key)):
   501	            return self.wrong_key(self.client_ip())
   502	        try:
   503	            return self.send_json(200, route_of(name))
   504	        except FrpsUnknown:
   505	            return self.error(503, 'unknown', 'The relay cannot tell whether the route is live.')
   506	
   507	    def handle_plugin(self):
   508	        # frps only: Caddy never routes /frp/ here and always adds X-Forwarded-For.
   509	        if self.headers.get('X-Forwarded-For') or self.client_address[0] != '127.0.0.1':
   510	            return self.error(403, 'forbidden', 'Forbidden.')
   511	        op, content, err = self.plugin_request()
   512	        if err is not None:
   513	            return self.send_json(200, {'reject': True, 'reject_reason': err})
   514	        started = time.monotonic()
   515	        try:
   516	            result = plugin(op, content)
   517	        except Exception as e:  # never let a bad plugin call through
   518	            result = {'reject': True, 'reject_reason': f'relay error: {type(e).__name__}'}
   519	        trace_plugin(op, content, result, started)
   520	        return self.send_json(200, result)
   521	
   522	    def plugin_request(self) -> tuple[str, dict, str | None]:
   523	        """Parse the plugin body into (op, content, error reason)."""
   524	        try:
   525	            req = self.read_json()
   526	            if not isinstance(req, dict):
   527	                raise TypeError('plugin request is not an object')
   528	            content = req.get('content')
   529	            if not isinstance(content, dict):
   530	                content = {}
   531	            return req.get('op', ''), content, None
   532	        except Exception as e:
   533	            return '', {}, f'relay error: {type(e).__name__}'
   534	
   535	    def do_POST(self):
   536	        parts = self.path_parts()
   537	        if parts == ['frp', 'handler']:
   538	            return self.handle_plugin()
   539	        if parts == ['api', 'v1', 'bindings']:
   540	            return self.create_binding()
   541	        self.error(404, 'not_found', 'Not found.')
   542	
   543	    def create_binding(self):
   544	        if (self.headers.get('Content-Type') or '').split(';')[0].strip().lower() != 'application/json':
   545	            return self.error(415, 'unsupported_media_type', 'Send the body as application/json.')
   546	        try:
   547	            body = self.read_json()
   548	        except (ValueError, json.JSONDecodeError):
   549	            return self.error(400, 'invalid', 'The body is not valid JSON.')
   550	        if not isinstance(body, dict):
   551	            return self.error(400, 'invalid', 'The body must be a JSON object.')
   552	        name = body.get('name')
   553	        if name is not None and (not isinstance(name, str) or name == ''):
   554	            return self.error(400, 'invalid', 'name must be a non-empty string, or left out for a random one.')
   555	        ip = self.client_ip()
   556	        with create_lock:
   557	            t = now()
   558	            conn = db()
   559	            conn.execute('DELETE FROM creations WHERE at < ?', (t - 3600,))
   560	            mine = conn.execute('SELECT COUNT(*), MIN(at) FROM creations WHERE ip = ?', (ip,)).fetchone()
   561	            total = conn.execute('SELECT COUNT(*) FROM creations').fetchone()[0]
   562	            if mine[0] >= BIND_PER_IP_HOUR or total >= BIND_ALL_HOUR:
   563	                wait = (mine[1] + 3600 - t) if mine[0] >= BIND_PER_IP_HOUR else 600
   564	                return self.error(429, 'rate_limited', 'Too many new links from this address, try again later.',
   565	                                  {'Retry-After': str(max(wait, 1))})
   566	            if name is None:
   567	                while True:
   568	                    name = ''.join(secrets.choice(RANDOM_ALPHABET) for _ in range(24))
   569	                    if check_name(name) is None:
   570	                        break
   571	            else:
   572	                name = name.lower()
   573	                reason = check_name(name)
   574	                if reason == 'invalid':
   575	                    return self.error(400, 'invalid', 'Use lowercase letters, digits and hyphens, 1-63 characters, '
   576	                                                      'no hyphen at either end and none in the 3rd and 4th place.')
   577	                if reason:
   578	                    return self.error(409, reason, f'{name}.{DOMAIN} is {reason}.')
   579	            key = secrets.token_urlsafe(32)
   580	            conn.execute('INSERT INTO bindings (name, key_hash, created_at, created_ip) VALUES (?, ?, ?, ?)',
   581	                         (name, key_hash(key), t, ip))
   582	            conn.execute('INSERT INTO creations (ip, at) VALUES (?, ?)', (ip, t))
   583	        print(f'bound {name} for {ip}', flush=True)
   584	        self.send_json(201, {'name': name, 'url': f'https://{name}.{DOMAIN}', 'key': key,
   585	                             'tunnel': tunnel_info(name, key)})
   586	
   587	    def do_DELETE(self):
   588	        parts = self.path_parts()
   589	        if not (parts[:3] == ['api', 'v1', 'bindings'] and len(parts) == 4):
   590	            return self.error(404, 'not_found', 'Not found.')
   591	        name = parts[3].lower()
   592	        row = db().execute('SELECT key_hash, banned_at FROM bindings WHERE name = ?', (name,)).fetchone()
   593	        if row is None:
   594	            return self.error(404, 'not_found', f'There is no binding {name}.')
   595	        key = self.bearer_key()
   596	        if not key or not hmac.compare_digest(row[0], key_hash(key)):
   597	            return self.wrong_key(self.client_ip())
   598	        if row[1]:
   599	            return self.error(403, 'blocked', f'{name}.{DOMAIN} is blocked and cannot be released.')
   600	        db().execute('DELETE FROM bindings WHERE name = ?', (name,))
   601	        print(f'released {name} for {self.client_ip()}', flush=True)
   602	        self.send_json(204)
