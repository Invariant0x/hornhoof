   272	def shared_route_fields(content: dict) -> str | None:
   273	    """R1.2: a name is one company's one route, never shared or split across locations or users."""
   274	    for field in ('locations', 'route_by_http_user', 'group'):
   275	        if content.get(field):
   276	            return f'{field} is not allowed'
   277	    return None
