   250	def register_route(name: str, content: dict) -> str | None:
   251	    """Record a registration the plugin let through; a reason when the name cannot be taken (R1.1)."""
   252	    user = content.get('user') or {}
   253	    with route_lock(name):
   254	        try:
   255	            held = route_of(name)['state'] == 'held'
   256	        except FrpsUnknown:
   257	            return 'relay error: frps does not answer'
   258	        if held:
   259	            return f'router config conflict: {name} is held'
   260	        row = db().execute('SELECT generation FROM routes WHERE name = ?', (name,)).fetchone()
   261	        generation = (row[0] if row else 0) + 1
   262	        metas = user.get('metas') or {}
   263	        db().execute(
   264	            'INSERT INTO routes (name, generation, client, run_id, type, state, since) VALUES (?, ?, ?, ?, ?, ?, ?) '
   265	            'ON CONFLICT(name) DO UPDATE SET generation = excluded.generation, client = excluded.client, '
   266	            'run_id = excluded.run_id, type = excluded.type, state = excluded.state, since = excluded.since',
   267	            (name, generation, metas.get('client') or 'legacy', user.get('run_id') or '',
   268	             content.get('proxy_type') or 'http', 'pending', now()))
   269	    return None
   270	
