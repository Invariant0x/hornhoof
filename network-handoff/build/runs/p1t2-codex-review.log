   411	def plugin(op: str, content: dict) -> dict:
   412	    if op == 'Login':
   413	        metas = content.get('metas') or {}
   414	    else:
   415	        metas = (content.get('user') or {}).get('metas') or {}
   416	    name, key = metas.get('name'), metas.get('key')
   417	    reason = binding_ok(name, key)
   418	    if reason is None and op == 'NewProxy':
   419	        reason = proxy_check(name, content)
   420	    if reason is not None:
   421	        return {'reject': True, 'reject_reason': reason}
   422	    touch(name)
   423	    return {'reject': False, 'unchange': True}
