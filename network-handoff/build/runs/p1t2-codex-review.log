   311	def trace_plugin(op: str, content: dict, result: dict, started: float) -> None:
   312	    """With RELAY_TRACE=1, one JSON line per plugin call: no key, no metas beyond client."""
   313	    if not os.environ.get('RELAY_TRACE'):
   314	        return
   315	    line = {'op': op, 'proxy_name': content.get('proxy_name') or '', 'run_id': trace_run_id(op, content),
   316	            'client': trace_client(op, content), 'ms': round((time.monotonic() - started) * 1000, 1),
   317	            'reject': bool(result.get('reject'))}
   318	    print('TRACE ' + json.dumps(line), flush=True)
