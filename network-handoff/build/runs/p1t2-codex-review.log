   192	def straighten_route(name: str, row, status: str, t: int) -> None:
   193	    """Move the row to what frps shows; guarded so a row written since we read frps is never clobbered.
   194	
   195	    A young pending row reads held only while frps has not shown the route at all (absent): the
   196	    registration may still appear. A route frps shows offline existed and is gone, so even a young
   197	    pending row is empty and the name can be registered again.
   198	    """
   199	    state = row[4]
   200	    if status == 'online':
   201	        db().execute("UPDATE routes SET state = 'held' WHERE name = ? AND state IN ('pending', 'empty')", (name,))
   202	        return
   203	    stale = state == 'held' or (state == 'pending' and (status == 'offline' or t - row[5] > PENDING_S))
   204	    if stale:
   205	        db().execute("UPDATE routes SET state = 'empty', since = ? WHERE name = ? AND state IN ('held', 'pending') "
   206	                     'AND since = ?', (t, name, row[5]))
   207	
   208	
   209	def route_body(name: str, row) -> dict:
   210	    """The R2.1 answer from a routes row; a name with no row is empty at generation 0."""
   211	    if row is None:
   212	        binding = db().execute('SELECT created_at FROM bindings WHERE name = ?', (name,)).fetchone()
   213	        since = binding[0] if binding else None
   214	        state, client, generation = 'empty', None, 0
   215	    else:
   216	        since = row[5]
   217	        state = 'empty' if row[4] == 'empty' else 'held'
   218	        client = row[1] if state == 'held' else None
   219	        generation = row[0]
   220	    return {'state': state, 'client': client, 'since': since, 'generation': generation,
   221	            'relayStarted': STARTED, 'evictionBound': EVICTION_BOUND_S, 'sync': None}
   222	
   223	
   224	def route_of(name: str) -> dict:
   225	    """The R2.1 body for a name: the routes row straightened against what frps shows right now."""
   226	    status, client_id, proxy_type = frps_route(name)
   227	    row = db().execute('SELECT generation, client, run_id, type, state, since FROM routes WHERE name = ?',
   228	                       (name,)).fetchone()
   229	    if row is not None:
   230	        check_route_holder(name, row, status, client_id, proxy_type)
   231	        straighten_route(name, row, status, now())
   232	        row = db().execute('SELECT generation, client, run_id, type, state, since FROM routes WHERE name = ?',
   233	                           (name,)).fetchone()
   234	    return route_body(name, row)
