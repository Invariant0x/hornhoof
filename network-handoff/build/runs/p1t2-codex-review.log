   389	def binding_ok(name: str, key: str):
   390	    """None if the name exists, is not banned and the key matches, else a reason."""
   391	    if not isinstance(name, str) or not isinstance(key, str) or not name or not key:
   392	        return 'this tunnel has no Hornhoof relay binding (metadatas.name and metadatas.key)'
   393	    row = db().execute('SELECT key_hash, banned_at FROM bindings WHERE name = ?', (name,)).fetchone()
   394	    if row is None or not hmac.compare_digest(row[0], key_hash(key)):
   395	        return f'no binding {name} with this key'
   396	    if row[1]:
   397	        return f'{name}.{DOMAIN} is blocked'
   398	    return None
