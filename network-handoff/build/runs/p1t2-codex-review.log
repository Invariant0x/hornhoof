   605	def admin(args) -> int:
   606	    init_db()
   607	    conn = db()
   608	    cmd = args[0] if args else 'list'
   609	    if cmd == 'list':
   610	        for r in conn.execute('SELECT name, created_at, created_ip, last_seen, banned_at, ban_reason FROM bindings '
   611	                              'ORDER BY created_at'):
   612	            seen = time.strftime('%Y-%m-%d %H:%M', time.gmtime(r[3])) if r[3] else 'never'
   613	            ban = f'  BLOCKED: {r[5]}' if r[4] else ''
   614	            print(f'{r[0]}  created {time.strftime("%Y-%m-%d %H:%M", time.gmtime(r[1]))} from {r[2]}  seen {seen}{ban}')
   615	        return 0
   616	    if cmd == 'banned-caddy':
   617	        hosts = [f'{r[0]}.{DOMAIN}' for r in conn.execute('SELECT name FROM bindings WHERE banned_at IS NOT NULL')]
   618	        print('# Generated by hornhoof-relay from blocked bindings. Do not edit.')
   619	        if hosts:
   620	            print(f'@blocked host {" ".join(hosts)}\nhandle @blocked {{\n\troot * /var/www/hornhoof-pages\n\trewrite * /410.html\n'
   621	                  f'\tfile_server {{\n\t\tstatus 410\n\t}}\n}}')
   622	        return 0
   623	    if cmd == 'add' and len(args) == 2:
   624	        # Operator-made binding, no rate limit. Prints {name, key} as JSON once; keep it secret.
   625	        name = args[1].lower()
   626	        reason = check_name(name)
   627	        if reason:
   628	            print(f'{name}: {reason}', file=sys.stderr)
   629	            return 1
   630	        key = secrets.token_urlsafe(32)
   631	        conn.execute('INSERT INTO bindings (name, key_hash, created_at, created_ip) VALUES (?, ?, ?, ?)',
   632	                     (name, key_hash(key), now(), 'operator'))
   633	        print(json.dumps({'name': name, 'key': key}))
   634	        return 0
   635	    if cmd in ('ban', 'unban', 'release') and len(args) >= 2:
   636	        name = args[1].lower()
   637	        if cmd == 'ban':
   638	            reason = ' '.join(args[2:]) or 'blocked by the relay operator'
   639	            if conn.execute('SELECT 1 FROM bindings WHERE name = ?', (name,)).fetchone():
   640	                conn.execute('UPDATE bindings SET banned_at = ?, ban_reason = ? WHERE name = ?', (now(), reason, name))
   641	            else:  # block a name nobody holds, so nobody can take it
   642	                conn.execute('INSERT INTO bindings (name, key_hash, created_at, created_ip, banned_at, ban_reason) '
   643	                             'VALUES (?, ?, ?, ?, ?, ?)', (name, '-', now(), 'operator', now(), reason))
   644	        elif cmd == 'unban':
   645	            conn.execute('UPDATE bindings SET banned_at = NULL, ban_reason = NULL WHERE name = ?', (name,))
   646	            conn.execute("DELETE FROM bindings WHERE name = ? AND key_hash = '-'", (name,))
   647	        else:
   648	            conn.execute('DELETE FROM bindings WHERE name = ?', (name,))
   649	        print(f'{cmd} {name}: done')
   650	        return 0
   651	    print('usage: relay.py admin list | add <name> | ban <name> [reason] | unban <name> | release <name> | banned-caddy',
   652	          file=sys.stderr)
   653	    return 2
