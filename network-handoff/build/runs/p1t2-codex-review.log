   143	def _dash_get(path: str) -> tuple[int, bytes]:
   144	    """One dashboard read with a 0.5 s timeout; any error or timeout is FrpsUnknown."""
   145	    parsed = urlsplit(RELAY_FRPS_API)
   146	    host = parsed.hostname or '127.0.0.1'
   147	    port = parsed.port or (443 if parsed.scheme == 'https' else 80)
   148	    kind = http.client.HTTPSConnection if parsed.scheme == 'https' else http.client.HTTPConnection
