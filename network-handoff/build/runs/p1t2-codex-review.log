   321	class Window:
   322	    """Counts events per key in a sliding window, in memory."""
   323	
   324	    def __init__(self, limit: int, seconds: int):
   325	        self.limit, self.seconds, self.hits, self.lock = limit, seconds, {}, threading.Lock()
   326	
   327	    def allow(self, key: str) -> int:
   328	        """0 if allowed (and counted), else seconds to wait."""
   329	        t = time.time()
   330	        with self.lock:
   331	            if len(self.hits) > 50000:
   332	                self.hits = {k: v for k, v in self.hits.items() if v and v[-1] > t - self.seconds}
   333	            recent = [x for x in self.hits.get(key, []) if x > t - self.seconds]
   334	            if len(recent) >= self.limit:
   335	                self.hits[key] = recent
   336	                return int(recent[0] + self.seconds - t) + 1
   337	            recent.append(t)
   338	            self.hits[key] = recent
   339	            return 0
   340	
