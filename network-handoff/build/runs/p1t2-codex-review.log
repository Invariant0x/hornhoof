   347	def frpc_config(name: str, key: str) -> str:
   348	    return f'''# Hornhoof relay tunnel for https://{name}.{DOMAIN}
   349	# Keep this file secret: it holds the key of the binding.
   350	serverAddr = "{DOMAIN}"
   351	serverPort = 443
   352	loginFailExit = false
   353	log.to = "console"
   354	log.level = "info"
   355	log.disablePrintColor = true
   356	transport.protocol = "wss"
   357	transport.tls.trustedCaFile = "/etc/ssl/certs/ca-certificates.crt"
   358	transport.heartbeatInterval = 30
   359	transport.heartbeatTimeout = 90
   360	metadatas.name = "{name}"
   361	metadatas.key = "{key}"
   362	
   363	[[proxies]]
   364	name = "{name}"
   365	type = "http"
   366	subdomain = "{name}"
   367	localIP = "{TARGET_HOST}"
   368	localPort = {TARGET_PORT}
   369	# frps speaks plain http to the tunnel; the visitor came over https.
   370	requestHeaders.set.x-forwarded-proto = "https"
   371	'''
   372	
