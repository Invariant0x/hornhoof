   414	def route_body(name: str, row) -> dict:
   415	    """The R2.1 answer from a routes row; a name with no row is empty at generation 0."""
   416	    if row is None:
   417	        binding = db().execute('SELECT created_at FROM bindings WHERE name = ?', (name,)).fetchone()
   418	        since = binding[0] if binding else None
   419	        state, client, generation = 'empty', None, 0
   420	    else:
   421	        since = row[5]
   422	        state = 'empty' if row[4] == 'empty' else 'held'
   423	        client = row[1] if state == 'held' else None
   424	        generation = row[0]
   425	    return {'state': state, 'client': client, 'since': since, 'generation': generation,
   426	            'relayStarted': relay_started(), 'evictionBound': EVICTION_BOUND_S, 'sync': sync_of(name)}
