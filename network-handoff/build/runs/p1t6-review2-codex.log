   367	class WriteBusy(Exception):
   368	    """A SQLite write could not take the lock within its budget: refuse the op, never guess."""
   369	
   370	
   371	def write(sql: str, args: tuple) -> None:
   372	    """The one SQLite write of the plugin and the API.
   373	
   374	    SQLite itself retries database is locked for the write's budget (0.8 s, or the plugin
   375	    call's time left, whichever is less); past the budget the write raises WriteBusy and a
   376	    plugin call refuses with 'relay error: busy' (Review Focus 3).
   377	    """
   378	    conn = db()
   379	    left = call_deadline()
   380	    if left is not None and left <= 0:
   381	        raise WriteBusy('plugin call budget spent')
   382	    budget = 0.8 if left is None else min(0.8, left)
   383	    conn.execute(f'PRAGMA busy_timeout = {max(0, int(budget * 1000))}')
   384	    try:
   385	        conn.execute(sql, args)
   386	    except sqlite3.OperationalError as e:
   387	        if 'locked' in str(e):
   388	            raise WriteBusy(f'database is locked for {budget:.2f} s') from None
   389	        raise
   390	    finally:
   391	        conn.execute('PRAGMA busy_timeout = 10000')
