   173	# frps watcher state: frps_ok_at is the epoch of the last good probe, frps_back_at the epoch
   174	# of the first good probe after a failure or after start (0 until then).
   175	_frps = {'ok_at': 0.0, 'back_at': 0}
   176	WATCH_INTERVAL_S = 0.5
   177	# Health answers 200 only while the watcher's last good probe is younger than this.
