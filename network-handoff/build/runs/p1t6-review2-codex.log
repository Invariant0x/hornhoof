   352	def check_route_holder(name: str, row, status: str, client_id: str | None, proxy_type: str | None) -> None:
   353	    """An online route must match the relay's own record, else the answer is unknown, never empty (R2.3).
   354	
   355	    A missing row means the record was lost while frps holds the route: unknown too.
   356	    """
   357	    if status != 'online':
   358	        return
   359	    matches = (row is not None and proxy_type == row[3]
   360	               and client_id == (row[2] if row[1] == 'legacy' else row[1]))
   361	    if matches:
   362	        return
   363	    log_line(f'route of {name} is online outside the relay record')
   364	    raise FrpsUnknown(f'frps route of {name} does not match the relay record')
