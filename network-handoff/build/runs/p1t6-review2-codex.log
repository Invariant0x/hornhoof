from pathlib import Path
from relay.test import test_peers as peers

original = peers.VisitorKeyStoreTests.setUp

def unsafe_release_setup(self):
    original(self)
    def separate_deletes(name):
        self.relay.write('DELETE FROM visitor_keys WHERE name = ?', (name,))
        self.relay.write('DELETE FROM bindings WHERE name = ?', (name,))
    self.relay.release_binding = separate_deletes

peers.VisitorKeyStoreTests.setUp = unsafe_release_setup
result = unittest.TextTestRunner(stream=io.StringIO(), verbosity=0).run(
    unittest.defaultTestLoader.loadTestsFromTestCase(peers.VisitorKeyStoreTests))
print('Release transaction removed:', result.testsRun, 'tests run,', len(result.failures), 'failed,', len(result.errors), 'errors')

def interleave(use_transaction):
    with tempfile.TemporaryDirectory(prefix='p1t6-review-release-') as tmp:
        relay = peers._relay_module()
        relay.DB_PATH = str(Path(tmp) / 'relay.db')
        relay.init_db()
        relay.write('INSERT INTO bindings (name,key_hash,created_at) VALUES (?,?,?)', ('acme', relay.key_hash('fixture-link'), relay.now()))
        relay.store_visitor_key('acme', relay.key_hash('fixture-visitor-before'), relay.key_hash('fixture-link'))
        original_write = relay.write
        in_gap, proceed = threading.Event(), threading.Event()
        failures = []
        def pausing_write(sql, args):
            original_write(sql, args)
            if sql.startswith('DELETE FROM visitor_keys'):
                in_gap.set()
                if not proceed.wait(5):
                    raise RuntimeError('probe coordination expired')
        relay.write = pausing_write
        if not use_transaction:
            def release(name):
                relay.write('DELETE FROM visitor_keys WHERE name = ?', (name,))
                relay.write('DELETE FROM bindings WHERE name = ?', (name,))
            relay.release_binding = release
        def releasing():
            try:
                relay.release_binding('acme')
            except Exception as exc:
                failures.append(type(exc).__name__)
            finally:
                relay.db().close()
        worker = threading.Thread(target=releasing)
        worker.start()
        assert in_gap.wait(5)
        try:
            try:
                issued = relay.store_visitor_key('acme', relay.key_hash('fixture-visitor-during'), relay.key_hash('fixture-link'))
            except relay.WriteBusy:
                issued = 'busy'
        finally:
            proceed.set()
            worker.join(5)
        orphan = relay.db().execute('SELECT COUNT(*) FROM visitor_keys').fetchone()[0]
        bindings = relay.db().execute('SELECT COUNT(*) FROM bindings').fetchone()[0]
        relay.db().close()
        assert not worker.is_alive() and not failures
        return issued, orphan, bindings
print('Interleaving with production transaction (issued, visitor rows, bindings):', interleave(True))
print('Interleaving with separate deletes (issued, visitor rows, bindings):', interleave(False))
