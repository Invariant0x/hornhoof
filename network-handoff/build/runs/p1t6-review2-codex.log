   139	    def echo_closes_silent(self, port: int) -> None:
   140	        """A wrong secret closes the visitor's connection with no answer: zero raw bytes
   141	        before EOF or a reset. An HTTP answer with an empty body, or a connection that
   142	        stays open, is not a silent close (probed against a plain 200/403 in TMPDIR)."""
   143	        sock = socket.create_connection(('127.0.0.1', port), timeout=10)
   144	        try:
   145	            try:
   146	                sock.sendall(b'GET /through-the-relay HTTP/1.1\r\nHost: probe\r\nConnection: close\r\n\r\n')
   147	            except (ConnectionResetError, BrokenPipeError):
   148	                return  # reset before the request went out: still no answer
   149	            received = b''
   150	            while True:
   151	                try:
   152	                    chunk = sock.recv(4096)
   153	                except (ConnectionResetError, BrokenPipeError):
   154	                    break
   155	                except socket.timeout:
   156	                    self.fail('the connection stayed open with no answer; a timeout is not a silent close')
   157	                if not chunk:
   158	                    break
   159	                received += chunk
   160	            self.assertEqual(received, b'')
   161	        finally:
   162	            sock.close()
