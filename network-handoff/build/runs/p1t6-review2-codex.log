   196	def watch_frps() -> None:
   197	    """Probe frps forever; keep the last good answer and the recovery after a failure."""
   198	    was_ok = False
   199	    while True:
   200	        if frps_answers():
   201	            t = time.time()
   202	            if not was_ok:
   203	                _frps['back_at'] = t
   204	            _frps['ok_at'] = t
   205	            was_ok = True
   206	        else:
   207	            was_ok = False
   208	        time.sleep(WATCH_INTERVAL_S)
   209	
   210	
   211	def frps_ok() -> bool:
   212	    """R4.1: true while the watcher's last frps answer is under HEALTH_MAX_AGE_S old."""
   213	    return time.time() - _frps['ok_at'] < HEALTH_MAX_AGE_S
