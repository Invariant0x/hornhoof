   501	        except sqlite3.Error as e:
   502	            raise FrpsUnknown(f'route store is not writable: {type(e).__name__}') from None
   503	        row = db().execute('SELECT generation, client, run_id, type, state, since FROM routes WHERE name = ?',
   504	                           (name,)).fetchone()
   505	    else:
   506	        check_route_holder(name, None, status, client_id, proxy_type)
