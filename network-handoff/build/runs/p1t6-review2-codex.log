   337	def frps_route(name: str) -> tuple[str, str | None, str | None]:
   338	    """frps's own view of a name's route: ('online'|'offline', clientID, type), or ('absent', None, None).
   339	
   340	    Both proxy types are read: a name holds one route of either type, and two records is unknown.
   341	    """
   342	    http = dash_answer(name, 'http')
   343	    https = dash_answer(name, 'https')
   344	    if http is not None and https is not None:
   345	        raise FrpsUnknown(f'dashboard shows both http and https routes for {name}')
   346	    for proxy_type, answer in (('http', http), ('https', https)):
   347	        if answer is not None:
   348	            return answer[0], answer[1], proxy_type
   349	    return 'absent', None, None
