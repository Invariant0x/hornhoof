   532	def hold_route_lock(name: str) -> bool:
   533	    """Take the per-name lock within the plugin call's remaining budget; False when the budget ran out."""
   534	    lock = route_lock(name)
   535	    left = call_deadline()
   536	    if left is None:
   537	        lock.acquire()
   538	        return True
   539	    return left > 0 and lock.acquire(timeout=left)
