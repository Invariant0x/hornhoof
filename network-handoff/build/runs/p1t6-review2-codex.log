   522	
   523	def route_lock(name: str) -> threading.Lock:
   524	    with _route_locks_guard:
   525	        lock = _route_locks.get(name)
   526	        if lock is None:
   527	            lock = threading.Lock()
   528	            _route_locks[name] = lock
   529	    return lock
