   803	    if left is not None and left <= 0:
   804	        raise WriteBusy('plugin call budget spent')
   805	    budget = 0.8 if left is None else min(0.8, left)
   806	    conn.execute(f'PRAGMA busy_timeout = {max(0, int(budget * 1000))}')
   807	    try:
