   468	def store_sync(name: str, body: dict) -> bool:
   469	    """Commit only while the checked registration still holds; never overwrite a newer epoch."""
   470	    write('INSERT INTO sync (name, state, copy, epoch, generation, at) '
   471	          'SELECT name, ?, ?, ?, generation, ? FROM routes '
   472	          "WHERE name = ? AND generation = ? AND client = ? AND state = 'held' "
   473	          'ON CONFLICT(name) DO UPDATE SET state = excluded.state, copy = excluded.copy, '
   474	          'epoch = excluded.epoch, generation = excluded.generation, at = excluded.at '
   475	          'WHERE excluded.epoch > sync.epoch',
   476	          (body['state'], body['copy'], body['epoch'], now(), name, body['generation'], body['client']))
   477	    return db().execute('SELECT changes()').fetchone()[0] == 1
