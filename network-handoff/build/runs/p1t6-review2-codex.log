   129	    def echo(self, port: int, path: str = '/through-the-relay') -> str:
   130	        connection = http.client.HTTPConnection('127.0.0.1', port, timeout=10)
   131	        try:
   132	            connection.request('GET', path)
   133	            response = connection.getresponse()
   134	            self.assertEqual(response.status, 200)
   135	            return response.read().decode()
   136	        finally:
   137	            connection.close()
