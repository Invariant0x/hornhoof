   429	def sync_of(name: str) -> dict:
   430	    """The last committed sync record, or the R2.4 default when no holder has set one."""
   431	    row = db().execute('SELECT state, copy, epoch, generation, at FROM sync WHERE name = ?',
   432	                       (name,)).fetchone()
   433	    if row is None:
   434	        return {'state': 'off', 'copy': None, 'epoch': 0, 'generation': 0, 'at': None}
   435	    return dict(zip(('state', 'copy', 'epoch', 'generation', 'at'), row))
