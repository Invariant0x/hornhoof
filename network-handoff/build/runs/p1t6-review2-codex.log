     1	# frps for the Hornhoof relay. Everything listens on loopback: Caddy brings tunnels in over wss
     2	# (https://hornhoof.org/~!frp -> 7000) and company traffic (*.hornhoof.org -> 8080).
     3	# Every login, proxy and heartbeat is checked by hornhoof-relay (127.0.0.1:7600); if it does not answer, frps refuses.
     4	bindAddr = "127.0.0.1"
     5	bindPort = 7000
     6	proxyBindAddr = "127.0.0.1"
     7	vhostHTTPPort = 8080
     8	vhostHTTPTimeout = 60
     9	subDomainHost = "hornhoof.org"
    10	custom404Page = "/etc/frp/404.html"
    11	detailedErrorsToClient = true
    12	userConnTimeout = 10
    13	
    14	auth.method = "token"
    15	auth.token = ""
    16	
    17	transport.tcpMux = true
    18	transport.maxPoolCount = 5
    19	# tcpMux keepalive drops a silent client within 30 s.
    20	# Heartbeats, where a client still sends them, are checked by the plugin as before.
    21	transport.tcpMuxKeepaliveInterval = 10
    22	transport.heartbeatTimeout = -1
    23	
    24	log.to = "console"
    25	log.level = "info"
    26	
    27	webServer.addr = "127.0.0.1"
    28	webServer.port = 7500
    29	webServer.user = "admin"
    30	webServer.password = "@WEB_PASSWORD@"
    31	
    32	[[httpPlugins]]
    33	name = "hornhoof-relay"
    34	addr = "127.0.0.1:7600"
    35	path = "/frp/handler"
    36	ops = ["Login", "NewProxy", "Ping"]

