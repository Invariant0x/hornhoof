   394	def straighten_route(name: str, row, status: str, t: int) -> None:
   395	    """Move the row to what frps shows; each UPDATE is guarded by the generation as read, so a row
   396	    rewritten since we read frps keeps its newer registration. The per-name lock is held.
   397	
   398	    A pending row younger than PENDING_S is a registration frps has not shown yet: it reads held
   399	    even when frps still shows the previous registration's offline record, because frps keeps that
   400	    record until the new one shows. Only an online record turns it held, age or absence empties it.
   401	    """
   402	    state, generation = row[4], row[0]
   403	    if status == 'online':
   404	        write("UPDATE routes SET state = 'held' WHERE name = ? AND generation = ? "
   405	              "AND state IN ('pending', 'empty')", (name, generation))
   406	    elif state == 'held':
   407	        write("UPDATE routes SET state = 'empty', since = ? WHERE name = ? AND generation = ? "
   408	              "AND state = 'held'", (t, name, generation))
   409	    elif state == 'pending' and t - row[5] > PENDING_S:
   410	        write("UPDATE routes SET state = 'empty', since = ? WHERE name = ? AND generation = ? "
   411	              "AND state = 'pending'", (t, name, generation))
