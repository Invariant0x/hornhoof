   492	def locked_route_of(name: str) -> dict:
   493	    """The R2.1 body with the per-name lock already held: the row straightened against frps."""
   494	    status, client_id, proxy_type = frps_route(name)
   495	    row = db().execute('SELECT generation, client, run_id, type, state, since FROM routes WHERE name = ?',
   496	                       (name,)).fetchone()
