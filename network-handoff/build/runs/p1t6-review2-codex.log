   233	
   234	def _dash_get(path: str, cap: float = 0.5) -> tuple[int, bytes]:
   235	    """One dashboard read with a cap-second timeout; less when the plugin call's budget is nearly spent.
   236	
   237	    The watcher's own probes pass cap=1. Any error, timeout or a spent budget is FrpsUnknown.
   238	    """
   239	    parsed = urlsplit(RELAY_FRPS_API)
   240	    host = parsed.hostname or '127.0.0.1'
   241	    port = parsed.port or (443 if parsed.scheme == 'https' else 80)
   242	    kind = http.client.HTTPSConnection if parsed.scheme == 'https' else http.client.HTTPConnection
   243	    left = call_deadline()
   244	    if left is not None and left <= 0:
   245	        raise FrpsUnknown(f'{path}: plugin call budget spent')
   246	    connection = kind(host, port, timeout=cap if left is None else min(cap, left))
   247	    try:
   248	        token = base64.b64encode(f'{FRPS_USER}:{FRPS_PASSWORD}'.encode()).decode()
   249	        connection.request('GET', path, headers={'Authorization': f'Basic {token}'})
   250	        response = connection.getresponse()
   251	        return response.status, response.read()
   252	    except (OSError, http.client.HTTPException) as e:
   253	        raise FrpsUnknown(f'{path}: {type(e).__name__}') from None
   254	    finally:
   255	        connection.close()
