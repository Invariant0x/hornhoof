import hashlib
import json
import socket
import struct
import tempfile
import time
from relay.test.harness import Stack

def exact(sock, length):
    data = b''
    while len(data) < length:
        part = sock.recv(length-len(data))
        if not part:
            raise EOFError('local frps closed')
        data += part
    return data

def login(stack, name, key, run_id, client_id=''):
    stamp = int(time.time())
    message = {'version': '0.71.1', 'os': 'darwin', 'arch': 'arm64', 'timestamp': stamp,
               'privilege_key': hashlib.md5(str(stamp).encode()).hexdigest(), 'run_id': run_id,
               'metas': {'name': name, 'key': key}, 'client_id': client_id}
    if client_id:
        message['metas']['client'] = client_id
    data = json.dumps(message).encode()
    packet = b'o' + struct.pack('"'!Q'"', len(data)) + data
    with socket.create_connection(('127.0.0.1',stack.bind_port), timeout=3) as sock:
        sock.sendall(struct.pack('"'!BBHII'"',0,0,1,1,len(packet)) + packet)
        received = b''
        for _ in range(10):
            version, kind, flags, stream_id, length = struct.unpack('"'!BBHII'"', exact(sock,12))
            if kind == 0:
                received += exact(sock,length)
                if len(received) >= 9:
                    required = 9 + struct.unpack('"'!Q'"', received[1:9])[0]
                    if len(received) >= required:
                        return received[:1], json.loads(received[9:required])
            elif kind == 2 and flags & 1:
                sock.sendall(struct.pack('"'!BBHII'"',0,2,2,0,length))
        raise RuntimeError('no local LoginResp')

with tempfile.TemporaryDirectory(prefix='p1t6-review-takeover-') as tmp:
    with Stack(tmp) as stack:
        first = stack.bind('acme')
        other = stack.bind('globex')
        client = stack.client('acme',first['key'], settings='network', client='acme-3f2a9c1b-link')
        assert client.started('acme')
        status, records = stack.dash('/api/clients')
        victim = next(row for row in records if row['online'])
        try:
            kind, answer = login(stack,'globex',other['key'],victim['runID'])
            print('Actual frps legacy takeover of explicit session refused:', answer.get('error') == 'this run id belongs to another client')
            print('Actual LoginResp error:', answer.get('error',''))
        except Exception as exc:
            print('Wire probe failed:', type(exc).__name__)
        print('Victim HTTP status after attempt:',stack.get('acme.hornhoof.org'))
