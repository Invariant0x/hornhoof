+                       'ON b.name = p.name AND b.key_hash = p.link_hash '
+                       'WHERE p.name = ? AND p.key_hash = ? AND b.banned_at IS NULL',
+                       (name, key_hash(key))).fetchone()
+    return row is not None
+
