+          (name, link_hash, new_hash))
+
+
+def ping_key_matches(name: str | None, key: object) -> bool:
+    """A retired link hash serves only this still-bound, unblocked lifetime's Ping."""
+    if not isinstance(key, str) or not key:
+        return False
