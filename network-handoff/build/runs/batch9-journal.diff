+CREATE FUNCTION net.attach_journal() RETURNS integer
+LANGUAGE plpgsql SET search_path = pg_catalog, net_local, pg_temp AS $fn$
+DECLARE
+  t record;
+  attached integer := 0;
+BEGIN
+  FOR t IN SELECT c.oid, c.relname::text AS name FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
+           WHERE n.nspname = 'public' AND c.relkind = 'r' LOOP
+    IF octet_length(t.name) > 55 THEN
+      RAISE EXCEPTION 'Table public.% has a name over 55 characters, too long for its journal function.', t.name;
+    END IF;
+    EXECUTE format('CREATE OR REPLACE FUNCTION net.%I() RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path = pg_catalog, net_local, pg_temp AS %L',
+      'journal_' || t.name, net.source_of_journal(t.oid, t.name));
+    IF NOT EXISTS (SELECT 1 FROM pg_trigger WHERE tgrelid = t.oid AND tgname = 'net_journal') THEN
+      EXECUTE format('CREATE TRIGGER net_journal AFTER INSERT OR UPDATE OR DELETE ON public.%I FOR EACH ROW EXECUTE FUNCTION net.%I()', t.name, 'journal_' || t.name);
+      attached := attached + 1;
+    END IF;
+  END LOOP;
