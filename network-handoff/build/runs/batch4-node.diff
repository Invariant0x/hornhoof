     const node = await runNode({ dir, adapter, log: l => lines.push(l) });
     node.stop();
     expect(lines).toEqual(['This node was removed in Hornhoof.']);
   });
diff --git a/apps/node/test/outbox.test.ts b/apps/node/test/outbox.test.ts
new file mode 100644
index 00000000..00b4ad10
--- /dev/null
+++ b/apps/node/test/outbox.test.ts
