    14	class FrpFactsTests(unittest.TestCase):
    15	    def setUp(self):
    16	        self.tmp = self.enterContext(tempfile.TemporaryDirectory(prefix='hornhoof-frp-facts-'))
    17	        self.stack = self.enterContext(Stack(self.tmp))
    18	        self.binding = self.stack.bind('acme')
    19	
    20	    def test_fact_proxy_name_is_unique(self):
    21	        first = self.stack.client('acme', self.binding['key'])
    22	        self.assertTrue(first.started('acme'), first.log())
    23	        second = self.stack.client('acme', self.binding['key'])
    24	        self.assertFalse(second.started('acme', within=2), second.log())
    25	        # The relay refuses the duplicate registration before frps sees it (R1.1), so frps
    26	        # no longer answers 'proxy [acme] already exists'; it accepts the retry once the
    27	        # first client below stops and the relay lets the registration through.
    28	        self.assertIn('router config conflict: acme is held', second.log())
    29	        first.stop()
    30	        started = time.monotonic()
    31	        self.assertTrue(second.started('acme', within=40), second.log())
    32	        delay = time.monotonic() - started
    33	        print(f'proxy-name retry after first stopped: {delay:.2f} s', flush=True)
    34	        self.assertLessEqual(delay, 40)
    35	
    36	    def test_fact_dashboard_shows_the_route(self):
    37	        path = '/api/proxy/http/acme'
    38	        self.assertEqual(self.stack.dash(path)[0], 404)
    39	        first = self.stack.client('acme', self.binding['key'], client='acme-3f2a9c1b-link')
    40	        self.assertTrue(first.started('acme'), first.log())
    41	        status, route = self.stack.dash(path)
    42	        self.assertEqual(status, 200)
    43	        self.assertEqual(route['status'], 'online')
    44	        self.assertEqual(route['clientID'], 'acme-3f2a9c1b-link')
    45	        # Read the route through the relay while this client is online, so its routes row
    46	        # is held (not pending) before the client stops: an offline record does not empty
    47	        # a pending row within PENDING_S (R2.1), it reads held (R1.1).
    48	        status, route = self.stack.api('GET', '/api/v1/links/acme/route', key=self.binding['key'])
    49	        self.assertEqual(status, 200)
    50	        self.assertEqual(route['state'], 'held')
    51	        first.stop()
    52	        self.assertTrue(_wait(lambda: self.stack.dash(path)[1].get('status') == 'offline', 5))
    53	        status, route = self.stack.dash(path)
    54	        self.assertEqual(status, 200)
    55	        self.assertEqual(route['status'], 'offline')
    56	        self.assertEqual(route['clientID'], 'acme-3f2a9c1b-link')
    57	
    58	        legacy = self.stack.client('acme', self.binding['key'])
    59	        self.assertTrue(legacy.started('acme'), legacy.log())
    60	        status, route = self.stack.dash(path)
    61	        self.assertEqual(status, 200)
    62	        self.assertEqual(route['status'], 'online')
    63	        self.assertRegex(route['clientID'], r'^[0-9a-f]{16,}$')
    64	
    65	        connection = http.client.HTTPConnection('127.0.0.1', self.stack.dash_port, timeout=2)
    66	        try:
    67	            connection.request('GET', '/healthz')
    68	            response = connection.getresponse()
    69	            response.read()
    70	            self.assertEqual(response.status, 200)
    71	        finally:
    72	            connection.close()
