   623	def offer_reason(name: str, kind: str, content: dict, metas: dict) -> str | None:
   624	    """R5.1: a visitor offers nothing; a peer offers only its two stcp services; the rest
   625	    is the http proxy of today (Task 2). stcp services get no route row and no generation."""
   626	    if kind == 'visitor':
   627	        return 'visitors may not offer services'
   628	    client_id = metas.get('client')
   629	    client_id = client_id if isinstance(client_id, str) else ''
   630	    reason = client_id_reason(name, kind, client_id, client_id)
   631	    if reason is not None:
   632	        return reason
   633	    if client_id:
   634	        match = CLIENT.match(client_id)
   635	        if match is not None and match.group('kind') == 'peer':
   636	            return peer_proxy_reason(name, match.group('m8'), content)
   637	    return proxy_check(name, content)
