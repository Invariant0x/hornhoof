   756	def visitor_hash_matches(name: str, visitor: str) -> bool:
   757	    """R6.2: the visitor key matches only while it is the one stored, compared in constant time."""
   758	    row = db().execute('SELECT key_hash FROM visitor_keys WHERE name = ?', (name,)).fetchone()
