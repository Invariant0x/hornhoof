import io
from pathlib import Path
import unittest
from unittest.mock import patch
from relay.test import harness
from relay.test.test_peers import PeerTests

relay_path=str(Path('relay/relay.py').resolve())
original_init=harness._Process.__init__
probe_source='''import importlib.util
import sys
spec=importlib.util.spec_from_file_location('review_relay',sys.argv[1])
module=importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
original=module.peer_proxy_reason
def fault(name,m8,content):
    reason=original(name,m8,content)
    if reason is None:
        module.write(\"INSERT INTO routes (name,generation,client,run_id,type,state,since) VALUES (?,99,?,'fault','http','pending',?) ON CONFLICT(name) DO UPDATE SET generation=99\",(name, name+'-'+m8+'-peer',module.now()))
    return reason
module.peer_proxy_reason=fault
module.main()
'''
def process_init(self,command,*args,**kwargs):
    if command[-1]==relay_path:
        command=[command[0],'-u','-c',probe_source,relay_path]
    return original_init(self,command,*args,**kwargs)
with patch.object(harness._Process,'__init__',process_init):
    result=unittest.TextTestRunner(stream=io.StringIO(),verbosity=0).run(PeerTests('test_r5_1_peer_services'))
print('Peer services test passes while accepted peer offers wrongly write a route at generation 99:',result.wasSuccessful())
