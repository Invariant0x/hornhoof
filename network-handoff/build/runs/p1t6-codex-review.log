   812	def plugin(op: str, content: dict) -> dict:
   813	    """One plugin call gets one 1 s budget; a spent budget refuses the op, fail closed (Review Focus 3)."""
   814	    call_state.end = time.monotonic() + PLUGIN_CALL_S
   815	    try:
   816	        return plugin_decide(op, content)
   817	    except WriteBusy:
   818	        return {'reject': True, 'reject_reason': 'relay error: busy'}
   819	    finally:
   820	        call_state.end = None
   821	
   822	
   823	def call_metas(op: str, content: dict) -> dict:
   824	    """The login metas of a plugin call: top level for Login, under user otherwise."""
   825	    if op == 'Login':
   826	        metas = content.get('metas')
   827	    else:
   828	        metas = (content.get('user') or {}).get('metas')
   829	    return metas if isinstance(metas, dict) else {}
   830	
   831	
   832	def plugin_decide(op: str, content: dict) -> dict:
   833	    """Authenticate the session, then the op's own rule; a refusal rejects, else the call passes."""
   834	    metas = call_metas(op, content)
   835	    name, kind, reason = authenticate(metas)
   836	    if reason is None and op == 'Login':
   837	        reason = login_reason(name, kind, content, metas)
   838	    elif reason is None and op == 'NewProxy':
   839	        reason = offer_reason(name, kind, content, metas)
   840	    if reason is not None:
   841	        return {'reject': True, 'reject_reason': reason}
   842	    touch(name)
   843	    return {'reject': False, 'unchange': True}
