   688	class Window:
   689	    """Counts events per key in a sliding window, in memory."""
   690	
   691	    def __init__(self, limit: int, seconds: int):
   692	        self.limit, self.seconds, self.hits, self.lock = limit, seconds, {}, threading.Lock()
   693	
   694	    def allow(self, key: str) -> int:
   695	        """0 if allowed (and counted), else seconds to wait."""
   696	        t = time.time()
   697	        with self.lock:
   698	            if len(self.hits) > 50000:
   699	                self.hits = {k: v for k, v in self.hits.items() if v and v[-1] > t - self.seconds}
   700	            recent = [x for x in self.hits.get(key, []) if x > t - self.seconds]
   701	            if len(recent) >= self.limit:
   702	                self.hits[key] = recent
   703	                return int(recent[0] + self.seconds - t) + 1
   704	            recent.append(t)
   705	            self.hits[key] = recent
   706	            return 0
   707	
