   230	class FrpsUnknown(Exception):
   231	    """frps's dashboard gave no trustworthy answer about a route: read unknown, never empty."""
   232	
   233	
   234	def _dash_get(path: str, cap: float = 0.5) -> tuple[int, bytes]:
   235	    """One dashboard read with a cap-second timeout; less when the plugin call's budget is nearly spent.
   236	
   237	    The watcher's own probes pass cap=1. Any error, timeout or a spent budget is FrpsUnknown.
   238	    """
   239	    parsed = urlsplit(RELAY_FRPS_API)
   240	    host = parsed.hostname or '127.0.0.1'
   241	    port = parsed.port or (443 if parsed.scheme == 'https' else 80)
   242	    kind = http.client.HTTPSConnection if parsed.scheme == 'https' else http.client.HTTPConnection
   243	    left = call_deadline()
   244	    if left is not None and left <= 0:
   245	        raise FrpsUnknown(f'{path}: plugin call budget spent')
   246	    connection = kind(host, port, timeout=cap if left is None else min(cap, left))
   247	    try:
   248	        token = base64.b64encode(f'{FRPS_USER}:{FRPS_PASSWORD}'.encode()).decode()
   249	        connection.request('GET', path, headers={'Authorization': f'Basic {token}'})
   250	        response = connection.getresponse()
   251	        return response.status, response.read()
   252	    except (OSError, http.client.HTTPException) as e:
   253	        raise FrpsUnknown(f'{path}: {type(e).__name__}') from None
   254	    finally:
   255	        connection.close()
   256	
   257	
   258	def dash_answer(name: str, proxy_type: str) -> tuple[str, str] | None:
   259	    """One proxy type's dashboard record: (status, clientID), None on 404, FrpsUnknown otherwise.
   260	
   261	    A record is trusted only with a status of online or offline and a non-empty clientID:
   262	    a missing field reads as unknown, never as empty.
   263	    """
   264	    status, body = _dash_get(f'/api/proxy/{proxy_type}/{name}')
   265	    if status == 404:
   266	        return None
   267	    if status != 200:
   268	        raise FrpsUnknown(f'dashboard answered {status} for {proxy_type} {name}')
   269	    try:
   270	        answer = json.loads(body)
   271	        route_status = answer['status']
   272	        client_id = answer['clientID']
   273	    except (ValueError, KeyError, TypeError):
   274	        raise FrpsUnknown(f'dashboard body for {proxy_type} {name} has no route record') from None
   275	    if route_status not in ('online', 'offline') or not isinstance(client_id, str) or not client_id:
   276	        raise FrpsUnknown(f'dashboard body for {proxy_type} {name} is not a route record')
   277	    return route_status, client_id
   278	
   279	
   280	def dash_client_records(body: bytes) -> list[dict]:
   281	    """The parsed clients answer: a list of records with a clientID string and a boolean
   282	    online. Anything else is FrpsUnknown, never an empty guess."""
   283	    try:
   284	        answer = json.loads(body)
   285	    except ValueError:
   286	        raise FrpsUnknown('dashboard clients answer is not JSON') from None
   287	    if not isinstance(answer, list):
   288	        raise FrpsUnknown('dashboard clients answer is not a list')
   289	    for entry in answer:
   290	        if (not isinstance(entry, dict) or not isinstance(entry.get('clientID'), str)
   291	                or type(entry.get('online')) is not bool):
   292	            raise FrpsUnknown('dashboard clients answer has no client record')
   293	    return answer
   294	
   295	
   296	def dash_clients(run_id: str) -> list[dict]:
   297	    """The /api/clients?runId= answer on the plugin call's budget; a dashboard error is
   298	    FrpsUnknown, never an empty guess."""
   299	    status, body = _dash_get(f'/api/clients?runId={quote(run_id, safe="")}')
   300	    if status != 200:
   301	        raise FrpsUnknown(f'dashboard answered {status} for clients runId {run_id}')
   302	    return dash_client_records(body)
   303	
   304	
   305	def run_id_conflict(run_id: str, client_id: str) -> str | None:
   306	    """R1.3: a live session with this run id is taken over only by its own client id.
   307	
   308	    A dashboard error refuses the login: the relay cannot tell whose the run id is.
   309	    """
   310	    try:
   311	        clients = dash_clients(run_id)
   312	    except FrpsUnknown:
   313	        return 'relay error: frps does not answer'
   314	    for entry in clients:
   315	        if entry['online'] and entry['clientID'] != client_id:
   316	            return 'this run id belongs to another client'
   317	    return None
