   320	def frps_route(name: str) -> tuple[str, str | None, str | None]:
   321	    """frps's own view of a name's route: ('online'|'offline', clientID, type), or ('absent', None, None).
   322	
   323	    Both proxy types are read: a name holds one route of either type, and two records is unknown.
   324	    """
   325	    http = dash_answer(name, 'http')
   326	    https = dash_answer(name, 'https')
   327	    if http is not None and https is not None:
   328	        raise FrpsUnknown(f'dashboard shows both http and https routes for {name}')
   329	    for proxy_type, answer in (('http', http), ('https', https)):
   330	        if answer is not None:
   331	            return answer[0], answer[1], proxy_type
   332	    return 'absent', None, None
