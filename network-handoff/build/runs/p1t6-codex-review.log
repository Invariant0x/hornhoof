   594	def client_id_reason(name: str, kind: str, client_id: str, meta_client) -> str | None:
   595	    """R1.3, R5.1: a client id names this link and matches its session's key kind.
   596	
   597	    An empty client id is a today's tunnel: only a link-key session without metas.client.
   598	    """
   599	    if not client_id:
   600	        if kind == 'link' and not meta_client:
   601	            return None
   602	        return f'this client id is not for {name}'
   603	    match = CLIENT.match(client_id)
   604	    if (match is None or match.group('link') != name or meta_client != client_id
   605	            or (match.group('kind') == 'visit') != (kind == 'visitor')):
   606	        return f'this client id is not for {name}'
   607	    return None
