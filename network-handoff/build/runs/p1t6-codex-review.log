   610	def login_reason(name: str, kind: str, content: dict, metas: dict) -> str | None:
   611	    """R1.3: the client id fits the session; a live run id is this client's own."""
   612	    client_id = content.get('client_id')
   613	    client_id = client_id if isinstance(client_id, str) else ''
   614	    reason = client_id_reason(name, kind, client_id, metas.get('client'))
   615	    if reason is not None:
   616	        return reason
   617	    run_id = content.get('run_id')
   618	    if client_id and isinstance(run_id, str) and run_id:
   619	        return run_id_conflict(run_id, client_id)
   620	    return None
