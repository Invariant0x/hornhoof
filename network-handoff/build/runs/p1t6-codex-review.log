   439	    def _refuse_in_worker(self, hold_s: float) -> tuple[list, float]:
   440	        """Run one real NewProxy plugin call on a worker thread while this thread holds the lock
   441	        for hold_s seconds; return (results, seconds from the call's start to its answer)."""
   442	        lock = self.relay.route_lock('acme')
   443	        lock.acquire()
   444	        entered = threading.Event()
   445	        result = []
   446	
   447	        def run():
   448	            entered.set()
   449	            result.append(self.relay.plugin('NewProxy', self._newproxy_content('acme', 'k', 'acme-a1b2c3d4-link')))
   450	
   451	        worker = threading.Thread(target=run)
   452	        worker.start()
   453	        self.assertTrue(entered.wait(timeout=5))
   454	        started = time.monotonic()
   455	        timer = threading.Timer(hold_s, lock.release)
   456	        timer.start()
   457	        try:
   458	            worker.join(timeout=8)
   459	            elapsed = time.monotonic() - started
   460	        finally:
   461	            timer.cancel()
   462	            _release_lock(lock)
   463	        self.assertFalse(worker.is_alive(), 'plugin call outlived its 1 s budget')
   464	        return result, elapsed
