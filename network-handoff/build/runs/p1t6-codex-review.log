   772	def key_kind(name: str, metas: dict, row: tuple) -> str | None:
   773	    """'link' when the link key matches, 'visitor' when only the visitor key does."""
   774	    key = metas.get('key')
   775	    if isinstance(key, str) and key and hmac.compare_digest(row[0], key_hash(key)):
   776	        return 'link'
   777	    visitor = metas.get('visitor')
   778	    if key is None and isinstance(visitor, str) and visitor and visitor_hash_matches(name, visitor):
   779	        return 'visitor'
   780	    return None
