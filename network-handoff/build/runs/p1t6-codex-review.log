    49	RELAY_FRPS_API = os.environ.get('RELAY_FRPS_API', 'http://127.0.0.1:7500')
    50	FRPS_USER = os.environ.get('RELAY_FRPS_USER', 'admin')
    51	FRPS_PASSWORD = os.environ.get('RELAY_FRPS_PASSWORD', '')
    52	# The watcher probes these to know whether frps takes logins (R4.1); systemd's ExecStartPost
    53	# rewrites the started file every time frps starts.
    54	RELAY_FRPS_BIND = os.environ.get('RELAY_FRPS_BIND', '127.0.0.1:7000')
    55	RELAY_FRPS_STARTED = os.environ.get('RELAY_FRPS_STARTED', '/run/frps/started')
    56	# A registration frps has not shown yet reads as held for this long (R1.1, R2.1).
    57	PENDING_S = 10
    58	# R3.1 measured with frp 0.71.1: network 20.16/20.46 s, today 20.26 s (2026-11-03).
    59	EVICTION_BOUND_S = 30
    60	# One budget per plugin call: a spent budget refuses the op, fail closed (Review Focus 3).
    61	PLUGIN_CALL_S = 1.0
