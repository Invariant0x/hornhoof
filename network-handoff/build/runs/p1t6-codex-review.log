   296	def dash_clients(run_id: str) -> list[dict]:
   297	    """The /api/clients?runId= answer on the plugin call's budget; a dashboard error is
   298	    FrpsUnknown, never an empty guess."""
   299	    status, body = _dash_get(f'/api/clients?runId={quote(run_id, safe="")}')
   300	    if status != 200:
   301	        raise FrpsUnknown(f'dashboard answered {status} for clients runId {run_id}')
   302	    return dash_client_records(body)
