   140	def reserved_names() -> frozenset:
   141	    """The names on the Caddyfile's @reserved line, reread when the file changes."""
   142	    try:
   143	        mtime = os.stat(CADDYFILE).st_mtime
   144	    except OSError:
   145	        return _reserved['names']
   146	    if mtime != _reserved['mtime']:
   147	        names = set()
   148	        with open(CADDYFILE) as f:
   149	            for line in f:
   150	                parts = line.split()
   151	                if parts[:2] == ['@reserved', 'host']:
   152	                    names.update(h[: -len('.' + DOMAIN)] for h in parts[2:] if h.endswith('.' + DOMAIN))
   153	        _reserved.update(mtime=mtime, names=frozenset(names))
   154	    return _reserved['names']
