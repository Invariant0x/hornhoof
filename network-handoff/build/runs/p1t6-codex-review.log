    90	def db() -> sqlite3.Connection:
    91	    conn = getattr(_local, 'conn', None)
    92	    if conn is None:
    93	        conn = sqlite3.connect(DB_PATH, timeout=10, isolation_level=None)
    94	        conn.execute('PRAGMA journal_mode=WAL')
    95	        conn.execute('PRAGMA synchronous=FULL')
    96	        conn.execute('PRAGMA busy_timeout=10000')
    97	        _local.conn = conn
    98	    return conn
