    19	def start_write_private(dest: Path, mode: str, group: str | None = None) -> subprocess.Popen:
    20	    """Start write_private on a pipe the test controls; the caller writes the content."""
    21	    command = ['sh', '-c', '. "$1"; shift; write_private "$@"', 'write_private',
    22	               str(HELPER), str(dest), mode] + ([group] if group else [])
    23	    return subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
    24	                            stderr=subprocess.PIPE, text=True)
