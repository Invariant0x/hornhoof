    63	LABEL = re.compile(r'^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$')
    64	RANDOM_ALPHABET = 'abcdefghijklmnopqrstuvwxyz0123456789'
    65	# A network client's id: <link>-<machine8>-<kind> (R1.3, R1.4, R5.1).
    66	CLIENT = re.compile(r'^(?P<link>[a-z0-9-]{1,63})-(?P<m8>[0-9a-f]{8})-(?P<kind>link|peer|visit)$')
