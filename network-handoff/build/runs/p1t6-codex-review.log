   335	def check_route_holder(name: str, row, status: str, client_id: str | None, proxy_type: str | None) -> None:
   336	    """An online route must match the relay's own record, else the answer is unknown, never empty (R2.3).
   337	
   338	    A missing row means the record was lost while frps holds the route: unknown too.
   339	    """
   340	    if status != 'online':
   341	        return
   342	    matches = (row is not None and proxy_type == row[3]
   343	               and client_id == (row[2] if row[1] == 'legacy' else row[1]))
   344	    if matches:
   345	        return
   346	    log_line(f'route of {name} is online outside the relay record')
   347	    raise FrpsUnknown(f'frps route of {name} does not match the relay record')
