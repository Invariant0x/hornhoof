   783	def authenticate(metas: dict) -> tuple[str | None, str | None, str | None]:
   784	    """(name, kind, refusal): kind is 'link' with the link key, 'visitor' with the visitor key.
   785	
   786	    The binding check is as before; a login with no metas.key may match the stored
   787	    visitor key instead (R6.2).
   788	    """
   789	    name = metas.get('name')
   790	    if not isinstance(name, str) or not name:
   791	        return None, None, 'this tunnel has no Hornhoof relay binding (metadatas.name and metadatas.key)'
   792	    state = binding_state(name)
   793	    if isinstance(state, str):
   794	        return name, None, state
   795	    kind = key_kind(name, metas, state)
   796	    if kind is None:
   797	        return name, None, f'no binding {name} with this key'
   798	    return name, kind, None
