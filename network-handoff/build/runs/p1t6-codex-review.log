   169	# relayStarted is the latest of: this process's start, the watcher's first frps answer after
   170	# a failure or after start, and the integer in RELAY_FRPS_STARTED (R2.2, R4.1).
   171	STARTED = now()
   172	
   173	# frps watcher state: frps_ok_at is the epoch of the last good probe, frps_back_at the epoch
   174	# of the first good probe after a failure or after start (0 until then).
   175	_frps = {'ok_at': 0.0, 'back_at': 0}
   176	WATCH_INTERVAL_S = 0.5
   177	# Health answers 200 only while the watcher's last good probe is younger than this.
   178	HEALTH_MAX_AGE_S = 2.0
   179	
   180	
   181	def frps_answers() -> bool:
   182	    """True when frps's bind port accepts a connection and its dashboard answers /healthz."""
   183	    host, _, port_text = RELAY_FRPS_BIND.rpartition(':')
   184	    try:
   185	        connection = socket.create_connection((host, int(port_text)), timeout=1)
   186	        connection.close()
   187	    except OSError:
   188	        return False
   189	    try:
   190	        status, _ = _dash_get('/healthz', cap=1.0)
   191	    except FrpsUnknown:
   192	        return False
   193	    return status == 200
   194	
   195	
   196	def watch_frps() -> None:
   197	    """Probe frps forever; keep the last good answer and the recovery after a failure."""
   198	    was_ok = False
   199	    while True:
   200	        if frps_answers():
   201	            t = time.time()
   202	            if not was_ok:
   203	                _frps['back_at'] = t
   204	            _frps['ok_at'] = t
   205	            was_ok = True
   206	        else:
   207	            was_ok = False
   208	        time.sleep(WATCH_INTERVAL_S)
   209	
   210	
   211	def frps_ok() -> bool:
   212	    """R4.1: true while the watcher's last frps answer is under HEALTH_MAX_AGE_S old."""
   213	    return time.time() - _frps['ok_at'] < HEALTH_MAX_AGE_S
   214	
