   762	def binding_state(name: str):
   763	    """The bindings row for name, or the refusal: no binding, or blocked."""
   764	    row = db().execute('SELECT key_hash, banned_at FROM bindings WHERE name = ?', (name,)).fetchone()
   765	    if row is None:
   766	        return f'no binding {name} with this key'
   767	    if row[1]:
   768	        return f'{name}.{DOMAIN} is blocked'
   769	    return row
