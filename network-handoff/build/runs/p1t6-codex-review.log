   854	    def handle_one_request(self):
   855	        """A busy store answers 503 instead of dropping the connection mid-request."""
   856	        try:
   857	            super().handle_one_request()
   858	        except WriteBusy:
   859	            self.error(503, 'busy', 'The relay store is busy, try again.', {'Retry-After': '1'})
