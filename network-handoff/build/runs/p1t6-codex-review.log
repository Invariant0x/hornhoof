    74	    def test_fact_client_id_is_unique(self):
    75	        client_id = 'acme-3f2a9c1b-peer'
    76	        first = self.stack.client(
    77	            'acme', self.binding['key'], settings='network', client=client_id, proxies='',
    78	        )
    79	        self.assertTrue(_wait(lambda: 'login to server success' in first.log(), 15), first.log())
    80	        first.pause()
    81	        second = self.stack.client(
    82	            'acme', self.binding['key'], settings='network', client=client_id, proxies='',
    83	        )
    84	        self.assertTrue(_wait(lambda: 'is already online' in second.log(), 15), second.log())
    85	        self.assertNotIn('login to server success', second.log())
    86	        # Today's server has its own keepalive defaults. Task 3 tightens the eviction bound.
    87	        self.assertTrue(
    88	            _wait(lambda: 'client exit success' in self.stack.frps.log(), 120),
    89	            self.stack.frps.log(),
    90	        )
    91	        dropped = time.monotonic()
    92	        self.assertTrue(_wait(lambda: 'login to server success' in second.log(), 60), second.log())
    93	        delay = time.monotonic() - dropped
    94	        print(f'client-id retry after silent client dropped: {delay:.2f} s', flush=True)
    95	        self.assertLessEqual(delay, 60)
