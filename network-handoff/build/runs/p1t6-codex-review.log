   846	class Handler(BaseHTTPRequestHandler):
   847	    server_version = 'hornhoof-relay'
   848	    sys_version = ''
   849	    protocol_version = 'HTTP/1.1'
   850	
   851	    def log_message(self, fmt, *args):
   852	        pass
