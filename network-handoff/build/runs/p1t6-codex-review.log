   216	def frps_started_file() -> int:
   217	    """The integer systemd's ExecStartPost wrote when frps last started, 0 when unreadable."""
   218	    try:
   219	        with open(RELAY_FRPS_STARTED) as f:
   220	            return int(f.read().strip())
   221	    except (OSError, ValueError):
   222	        return 0
   223	
   224	
   225	def relay_started() -> int:
   226	    """The latest of the relay's start, the frps recovery and frps's own start."""
   227	    return int(max(STARTED, _frps['back_at'], frps_started_file()))
