   350	class WriteBusy(Exception):
   351	    """A SQLite write could not take the lock within its budget: refuse the op, never guess."""
   352	
   353	
   354	def write(sql: str, args: tuple) -> None:
   355	    """The one SQLite write of the plugin and the API.
   356	
   357	    SQLite itself retries database is locked for the write's budget (0.8 s, or the plugin
   358	    call's time left, whichever is less); past the budget the write raises WriteBusy and a
   359	    plugin call refuses with 'relay error: busy' (Review Focus 3).
   360	    """
   361	    conn = db()
   362	    left = call_deadline()
   363	    if left is not None and left <= 0:
   364	        raise WriteBusy('plugin call budget spent')
   365	    budget = 0.8 if left is None else min(0.8, left)
   366	    conn.execute(f'PRAGMA busy_timeout = {max(0, int(budget * 1000))}')
   367	    try:
   368	        conn.execute(sql, args)
   369	    except sqlite3.OperationalError as e:
   370	        if 'locked' in str(e):
   371	            raise WriteBusy(f'database is locked for {budget:.2f} s') from None
   372	        raise
   373	    finally:
   374	        conn.execute('PRAGMA busy_timeout = 10000')
   375	
   376	
   377	def straighten_route(name: str, row, status: str, t: int) -> None:
   378	    """Move the row to what frps shows; each UPDATE is guarded by the generation as read, so a row
   379	    rewritten since we read frps keeps its newer registration. The per-name lock is held.
   380	
   381	    A pending row younger than PENDING_S is a registration frps has not shown yet: it reads held
   382	    even when frps still shows the previous registration's offline record, because frps keeps that
   383	    record until the new one shows. Only an online record turns it held, age or absence empties it.
   384	    """
   385	    state, generation = row[4], row[0]
   386	    if status == 'online':
   387	        write("UPDATE routes SET state = 'held' WHERE name = ? AND generation = ? "
   388	              "AND state IN ('pending', 'empty')", (name, generation))
   389	    elif state == 'held':
   390	        write("UPDATE routes SET state = 'empty', since = ? WHERE name = ? AND generation = ? "
   391	              "AND state = 'held'", (t, name, generation))
   392	    elif state == 'pending' and t - row[5] > PENDING_S:
   393	        write("UPDATE routes SET state = 'empty', since = ? WHERE name = ? AND generation = ? "
   394	              "AND state = 'pending'", (t, name, generation))
   395	
   396	
   397	def route_body(name: str, row) -> dict:
   398	    """The R2.1 answer from a routes row; a name with no row is empty at generation 0."""
   399	    if row is None:
   400	        binding = db().execute('SELECT created_at FROM bindings WHERE name = ?', (name,)).fetchone()
   401	        since = binding[0] if binding else None
   402	        state, client, generation = 'empty', None, 0
   403	    else:
   404	        since = row[5]
   405	        state = 'empty' if row[4] == 'empty' else 'held'
   406	        client = row[1] if state == 'held' else None
   407	        generation = row[0]
   408	    return {'state': state, 'client': client, 'since': since, 'generation': generation,
   409	            'relayStarted': relay_started(), 'evictionBound': EVICTION_BOUND_S, 'sync': sync_of(name)}
   410	
   411	
   412	def sync_of(name: str) -> dict:
   413	    """The last committed sync record, or the R2.4 default when no holder has set one."""
   414	    row = db().execute('SELECT state, copy, epoch, generation, at FROM sync WHERE name = ?',
   415	                       (name,)).fetchone()
   416	    if row is None:
   417	        return {'state': 'off', 'copy': None, 'epoch': 0, 'generation': 0, 'at': None}
   418	    return dict(zip(('state', 'copy', 'epoch', 'generation', 'at'), row))
   419	
   420	
   421	def sync_text(value: object) -> bool:
   422	    return isinstance(value, str) and 1 <= len(value) <= 100
   423	
   424	
   425	def sync_integer(value: object) -> bool:
   426	    """A positive SQLite INTEGER, excluding JSON booleans."""
   427	    return type(value) is int and 1 <= value <= 2 ** 63 - 1
   428	
   429	
   430	def sync_copy(state: str, copy: object) -> bool:
   431	    return sync_text(copy) or (state == 'off' and copy is None)
   432	
   433	
   434	def valid_sync_body(body: object) -> bool:
   435	    """Validate the complete R2.4 body, including exact fields and JSON integer types."""
   436	    if not isinstance(body, dict) or set(body) != {'client', 'generation', 'state', 'copy', 'epoch'}:
   437	        return False
   438	    return all((sync_text(body['client']), sync_integer(body['generation']),
   439	                body['state'] in ('on', 'off'), sync_copy(body['state'], body['copy']),
   440	                sync_integer(body['epoch'])))
   441	
   442	
   443	def sync_holder(name: str, body: dict) -> bool:
   444	    """An online frps route must name this registration; a pending row cannot set sync."""
   445	    route = locked_route_of(name)
   446	    row = db().execute('SELECT state FROM routes WHERE name = ?', (name,)).fetchone()
   447	    return (row == ('held',) and route['client'] == body['client']
   448	            and route['generation'] == body['generation'])
   449	
   450	
   451	def store_sync(name: str, body: dict) -> bool:
   452	    """Commit only while the checked registration still holds; never overwrite a newer epoch."""
   453	    write('INSERT INTO sync (name, state, copy, epoch, generation, at) '
   454	          'SELECT name, ?, ?, ?, generation, ? FROM routes '
   455	          "WHERE name = ? AND generation = ? AND client = ? AND state = 'held' "
   456	          'ON CONFLICT(name) DO UPDATE SET state = excluded.state, copy = excluded.copy, '
   457	          'epoch = excluded.epoch, generation = excluded.generation, at = excluded.at '
   458	          'WHERE excluded.epoch > sync.epoch',
   459	          (body['state'], body['copy'], body['epoch'], now(), name, body['generation'], body['client']))
   460	    return db().execute('SELECT changes()').fetchone()[0] == 1
   461	
   462	
   463	def set_sync(name: str, body: dict) -> tuple[str | None, dict | None]:
   464	    """Serialize the frps holder check and committed write against the name's registrations."""
   465	    with route_lock(name):
   466	        if not sync_holder(name, body):
   467	            return 'not_holder', None
   468	        if body['epoch'] <= sync_of(name)['epoch']:
   469	            return 'stale_epoch', None
   470	        if not store_sync(name, body):
   471	            return 'not_holder', None
   472	        return None, sync_of(name)
   473	
   474	
   475	def locked_route_of(name: str) -> dict:
   476	    """The R2.1 body with the per-name lock already held: the row straightened against frps."""
   477	    status, client_id, proxy_type = frps_route(name)
   478	    row = db().execute('SELECT generation, client, run_id, type, state, since FROM routes WHERE name = ?',
   479	                       (name,)).fetchone()
   480	    if row is not None:
   481	        check_route_holder(name, row, status, client_id, proxy_type)
   482	        try:
   483	            straighten_route(name, row, status, now())
   484	        except sqlite3.Error as e:
   485	            raise FrpsUnknown(f'route store is not writable: {type(e).__name__}') from None
   486	        row = db().execute('SELECT generation, client, run_id, type, state, since FROM routes WHERE name = ?',
   487	                           (name,)).fetchone()
   488	    else:
   489	        check_route_holder(name, None, status, client_id, proxy_type)
   490	    return route_body(name, row)
   491	
   492	
   493	def route_of(name: str) -> dict:
   494	    """The R2.1 body for a name: the routes row straightened against what frps shows right now.
   495	
   496	    The per-name lock serializes every read-and-straighten against registrations.
   497	    """
   498	    with route_lock(name):
   499	        return locked_route_of(name)
   500	
   501	
   502	_route_locks_guard = threading.Lock()
   503	_route_locks: dict[str, threading.Lock] = {}
   504	
   505	
   506	def route_lock(name: str) -> threading.Lock:
   507	    with _route_locks_guard:
   508	        lock = _route_locks.get(name)
   509	        if lock is None:
   510	            lock = threading.Lock()
   511	            _route_locks[name] = lock
   512	    return lock
   513	
   514	
   515	def hold_route_lock(name: str) -> bool:
   516	    """Take the per-name lock within the plugin call's remaining budget; False when the budget ran out."""
   517	    lock = route_lock(name)
   518	    left = call_deadline()
   519	    if left is None:
   520	        lock.acquire()
   521	        return True
   522	    return left > 0 and lock.acquire(timeout=left)
   523	
   524	
   525	def register_route(name: str, content: dict) -> str | None:
   526	    """Record a registration the plugin let through; a reason when the name cannot be taken (R1.1)."""
   527	    user = content.get('user') or {}
   528	    if not hold_route_lock(name):
   529	        return 'relay error: frps does not answer'
   530	    try:
   531	        return register_locked(name, content, user)
   532	    finally:
   533	        route_lock(name).release()
   534	
   535	
   536	def register_locked(name: str, content: dict, user: dict) -> str | None:
   537	    """The locked half of register_route: refuse a held name, else record the registration."""
   538	    try:
   539	        held = locked_route_of(name)['state'] == 'held'
   540	    except FrpsUnknown:
   541	        return 'relay error: frps does not answer'
   542	    except WriteBusy:
   543	        return 'relay error: busy'
   544	    if held:
   545	        return f'router config conflict: {name} is held'
   546	    return upsert_route(name, content, user)
   547	
   548	
   549	def upsert_route(name: str, content: dict, user: dict) -> str | None:
   550	    """Write the pending row for a let-through registration; a refusal when the write cannot land."""
   551	    row = db().execute('SELECT generation FROM routes WHERE name = ?', (name,)).fetchone()
   552	    generation = (row[0] if row else 0) + 1
   553	    metas = user.get('metas') or {}
   554	    try:
   555	        write(
   556	            'INSERT INTO routes (name, generation, client, run_id, type, state, since) VALUES (?, ?, ?, ?, ?, ?, ?) '
   557	            'ON CONFLICT(name) DO UPDATE SET generation = excluded.generation, client = excluded.client, '
   558	            'run_id = excluded.run_id, type = excluded.type, state = excluded.state, since = excluded.since',
   559	            (name, generation, metas.get('client') or 'legacy', user.get('run_id') or '',
   560	             content.get('proxy_type') or 'http', 'pending', now()))
   561	    except WriteBusy:
   562	        return 'relay error: busy'
   563	    except sqlite3.Error:
   564	        return 'relay error: frps does not answer'
   565	    return None
   566	
   567	
   568	def shared_route_fields(content: dict) -> str | None:
   569	    """R1.2: a name is one company's one route, never shared or split across locations or users."""
   570	    for field in ('locations', 'route_by_http_user', 'group'):
   571	        if content.get(field):
   572	            return f'{field} is not allowed'
   573	    return None
   574	
   575	
   576	def proxy_check(name: str, content: dict) -> str | None:
   577	    """Today's NewProxy checks, then whether this registration may hold the name; None lets it through."""
   578	    if (content.get('user') or {}).get('user'):
   579	        return 'set no user in the tunnel config'
   580	    if content.get('proxy_type') != 'http':
   581	        return 'only http proxies are allowed'
   582	    if content.get('proxy_name') != name:
   583	        return f'the proxy must be named {name}'
   584	    if content.get('subdomain') != name:
   585	        return f'this key serves only {name}.{DOMAIN}'
   586	    if content.get('custom_domains'):
   587	        return 'custom domains are not allowed'
   588	    reason = shared_route_fields(content)
   589	    if reason is not None:
   590	        return reason

