   280	def dash_client_records(body: bytes) -> list[dict]:
   281	    """The parsed clients answer: a list of records with a clientID string and a boolean
   282	    online. Anything else is FrpsUnknown, never an empty guess."""
   283	    try:
   284	        answer = json.loads(body)
   285	    except ValueError:
   286	        raise FrpsUnknown('dashboard clients answer is not JSON') from None
   287	    if not isinstance(answer, list):
   288	        raise FrpsUnknown('dashboard clients answer is not a list')
   289	    for entry in answer:
   290	        if (not isinstance(entry, dict) or not isinstance(entry.get('clientID'), str)
   291	                or type(entry.get('online')) is not bool):
   292	            raise FrpsUnknown('dashboard clients answer has no client record')
   293	    return answer
