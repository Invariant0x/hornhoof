    26	
    27	def finish(process: subprocess.Popen) -> tuple[int, str, str]:
    28	    out, err = process.stdout.read(), process.stderr.read()
    29	    process.stdout.close()
    30	    process.stderr.close()
    31	    return process.wait(timeout=5), out.strip(), err
