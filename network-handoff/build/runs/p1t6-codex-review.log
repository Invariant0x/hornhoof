   640	def peer_proxy_reason(name: str, m8: str, content: dict) -> str | None:
   641	    """R5.1: a peer offers only <name>-<m8>-data and <name>-<m8>-app, stcp with a real
   642	    secret and open to every visitor of the service."""
   643	    proxy_name = content.get('proxy_name')
   644	    label = proxy_name if isinstance(proxy_name, str) else ''
   645	    allowed = {f'{name}-{m8}-{service}' for service in PEER_SERVICES}
   646	    sk = content.get('sk')
   647	    allow_users = content.get('allow_users')
   648	    if (content.get('proxy_type') != 'stcp' or label not in allowed
   649	            or not isinstance(sk, str) or len(sk) < 32
   650	            or allow_users not in (None, [], ['*'])):
   651	        return f'this client may not offer {label}'
   652	    return None
