   157	def check_name(name: str):
   158	    """None when the name can be bound, else 'invalid', 'reserved' or 'taken'. A banned name counts as reserved."""
   159	    if not LABEL.match(name) or name[2:4] == '--':
   160	        return 'invalid'
   161	    if name in reserved_names():
   162	        return 'reserved'
   163	    row = db().execute('SELECT banned_at FROM bindings WHERE name = ?', (name,)).fetchone()
   164	    if row is None:
   165	        return None
   166	    return 'reserved' if row[0] else 'taken'
