   714	def service_offer_reason(name: str, client_id: str, content: dict) -> str | None:
   715	    """A peer client offers only its two stcp services; every other session offers
   716	    the http proxy of today (Task 2)."""
   717	    match = CLIENT.fullmatch(client_id) if client_id else None
   718	    if match is not None and match.group('kind') == 'peer':
