   617	def proxy_check(name: str, content: dict) -> str | None:
   618	    """Today's NewProxy checks, then whether this registration may hold the name; None lets it through."""
   619	    if (content.get('user') or {}).get('user'):
   620	        return 'set no user in the tunnel config'
   621	    if content.get('proxy_type') != 'http':
   622	        return 'only http proxies are allowed'
   623	    if content.get('proxy_name') != name:
   624	        return f'the proxy must be named {name}'
   625	    if content.get('subdomain') != name:
   626	        return f'this key serves only {name}.{DOMAIN}'
   627	    if content.get('custom_domains'):
   628	        return 'custom domains are not allowed'
   629	    reason = shared_route_fields(content)
   630	    if reason is not None:
   631	        return reason
   632	    return register_route(name, content)
