  1151	            result = plugin(op, content)
  1152	        except Exception as e:  # never let a bad plugin call through
  1153	            result = {'reject': True, 'reject_reason': f'relay error: {type(e).__name__}'}
  1154	        trace_plugin(op, content, result, started)
  1155	        return self.send_json(200, result)
