  1124	    def visitor_key_answer(self, name: str) -> None:
  1125	        """R6.2: hand out a new visitor key, replacing the one before; the relay stores its
  1126	        hash only and never logs or answers with the key again. The store lands only while
  1127	        the binding with the authorizing key still exists (C2)."""
  1128	        if not self.authorize_link(name):
  1129	            return
  1130	        visitor_key = secrets.token_urlsafe(32)
  1131	        if not store_visitor_key(name, key_hash(visitor_key), key_hash(self.bearer_key())):
  1132	            return self.error(404, 'not_found', f'There is no binding {name}.')
  1133	        log_line(f'new visitor key for {name}')
  1134	        self.send_json(200, {'visitorKey': visitor_key})
