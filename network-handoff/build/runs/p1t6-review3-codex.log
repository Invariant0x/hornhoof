   590	def upsert_route(name: str, content: dict, user: dict) -> str | None:
   591	    """Write the pending row for a let-through registration; a refusal when the write cannot land."""
   592	    row = db().execute('SELECT generation FROM routes WHERE name = ?', (name,)).fetchone()
   593	    generation = (row[0] if row else 0) + 1
   594	    metas = user.get('metas') or {}
   595	    try:
   596	        write(
   597	            'INSERT INTO routes (name, generation, client, run_id, type, state, since) VALUES (?, ?, ?, ?, ?, ?, ?) '
   598	            'ON CONFLICT(name) DO UPDATE SET generation = excluded.generation, client = excluded.client, '
   599	            'run_id = excluded.run_id, type = excluded.type, state = excluded.state, since = excluded.since',
   600	            (name, generation, metas.get('client') or 'legacy', user.get('run_id') or '',
   601	             content.get('proxy_type') or 'http', 'pending', now()))
   602	    except WriteBusy:
   603	        return 'relay error: busy'
   604	    except sqlite3.Error:
   605	        return 'relay error: frps does not answer'
   606	    return None
