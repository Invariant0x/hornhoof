    36	CADDYFILE = os.environ.get('RELAY_CADDYFILE', '/etc/caddy/Caddyfile')
    37	LISTEN = ('127.0.0.1', int(os.environ.get('RELAY_PORT', '7600')))
    38	FRPC_IMAGE = 'fatedier/frpc:v0.71.1@sha256:7a0a18bc9c83dc106a7e5213a890f521affdf90d595829c56b0ed8481377d50e'
    39	FRPC_CONFIG_PATH = '/etc/frp/frpc.toml'
    40	TARGET_HOST, TARGET_PORT = 'app', 8080
    41	
    42	# Bindings per client address per hour, and for everyone together; name checks per address per minute.
    43	BIND_PER_IP_HOUR = 5
