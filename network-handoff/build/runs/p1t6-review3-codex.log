   731	    if (content.get('proxy_type') != 'stcp' or label not in allowed
   732	            or not isinstance(sk, str) or len(sk) < 32
   733	            or allow_users not in (None, [], ['*'])):
   734	        return f'this client may not offer {label}'
   735	    return None
