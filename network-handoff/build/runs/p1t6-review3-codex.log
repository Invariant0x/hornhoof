   119	    def visitor_proxy(self, server_name: str, secret: str, port: int) -> str:
   120	        return f'''
   121	[[visitors]]
   122	name = "{server_name}-visit"
   123	type = "stcp"
   124	serverName = "{server_name}"
   125	secretKey = "{secret}"
   126	bindAddr = "127.0.0.1"
   127	bindPort = {port}
   128	'''
   129	
   130	    def echo(self, port: int, path: str = '/through-the-relay') -> str:
   131	        connection = http.client.HTTPConnection('127.0.0.1', port, timeout=10)
   132	        try:
   133	            connection.request('GET', path)
   134	            response = connection.getresponse()
   135	            self.assertEqual(response.status, 200)
   136	            return response.read().decode()
   137	        finally:
   138	            connection.close()
   139	
   140	    def echo_closes_silent(self, port: int) -> None:
   141	        """A wrong secret closes the visitor's connection with no answer: zero raw bytes
   142	        before EOF or a reset. An HTTP answer with an empty body, or a connection that
   143	        stays open, is not a silent close (probed against a plain 200/403 in TMPDIR)."""
   144	        sock = socket.create_connection(('127.0.0.1', port), timeout=10)
   145	        try:
   146	            try:
   147	                sock.sendall(b'GET /through-the-relay HTTP/1.1\r\nHost: probe\r\nConnection: close\r\n\r\n')
   148	            except (ConnectionResetError, BrokenPipeError):
   149	                return  # reset before the request went out: still no answer
   150	            received = b''
   151	            while True:
   152	                try:
   153	                    chunk = sock.recv(4096)
   154	                except (ConnectionResetError, BrokenPipeError):
   155	                    break
   156	                except socket.timeout:
   157	                    self.fail('the connection stayed open with no answer; a timeout is not a silent close')
   158	                if not chunk:
   159	                    break
   160	                received += chunk
   161	            self.assertEqual(received, b'')
   162	        finally:
   163	            sock.close()
