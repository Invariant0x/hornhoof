    91	def db() -> sqlite3.Connection:
    92	    conn = getattr(_local, 'conn', None)
    93	    if conn is None:
    94	        conn = sqlite3.connect(DB_PATH, timeout=10, isolation_level=None)
    95	        conn.execute('PRAGMA journal_mode=WAL')
    96	        conn.execute('PRAGMA synchronous=FULL')
    97	        conn.execute('PRAGMA busy_timeout=10000')
    98	        _local.conn = conn
    99	    return conn
