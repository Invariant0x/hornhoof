   335	def legacy_run_id_proven(name: str, run_id: str) -> bool:
   336	    """C1: proof that a legacy run id with a live session belongs to this binding.
   337	
   338	    The run id must not itself look like a network client id, and the binding's
   339	    own routes ledger must record it as a legacy route: no ledger row, no
   340	    ownership. A recorded same-binding legacy run id keeps its reconnect.
   341	    """
   342	    if CLIENT.fullmatch(run_id):
   343	        return False
   344	    row = db().execute("SELECT 1 FROM routes WHERE name = ? AND client = 'legacy' AND run_id = ? LIMIT 1",
   345	                       (name, run_id)).fetchone()
   346	    return row is not None
   347	
   348	
   349	def run_id_recorded_elsewhere(run_id: str, name: str) -> bool:
   350	    """True when the route ledger records this run id for another binding (C1).
   351	
   352	    A legacy login reusing such a run id would replace that binding's session in frps:
   353	    the dashboard shows the session's clientID as the run id itself, so the dashboard
   354	    check alone cannot refuse it.
   355	    """
   356	    row = db().execute('SELECT 1 FROM routes WHERE run_id = ? AND name != ? LIMIT 1',
   357	                       (run_id, name)).fetchone()
   358	    return row is not None
