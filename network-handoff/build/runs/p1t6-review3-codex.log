   566	def register_route(name: str, content: dict) -> str | None:
   567	    """Record a registration the plugin let through; a reason when the name cannot be taken (R1.1)."""
   568	    user = content.get('user') or {}
   569	    if not hold_route_lock(name):
   570	        return 'relay error: frps does not answer'
   571	    try:
   572	        return register_locked(name, content, user)
   573	    finally:
   574	        route_lock(name).release()
   575	
   576	
   577	def register_locked(name: str, content: dict, user: dict) -> str | None:
   578	    """The locked half of register_route: refuse a held name, else record the registration."""
   579	    try:
   580	        held = locked_route_of(name)['state'] == 'held'
   581	    except FrpsUnknown:
   582	        return 'relay error: frps does not answer'
   583	    except WriteBusy:
   584	        return 'relay error: busy'
   585	    if held:
   586	        return f'router config conflict: {name} is held'
   587	    return upsert_route(name, content, user)
