"""Local frp processes and an isolated relay, using only the standard library."""

import base64
from contextlib import ExitStack
import functools
import http.client
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os
from pathlib import Path
import re
import secrets
import signal
import socket
import subprocess
import sys
import threading
import time


ROOT = Path(__file__).resolve().parents[2]
BIN = Path(__file__).resolve().parent / '.bin'


@functools.lru_cache(maxsize=1)
def _ensure_frp():
    subprocess.run(['sh', str(BIN.parent / 'frp.sh')], cwd=ROOT, check=True, timeout=180)


def _request(port, method, path, body=None, headers=None):
    connection = http.client.HTTPConnection('127.0.0.1', port, timeout=2)
    try:
        connection.request(method, path, body=body, headers=headers or {})
        response = connection.getresponse()
        return response.status, response.read()
    finally:
        connection.close()


def _wait(predicate, within):
    deadline = time.monotonic() + within
    while True:
        if predicate():
            return True
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return False
        time.sleep(min(0.05, remaining))


class _Echo(BaseHTTPRequestHandler):
    def do_GET(self):
        data = json.dumps({'host': self.headers.get('Host'), 'path': self.path}).encode()
        self.send_response(200)
        self.send_header('Content-Type', 'application/json')
        self.send_header('Content-Length', str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    do_POST = do_GET
    do_PUT = do_GET
    do_PATCH = do_GET
    do_DELETE = do_GET
    do_HEAD = do_GET
    do_OPTIONS = do_GET

    def log_message(self, fmt, *args):
        pass


class _Process:
    def __init__(self, command, log_path, *, env=None, private=()):
        self.log_path = Path(log_path)
        self.private = private
        self.output = self.log_path.open('wb')
        try:
            self.process = subprocess.Popen(
                command, cwd=ROOT, env=env, stdin=subprocess.DEVNULL,
                stdout=self.output, stderr=subprocess.STDOUT,
            )
        except BaseException:
            self.output.close()
            raise

    def log(self) -> str:
        text = self.log_path.read_text(encoding='utf-8', errors='replace')
        for value in self.private:
            if value:
                text = text.replace(value, '[hidden]')
        return text

    def resume(self):
        if self.process.poll() is None:
            self.process.send_signal(signal.SIGCONT)

    def pause(self):
        if self.process.poll() is None:
            self.process.send_signal(signal.SIGSTOP)

    def _finish(self, *, kill):
        try:
            if self.process.poll() is None:
                self.resume()
                if kill:
                    self.process.kill()
                else:
                    self.process.terminate()
                try:
                    self.process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    self.process.kill()
                    self.process.wait(timeout=5)
            else:
                self.process.wait()
        finally:
            self.output.close()

    def stop(self):
        self._finish(kill=False)

    def kill(self):
        self._finish(kill=True)


class Client(_Process):
    def started(self, proxy: str, within: float = 15) -> bool:
        pattern = re.compile(r'\[' + re.escape(proxy) + r'\]\s+start proxy success\b')

        def ready():
            return pattern.search(self.log()) is not None or self.process.poll() is not None

        _wait(ready, within)
        return pattern.search(self.log()) is not None


class Stack:
    def __init__(self, tmp: str, dashboard: bool = True):
        self.tmp = Path(tmp)
        self.tmp.mkdir(parents=True, exist_ok=True)
        self.dashboard = dashboard
        self.clients = []
        self.relay = None
        self.frps = None
        self.echo = None
        self.echo_thread = None
        self.password = secrets.token_hex(24)
        self.private = [self.password]
        self._ports = set()
        self.relay_port = self._free_port()
        self.bind_port = self._free_port()
        self.vhost_port = self._free_port()
        self.dash_port = self._free_port()
        self.api_port = self.dash_port if dashboard else self._free_port()
        self.env = dict(os.environ, **{
            'RELAY_DB': str(self.tmp / 'relay.db'),
            'RELAY_PORT': str(self.relay_port),
            'RELAY_CADDYFILE': str(self.tmp / 'Caddyfile'),
            'RELAY_TRACE': '1',
            'RELAY_FRPS_API': f'http://127.0.0.1:{self.api_port}',
            'RELAY_FRPS_USER': 'admin',
            'RELAY_FRPS_PASSWORD': self.password,
            'RELAY_FRPS_BIND': f'127.0.0.1:{self.bind_port}',
            'RELAY_FRPS_STARTED': str(self.tmp / 'frps-started'),
        })

    def _free_port(self):
        while True:
            with socket.socket() as listener:
                listener.bind(('127.0.0.1', 0))
                port = listener.getsockname()[1]
            if port not in self._ports:
                self._ports.add(port)
                return port

    def __enter__(self):
        try:
            _ensure_frp()
            (self.tmp / 'Caddyfile').write_text('@reserved host www.hornhoof.org\n')
            self.echo = ThreadingHTTPServer(('127.0.0.1', 0), _Echo)
            self.echo.daemon_threads = True
            self.echo_port = self.echo.server_port
            self.echo_thread = threading.Thread(target=self.echo.serve_forever, daemon=True)
            self.echo_thread.start()
            self._start_relay()
            self.start_frps()
            return self
        except BaseException:
            self.close()
            raise

    def __exit__(self, exc_type, exc, traceback):
        self.close()

    def close(self):
        # ExitStack runs every cleanup even if one process fails to stop.
        with ExitStack() as cleanup:
            if self.echo is not None:
                cleanup.callback(self.echo.server_close)
                if self.echo_thread is not None and self.echo_thread.ident is not None:
                    cleanup.callback(self.echo_thread.join, timeout=5)
                    cleanup.callback(self.echo.shutdown)
            if self.relay is not None:
                cleanup.callback(self.relay.stop)
            if self.frps is not None:
                cleanup.callback(self.frps.stop)
            for client in self.clients:
                cleanup.callback(client.stop)

    def _ready(self, process, port, path):
        def ready():
            if process.process.poll() is not None:
                raise RuntimeError('Local process exited during startup:\n' + process.log())
            try:
                status, _ = _request(port, 'GET', path)
                return status == 200
            except (OSError, http.client.HTTPException):
                return False

        if not _wait(ready, 15):
            raise RuntimeError('Local process did not become ready:\n' + process.log())

    def _start_relay(self):
        self.relay = _Process(
            [sys.executable, '-u', str(ROOT / 'relay/relay.py')], self.tmp / 'relay.log',
            env=self.env, private=self.private,
        )
        # Readiness must work before frps starts, including when health later returns 503.
        self._ready(self.relay, self.relay_port, '/api/v1/names/www')

    def restart_relay(self):
        self.relay.stop()
        self._start_relay()

    def start_frps(self):
        if self.frps is not None and self.frps.process.poll() is None:
            return
        replacements = {
            'bindPort': str(self.bind_port),
            'vhostHTTPPort': str(self.vhost_port),
            'webServer.port': str(self.dash_port),
            'addr': json.dumps(f'127.0.0.1:{self.relay_port}'),
        }
        lines = []
        for line in (ROOT / 'relay/frps.toml').read_text().splitlines():
            key = line.split('=', 1)[0].strip()
            if key == 'custom404Page':
                continue
            if key in replacements:
                line = f'{key} = {replacements[key]}'
            lines.append(line.replace('@WEB_PASSWORD@', self.password))
        config_path = self.tmp / 'frps.toml'
        self._write_config(config_path, '\n'.join(lines) + '\n')
        Path(self.env['RELAY_FRPS_STARTED']).write_text(str(int(time.time())))
        self.frps = _Process(
            [str(BIN / 'frps'), '-c', str(config_path)], self.tmp / 'frps.log',
            private=self.private,
        )
        self._ready(self.frps, self.dash_port, '/healthz')

    def stop_frps(self):
"""setup-relay.sh's write_private: a secret file is never world-readable, not even for a moment."""

import grp
import os
from pathlib import Path
import shlex
import stat
import subprocess
import tempfile
import time
import unittest


ROOT = Path(__file__).resolve().parents[2]
HELPER = ROOT / 'relay' / 'private-file.sh'
SETUP = ROOT / 'relay' / 'setup-relay.sh'


def start_write_private(dest: Path, mode: str, group: str | None = None) -> subprocess.Popen:
    """Start write_private on a pipe the test controls; the caller writes the content."""
    command = ['sh', '-c', '. "$1"; shift; write_private "$@"', 'write_private',
               str(HELPER), str(dest), mode] + ([group] if group else [])
    return subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, text=True)


def finish(process: subprocess.Popen) -> tuple[int, str, str]:
    out, err = process.stdout.read(), process.stderr.read()
    process.stdout.close()
    process.stderr.close()
    return process.wait(timeout=5), out.strip(), err


def run_sh(script: str) -> subprocess.CompletedProcess:
    return subprocess.run(['sh', '-c', script], capture_output=True, text=True, timeout=30)


class WritePrivateTests(unittest.TestCase):
    def test_temp_file_is_private_while_the_content_arrives(self) -> None:
        with tempfile.TemporaryDirectory(prefix='hornhoof-private-') as tmp:
            dest = Path(tmp) / 'secret.env'
            process = start_write_private(dest, '640')
            process.stdin.write('first half\n')
            process.stdin.flush()
            tmp_file = Path(str(dest) + '.new')
            deadline = time.monotonic() + 5
            while not tmp_file.exists() and process.poll() is None and time.monotonic() < deadline:
                time.sleep(0.02)
            self.assertTrue(tmp_file.exists(),
                            'the temp file never appeared: write_private is not waiting on stdin')
            mode = stat.S_IMODE(tmp_file.stat().st_mode)
            self.assertEqual(mode & 0o077, 0, f'the temp file is readable by others: {oct(mode)}')
            process.stdin.write('second half\n')
            process.stdin.close()
            code, out, err = finish(process)
            self.assertEqual(code, 0, err)
            self.assertEqual(out, 'changed')
            self.assertEqual(dest.read_text(), 'first half\nsecond half\n')
            self.assertEqual(stat.S_IMODE(dest.stat().st_mode), 0o640)

    def test_unchanged_content_keeps_the_destination(self) -> None:
        with tempfile.TemporaryDirectory(prefix='hornhoof-private-') as tmp:
            dest = Path(tmp) / 'secret.env'
            for content, answer in (('same content\n', 'changed'), ('same content\n', 'unchanged')):
                process = start_write_private(dest, '640')
                process.stdin.write(content)
                process.stdin.close()
                code, out, err = finish(process)
                self.assertEqual(code, 0, err)
                self.assertEqual(out, answer)
            self.assertEqual(dest.read_text(), 'same content\n')

    def test_unchanged_content_fixes_mode_and_group_in_place(self) -> None:
        # A re-run must repair a destination that drifted from its mode and group, without
        # replacing the file.
        group = grp.getgrgid(os.getgid()).gr_name
        with tempfile.TemporaryDirectory(prefix='hornhoof-private-') as tmp:
            dest = Path(tmp) / 'secret.env'
            dest.write_text('same content\n')
            dest.chmod(0o644)
            inode = dest.stat().st_ino
            process = start_write_private(dest, '640', group)
            process.stdin.write('same content\n')
            process.stdin.close()
            code, out, err = finish(process)
            self.assertEqual(code, 0, err)
            self.assertEqual(out, 'unchanged')
            self.assertEqual(dest.read_text(), 'same content\n')
            self.assertEqual(stat.S_IMODE(dest.stat().st_mode), 0o640,
                             'an unchanged destination kept its wrong mode')
            self.assertEqual(dest.stat().st_ino, inode, 'an unchanged file was replaced')

    def test_changed_content_replaces_the_destination(self) -> None:
        with tempfile.TemporaryDirectory(prefix='hornhoof-private-') as tmp:
            dest = Path(tmp) / 'secret.env'
            for content, answer in (('old\n', 'changed'), ('new\n', 'changed')):
                process = start_write_private(dest, '640')
                process.stdin.write(content)
                process.stdin.close()
                code, out, err = finish(process)
                self.assertEqual(code, 0, err)
                self.assertEqual(out, answer)
            self.assertEqual(dest.read_text(), 'new\n')

    def test_failed_rename_reports_failure(self) -> None:
        # The destination is a directory the caller cannot write: the rename fails, the
        # helper must say so with a non-zero status and never print "changed".
        with tempfile.TemporaryDirectory(prefix='hornhoof-private-') as tmp:
            dest = Path(tmp) / 'blocked'
            dest.mkdir()
            dest.chmod(0o555)
            try:
                process = start_write_private(dest, '640')
                process.stdin.write('content\n')
                process.stdin.close()
                code, out, err = finish(process)
                self.assertNotEqual(code, 0, f'rename failure reported success: {out} {err}')
                self.assertNotEqual(out, 'changed')
                self.assertTrue(dest.is_dir())
                self.assertFalse(Path(str(dest) + '.new').exists(), 'the temp file was left behind')
            finally:
                dest.chmod(0o755)

    def test_call_does_not_clobber_caller_variables(self) -> None:
        with tempfile.TemporaryDirectory(prefix='hornhoof-private-') as tmp:
            dest = Path(tmp) / 'out'
            caller = ('dest=caller-dest', 'mode=caller-mode', 'group=caller-group', 'tmp=caller-tmp')
            script = (f'. {shlex.quote(str(HELPER))}\n'
                      + '\n'.join(caller) + '\n'
                      + f'write_private {shlex.quote(str(dest))} 640 > /dev/null <<\'EOF\'\n'
                      + 'data\nEOF\n'
                      + 'printf \'%s %s %s %s\\n\' "$dest" "$mode" "$group" "$tmp"\n')
            result = run_sh(script)
            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertEqual(result.stdout, 'caller-dest caller-mode caller-group caller-tmp\n')

    def test_failing_producer_keeps_the_destination(self) -> None:
        # The pattern setup-relay.sh uses: produce the content first, then hand it to
        # write_private. A failing producer must abort before anything is written.
        with tempfile.TemporaryDirectory(prefix='hornhoof-private-') as tmp:
            dest = Path(tmp) / 'frps.toml'
            dest.write_text('good content\n')
            script = (f'. {shlex.quote(str(HELPER))}\nset -eu\n'
                      f'content=$(cat {shlex.quote(str(Path(tmp) / "missing-template"))})\n'
                      + f'printf \'%s\\n\' "$content" | write_private {shlex.quote(str(dest))} 640\n')
            result = run_sh(script)
            self.assertNotEqual(result.returncode, 0,
                                f'a failing producer kept the script running: {result.stdout}')
            self.assertEqual(dest.read_text(), 'good content\n')

    def test_setup_feeds_write_private_only_checked_content(self) -> None:
        # setup-relay.sh must never pipe a producer straight into write_private: under
        # set -e a failing producer in a pipeline would not stop the script, and an empty
        # file would replace good content.
        for number, line in enumerate(SETUP.read_text().splitlines(), start=1):
            if 'write_private' in line and '|' in line:
                producer = line.split('|', 1)[0].strip()
                if '$(' in producer:
                    producer = producer.split('$(', 1)[1].strip()
                self.assertRegex(producer, r"^printf '%s\\n' \"\$[a-z_]+\"$", f'line {number}: {line}')

    def test_shell_files_parse(self) -> None:
        # sh -n checks one file per invocation; check each script on its own.
        for script in (SETUP, HELPER):
            with self.subTest(script=script.name):
                result = subprocess.run(['sh', '-n', str(script)], capture_output=True, text=True)
                self.assertEqual(result.returncode, 0, result.stderr)


if __name__ == '__main__':
    unittest.main()
