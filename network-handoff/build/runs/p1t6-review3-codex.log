   258	
   259	def dash_answer(name: str, proxy_type: str) -> tuple[str, str] | None:
   260	    """One proxy type's dashboard record: (status, clientID), None on 404, FrpsUnknown otherwise.
   261	
   262	    A record is trusted only with a status of online or offline and a non-empty clientID:
   263	    a missing field reads as unknown, never as empty.
   264	    """
   265	    status, body = _dash_get(f'/api/proxy/{proxy_type}/{name}')
   266	    if status == 404:
   267	        return None
   268	    if status != 200:
   269	        raise FrpsUnknown(f'dashboard answered {status} for {proxy_type} {name}')
   270	    try:
   271	        answer = json.loads(body)
   272	        route_status = answer['status']
   273	        client_id = answer['clientID']
   274	    except (ValueError, KeyError, TypeError):
   275	        raise FrpsUnknown(f'dashboard body for {proxy_type} {name} has no route record') from None
   276	    if route_status not in ('online', 'offline') or not isinstance(client_id, str) or not client_id:
   277	        raise FrpsUnknown(f'dashboard body for {proxy_type} {name} is not a route record')
   278	    return route_status, client_id
   279	
   280	
   281	def dash_client_records(body: bytes) -> list[dict]:
   282	    """The parsed clients answer: a list of records with a clientID string and a boolean
   283	    online. Anything else is FrpsUnknown, never an empty guess."""
   284	    try:
   285	        answer = json.loads(body)
   286	    except ValueError:
   287	        raise FrpsUnknown('dashboard clients answer is not JSON') from None
   288	    if not isinstance(answer, list):
   289	        raise FrpsUnknown('dashboard clients answer is not a list')
   290	    for entry in answer:
   291	        if (not isinstance(entry, dict) or not isinstance(entry.get('clientID'), str)
   292	                or not entry['clientID']
   293	                or type(entry.get('online')) is not bool):
   294	            raise FrpsUnknown('dashboard clients answer has no client record')
   295	    return answer
   296	
   297	
   298	def dash_clients(run_id: str) -> list[dict]:
   299	    """The /api/clients?runId= answer on the plugin call's budget; a dashboard error is
   300	    FrpsUnknown, never an empty guess."""
   301	    status, body = _dash_get(f'/api/clients?runId={quote(run_id, safe="")}')
   302	    if status != 200:
   303	        raise FrpsUnknown(f'dashboard answered {status} for clients runId {run_id}')
   304	    return dash_client_records(body)
