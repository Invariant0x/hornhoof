   108	                pass
   109	
   110	        server = ThreadingHTTPServer(('127.0.0.1', 0), _NamedEcho)
   111	        server.daemon_threads = True
   112	        thread = threading.Thread(target=server.serve_forever, daemon=True)
   113	        thread.start()
   114	        self.addCleanup(thread.join, 5)
