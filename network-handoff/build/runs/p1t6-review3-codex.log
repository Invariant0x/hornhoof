   635	def client_id_reason(name: str, kind: str, client_id: str, meta_client) -> str | None:
   636	    """R1.3, R5.1: a client id names this link and matches its session's key kind.
   637	
   638	    An empty client id is a today's tunnel: only a link-key session without metas.client.
   639	    """
   640	    if not client_id:
   641	        if kind == 'link' and not meta_client:
   642	            return None
   643	        return f'this client id is not for {name}'
   644	    match = CLIENT.fullmatch(client_id)
   645	    if (match is None or match.group('link') != name or meta_client != client_id
   646	            or (match.group('kind') == 'visit') != (kind == 'visitor')):
   647	        return f'this client id is not for {name}'
   648	    return None
