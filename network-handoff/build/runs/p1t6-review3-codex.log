   395	def write(sql: str, args: tuple) -> None:
   396	    """The one SQLite write of the plugin and the API.
   397	
   398	    SQLite itself retries database is locked for the write's budget (0.8 s, or the plugin
   399	    call's time left, whichever is less); past the budget the write raises WriteBusy and a
   400	    plugin call refuses with 'relay error: busy' (Review Focus 3).
   401	    """
   402	    conn = db()
   403	    left = call_deadline()
   404	    if left is not None and left <= 0:
   405	        raise WriteBusy('plugin call budget spent')
   406	    budget = 0.8 if left is None else min(0.8, left)
   407	    conn.execute(f'PRAGMA busy_timeout = {max(0, int(budget * 1000))}')
   408	    try:
   409	        conn.execute(sql, args)
   410	    except sqlite3.OperationalError as e:
   411	        if 'locked' in str(e):
   412	            raise WriteBusy(f'database is locked for {budget:.2f} s') from None
