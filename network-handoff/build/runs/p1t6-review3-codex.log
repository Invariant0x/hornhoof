   361	def frps_route(name: str) -> tuple[str, str | None, str | None]:
   362	    """frps's own view of a name's route: ('online'|'offline', clientID, type), or ('absent', None, None).
   363	
   364	    Both proxy types are read: a name holds one route of either type, and two records is unknown.
   365	    """
   435	              "AND state = 'pending'", (t, name, generation))
   436	
   437	
   438	def route_body(name: str, row) -> dict:
   439	    """The R2.1 answer from a routes row; a name with no row is empty at generation 0."""
   440	    if row is None:
   441	        binding = db().execute('SELECT created_at FROM bindings WHERE name = ?', (name,)).fetchone()
   442	        since = binding[0] if binding else None
   443	        state, client, generation = 'empty', None, 0
   444	    else:
   445	        since = row[5]
   446	        state = 'empty' if row[4] == 'empty' else 'held'
   447	        client = row[1] if state == 'held' else None
   448	        generation = row[0]
   449	    return {'state': state, 'client': client, 'since': since, 'generation': generation,
   450	            'relayStarted': relay_started(), 'evictionBound': EVICTION_BOUND_S, 'sync': sync_of(name)}
   451	
   452	
   453	def sync_of(name: str) -> dict:
   454	    """The last committed sync record, or the R2.4 default when no holder has set one."""
   455	    row = db().execute('SELECT state, copy, epoch, generation, at FROM sync WHERE name = ?',
   456	                       (name,)).fetchone()
   457	    if row is None:
   458	        return {'state': 'off', 'copy': None, 'epoch': 0, 'generation': 0, 'at': None}
   459	    return dict(zip(('state', 'copy', 'epoch', 'generation', 'at'), row))
   460	
   461	
   462	def sync_text(value: object) -> bool:
   463	    return isinstance(value, str) and 1 <= len(value) <= 100
   464	
   465	
   466	def sync_integer(value: object) -> bool:
   467	    """A positive SQLite INTEGER, excluding JSON booleans."""
   468	    return type(value) is int and 1 <= value <= 2 ** 63 - 1
   469	
   470	
   471	def sync_copy(state: str, copy: object) -> bool:
   472	    return sync_text(copy) or (state == 'off' and copy is None)
   473	
   474	
   475	def valid_sync_body(body: object) -> bool:
   476	    """Validate the complete R2.4 body, including exact fields and JSON integer types."""
   477	    if not isinstance(body, dict) or set(body) != {'client', 'generation', 'state', 'copy', 'epoch'}:
   478	        return False
   479	    return all((sync_text(body['client']), sync_integer(body['generation']),
   480	                body['state'] in ('on', 'off'), sync_copy(body['state'], body['copy']),
   481	                sync_integer(body['epoch'])))
   482	
   483	
   484	def sync_holder(name: str, body: dict) -> bool:
   485	    """An online frps route must name this registration; a pending row cannot set sync."""
   486	    route = locked_route_of(name)
   487	    row = db().execute('SELECT state FROM routes WHERE name = ?', (name,)).fetchone()
   488	    return (row == ('held',) and route['client'] == body['client']
   489	            and route['generation'] == body['generation'])
   490	
   491	
   492	def store_sync(name: str, body: dict) -> bool:
   493	    """Commit only while the checked registration still holds; never overwrite a newer epoch."""
   494	    write('INSERT INTO sync (name, state, copy, epoch, generation, at) '
   495	          'SELECT name, ?, ?, ?, generation, ? FROM routes '
   496	          "WHERE name = ? AND generation = ? AND client = ? AND state = 'held' "
   497	          'ON CONFLICT(name) DO UPDATE SET state = excluded.state, copy = excluded.copy, '
   498	          'epoch = excluded.epoch, generation = excluded.generation, at = excluded.at '
   499	          'WHERE excluded.epoch > sync.epoch',
   500	          (body['state'], body['copy'], body['epoch'], now(), name, body['generation'], body['client']))
   501	    return db().execute('SELECT changes()').fetchone()[0] == 1
   502	
   503	
   504	def set_sync(name: str, body: dict) -> tuple[str | None, dict | None]:
   505	    """Serialize the frps holder check and committed write against the name's registrations."""
   506	    with route_lock(name):
   507	        if not sync_holder(name, body):
   508	            return 'not_holder', None
   509	        if body['epoch'] <= sync_of(name)['epoch']:
   510	            return 'stale_epoch', None
   511	        if not store_sync(name, body):
   512	            return 'not_holder', None
   513	        return None, sync_of(name)
   514	
   515	
   516	def locked_route_of(name: str) -> dict:
   517	    """The R2.1 body with the per-name lock already held: the row straightened against frps."""
   518	    status, client_id, proxy_type = frps_route(name)
   519	    row = db().execute('SELECT generation, client, run_id, type, state, since FROM routes WHERE name = ?',
   520	                       (name,)).fetchone()
   521	    if row is not None:
   522	        check_route_holder(name, row, status, client_id, proxy_type)
   523	        try:
   524	            straighten_route(name, row, status, now())
   525	        except sqlite3.Error as e:
   526	            raise FrpsUnknown(f'route store is not writable: {type(e).__name__}') from None
   527	        row = db().execute('SELECT generation, client, run_id, type, state, since FROM routes WHERE name = ?',
   528	                           (name,)).fetchone()
   529	    else:
   530	        check_route_holder(name, None, status, client_id, proxy_type)
   531	    return route_body(name, row)
   532	
   533	
   534	def route_of(name: str) -> dict:
   535	    """The R2.1 body for a name: the routes row straightened against what frps shows right now.
   536	
   537	    The per-name lock serializes every read-and-straighten against registrations.
   538	    """
   539	    with route_lock(name):
   540	        return locked_route_of(name)
