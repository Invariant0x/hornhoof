   841	@contextlib.contextmanager
   842	def transaction():
   843	    """One BEGIN IMMEDIATE..COMMIT block; every statement, including BEGIN and
   844	    COMMIT, runs through write(), so lock acquisition draws from the one write
   845	    budget and raises the same WriteBusy as a single write (G1). Any failure
   846	    rolls back; a spent budget refuses instead of waiting.
   847	    """
   848	    conn = db()
   849	    write('BEGIN IMMEDIATE', ())
   850	    try:
   851	        yield
   852	        write('COMMIT', ())
   853	    except BaseException:
   854	        if conn.in_transaction:
   855	            try:
   856	                conn.execute('ROLLBACK')
   857	            except sqlite3.Error:
   858	                pass
   859	        raise
