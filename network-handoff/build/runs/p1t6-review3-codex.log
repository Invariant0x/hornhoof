   773	class Window:
   774	    """Counts events per key in a sliding window, in memory."""
   775	
   776	    def __init__(self, limit: int, seconds: int):
   777	        self.limit, self.seconds, self.hits, self.lock = limit, seconds, {}, threading.Lock()
   778	
   779	    def allow(self, key: str) -> int:
   780	        """0 if allowed (and counted), else seconds to wait."""
   781	        t = time.time()
   782	        with self.lock:
   783	            if len(self.hits) > 50000:
   784	                self.hits = {k: v for k, v in self.hits.items() if v and v[-1] > t - self.seconds}
   785	            recent = [x for x in self.hits.get(key, []) if x > t - self.seconds]
   786	            if len(recent) >= self.limit:
   787	                self.hits[key] = recent
   788	                return int(recent[0] + self.seconds - t) + 1
   789	            recent.append(t)
   790	            self.hits[key] = recent
   791	            return 0
   792	
