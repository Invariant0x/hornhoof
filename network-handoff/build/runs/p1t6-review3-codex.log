   609	def shared_route_fields(content: dict) -> str | None:
   610	    """R1.2: a name is one company's one route, never shared or split across locations or users."""
   611	    for field in ('locations', 'route_by_http_user', 'group'):
   612	        if content.get(field):
   613	            return f'{field} is not allowed'
