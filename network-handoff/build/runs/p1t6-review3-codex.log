   862	def release_binding(name: str, expected_hash: str | None = None) -> bool:
   863	    """Drop a binding and its visitor credentials in one transaction (C2).
   864	
   865	    Separate deletes would let a concurrent visitor-key issuer plant a credential for the
   866	    name between them. The HTTP DELETE passes the hash of the key that authorized it: the
   867	    deletes recheck that hash and a currently unblocked binding inside the transaction,
   868	    so a request authorized for an older lifetime cannot drop a new owner's binding
   869	    (stale DELETE) and one in flight when the operator bans the name cannot erase the
   870	    ban (concurrent ban); False then reads as 404. Admin release passes no hash and
   871	    stays operator-authorized.
   872	    """
   873	    with transaction():
   874	        if expected_hash is None:
   875	            write('DELETE FROM visitor_keys WHERE name = ?', (name,))
   876	            write('DELETE FROM bindings WHERE name = ?', (name,))
   877	        else:
   878	            # The guarded release requires the authorizing hash and a currently
   879	            # unblocked binding: a DELETE in flight when the operator bans the
   880	            # name must not erase the ban (C2 concurrent ban).
   881	            write('DELETE FROM visitor_keys WHERE name = ? AND EXISTS '
   882	                  '(SELECT 1 FROM bindings WHERE name = ? AND key_hash = ? AND banned_at IS NULL)',
   883	                  (name, name, expected_hash))
   884	            write('DELETE FROM bindings WHERE name = ? AND key_hash = ? AND banned_at IS NULL',
   885	                  (name, expected_hash))
   886	        return db().execute('SELECT changes()').fetchone()[0] == 1
   887	
   888	
   889	def unban_binding(name: str) -> None:
   890	    """Lift a ban in one transaction; a placeholder ban row goes with its visitor key."""
   891	    with transaction():
   892	        write('UPDATE bindings SET banned_at = NULL, ban_reason = NULL WHERE name = ?', (name,))
   893	        write('DELETE FROM visitor_keys WHERE name = ? AND EXISTS '
   894	              '(SELECT 1 FROM bindings WHERE name = ? AND key_hash = \'-\')', (name, name))
   895	        write("DELETE FROM bindings WHERE name = ? AND key_hash = '-'", (name,))
   896	
   897	
   898	def store_visitor_key(name: str, visitor_hash: str, link_hash: str) -> bool:
   899	    """R6.2: store the hash only while the binding with the authorizing key still exists.
   900	
   901	    A request authorized before a release or rebind cannot plant a credential for the
   902	    name's next owner (C2): the write re-checks the binding's key hash in the same
   903	    statement, and a failed check changes nothing.
   904	    """
   905	    write('INSERT INTO visitor_keys (name, key_hash, created_at) '
   906	          'SELECT ?, ?, ? WHERE EXISTS (SELECT 1 FROM bindings WHERE name = ? AND key_hash = ?) '
   907	          'ON CONFLICT(name) DO UPDATE SET key_hash = excluded.key_hash, '
   908	          'created_at = excluded.created_at',
   909	          (name, visitor_hash, now(), name, link_hash))
   910	    return db().execute('SELECT changes()').fetchone()[0] == 1
   911	
   912	
   913	def visitor_hash_matches(name: str, visitor: str) -> bool:
   914	    """R6.2: the visitor key matches only while it is the one stored, compared in constant time."""
   915	    row = db().execute('SELECT key_hash FROM visitor_keys WHERE name = ?', (name,)).fetchone()
   916	    return row is not None and hmac.compare_digest(row[0], key_hash(visitor))
   917	
   918	
   919	def binding_state(name: str):
   920	    """The bindings row for name, or the refusal: no binding, or blocked."""
   921	    row = db().execute('SELECT key_hash, banned_at FROM bindings WHERE name = ?', (name,)).fetchone()
   922	    if row is None:
   923	        return f'no binding {name} with this key'
   924	    if row[1]:
   925	        return f'{name}.{DOMAIN} is blocked'
   926	    return row
   927	
   928	
   929	def key_kind(name: str, metas: dict, row: tuple) -> str | None:
   930	    """'link' when the link key matches, 'visitor' when only the visitor key does."""
   931	    key = metas.get('key')
   932	    if isinstance(key, str) and key and hmac.compare_digest(row[0], key_hash(key)):
   933	        return 'link'
   934	    visitor = metas.get('visitor')
   935	    if key is None and isinstance(visitor, str) and visitor and visitor_hash_matches(name, visitor):
   936	        return 'visitor'
   937	    return None
   938	
   939	
   940	def authenticate(metas: dict) -> tuple[str | None, str | None, str | None]:
   941	    """(name, kind, refusal): kind is 'link' with the link key, 'visitor' with the visitor key.
   942	
   943	    The binding check is as before; a login with no metas.key may match the stored
   944	    visitor key instead (R6.2).
   945	    """
   946	    name = metas.get('name')
   947	    if not isinstance(name, str) or not name:
   948	        return None, None, 'this tunnel has no Hornhoof relay binding (metadatas.name and metadatas.key)'
   949	    state = binding_state(name)
   950	    if isinstance(state, str):
   951	        return name, None, state
   952	    kind = key_kind(name, metas, state)
   953	    if kind is None:
   954	        return name, None, f'no binding {name} with this key'
   955	    return name, kind, None
