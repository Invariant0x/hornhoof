   169	
   170	# relayStarted is the latest of: this process's start, the watcher's first frps answer after
   171	# a failure or after start, and the integer in RELAY_FRPS_STARTED (R2.2, R4.1).
   172	STARTED = now()
   173	
   174	# frps watcher state: frps_ok_at is the epoch of the last good probe, frps_back_at the epoch
   175	# of the first good probe after a failure or after start (0 until then).
   176	_frps = {'ok_at': 0.0, 'back_at': 0}
   177	WATCH_INTERVAL_S = 0.5
   178	# Health answers 200 only while the watcher's last good probe is younger than this.
   179	HEALTH_MAX_AGE_S = 2.0
   180	
   181	
   182	def frps_answers() -> bool:
   183	    """True when frps's bind port accepts a connection and its dashboard answers /healthz."""
   184	    host, _, port_text = RELAY_FRPS_BIND.rpartition(':')
   185	    try:
   186	        connection = socket.create_connection((host, int(port_text)), timeout=1)
   187	        connection.close()
   188	    except OSError:
   189	        return False
   190	    try:
   191	        status, _ = _dash_get('/healthz', cap=1.0)
   192	    except FrpsUnknown:
   193	        return False
   194	    return status == 200
   195	
   196	
   197	def watch_frps() -> None:
   198	    """Probe frps forever; keep the last good answer and the recovery after a failure."""
   199	    was_ok = False
   200	    while True:
   201	        if frps_answers():
   202	            t = time.time()
   203	            if not was_ok:
   204	                _frps['back_at'] = t
   205	            _frps['ok_at'] = t
   206	            was_ok = True
   207	        else:
   208	            was_ok = False
   209	        time.sleep(WATCH_INTERVAL_S)
   210	
   211	
   212	def frps_ok() -> bool:
   213	    """R4.1: true while the watcher's last frps answer is under HEALTH_MAX_AGE_S old."""
   214	    return time.time() - _frps['ok_at'] < HEALTH_MAX_AGE_S
   215	
   216	
   217	def frps_started_file() -> int:
   218	    """The integer systemd's ExecStartPost wrote when frps last started, 0 when unreadable."""
   219	    try:
   220	        with open(RELAY_FRPS_STARTED) as f:
   221	            return int(f.read().strip())
   222	    except (OSError, ValueError):
   223	        return 0
   224	
   225	
   226	def relay_started() -> int:
   227	    """The latest of the relay's start, the frps recovery and frps's own start."""
   228	    return int(max(STARTED, _frps['back_at'], frps_started_file()))
