   542	
   543	_route_locks_guard = threading.Lock()
   544	_route_locks: dict[str, threading.Lock] = {}
   545	
   546	
   547	def route_lock(name: str) -> threading.Lock:
   548	    with _route_locks_guard:
   549	        lock = _route_locks.get(name)
   550	        if lock is None:
   551	            lock = threading.Lock()
   552	            _route_locks[name] = lock
   553	    return lock
   554	
   555	
   556	def hold_route_lock(name: str) -> bool:
   557	    """Take the per-name lock within the plugin call's remaining budget; False when the budget ran out."""
   558	    lock = route_lock(name)
   559	    left = call_deadline()
   560	    if left is None:
   561	        lock.acquire()
   562	        return True
   563	    return left > 0 and lock.acquire(timeout=left)
