   697	def offer_reason(name: str, kind: str, content: dict, metas: dict) -> str | None:
   698	    """R5.1: a visitor offers nothing; a peer offers only its two stcp services; the rest
   699	    is the http proxy of today (Task 2). stcp services get no route row and no generation."""
   700	    reason = malformed_user_reason(content)
