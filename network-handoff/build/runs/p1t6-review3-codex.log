   158	def check_name(name: str):
   159	    """None when the name can be bound, else 'invalid', 'reserved' or 'taken'. A banned name counts as reserved."""
   160	    if not LABEL.match(name) or name[2:4] == '--':
   161	        return 'invalid'
   162	    if name in reserved_names():
   163	        return 'reserved'
   164	    row = db().execute('SELECT banned_at FROM bindings WHERE name = ?', (name,)).fetchone()
   165	    if row is None:
   166	        return None
   167	    return 'reserved' if row[0] else 'taken'
