   651	def malformed_id_reason(name: str, content: dict, metas: dict) -> str | None:
   652	    """I6: a present-but-non-string id refuses; an absent one stays the legacy empty
   653	    string, as actual legacy frpc sends it."""
   654	    if 'client_id' in content and not isinstance(content['client_id'], str):
   655	        return f'this client id is not for {name}'
   656	    if 'client' in metas and not isinstance(metas['client'], str):
   657	        return f'this client id is not for {name}'
   658	    if 'run_id' in content and not isinstance(content['run_id'], str):
   659	        return 'this run id belongs to another client'
