     1	#!/usr/bin/env python3
     2	"""Hornhoof relay: hands out <name>.hornhoof.org links and checks every tunnel that frps lets in.
     3	
     4	Public API (Caddy sends https://hornhoof.org/api/* here):
     5	  GET    /api/v1/names/{name}      -> 200 {name, free, reason?: taken|reserved|invalid}
     6	  POST   /api/v1/bindings          {name?} -> 201 {name, url, key, tunnel}
     7	  DELETE /api/v1/bindings/{name}   Authorization: Bearer <key> -> 204 (404 once the name belongs to a new owner)
     8	  GET    /api/v1/links/{name}/route Authorization: Bearer <key> -> 200 {state, client, since, generation, ...}
     9	  POST   /api/v1/links/{name}/sync  Authorization: Bearer <key> {client, generation, state, copy, epoch} -> 200 {sync}
    10	  POST   /api/v1/links/{name}/visitor-key Authorization: Bearer <key> -> 200 {visitorKey} (R6.2)
    11	  GET    /api/v1/health            -> 200 {ok, frps, relayStarted} while frps takes logins, else 503
    12	frps plugin (local only): POST /frp/handler?op=Login|NewProxy|Ping
    13	Admin (as the service user): relay.py admin list|show|ban|unban|release|banned-caddy ...
    14	
    15	Standard library only. State: SQLite in /var/lib/hornhoof-relay/relay.db. Keys are stored as SHA-256 hashes.
    16	"""
    17	import base64
    18	import contextlib
    19	import hashlib
    20	import hmac
