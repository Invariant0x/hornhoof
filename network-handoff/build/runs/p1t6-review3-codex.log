   138	_reserved = {'mtime': None, 'names': frozenset()}
   139	
   140	
   141	def reserved_names() -> frozenset:
   142	    """The names on the Caddyfile's @reserved line, reread when the file changes."""
   143	    try:
   144	        mtime = os.stat(CADDYFILE).st_mtime
   145	    except OSError:
   146	        return _reserved['names']
   147	    if mtime != _reserved['mtime']:
   148	        names = set()
   149	        with open(CADDYFILE) as f:
   150	            for line in f:
   151	                parts = line.split()
   152	                if parts[:2] == ['@reserved', 'host']:
   153	                    names.update(h[: -len('.' + DOMAIN)] for h in parts[2:] if h.endswith('.' + DOMAIN))
   154	        _reserved.update(mtime=mtime, names=frozenset(names))
   155	    return _reserved['names']
