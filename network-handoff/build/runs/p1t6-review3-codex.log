   696	# frp 0.71.1 v1 wire constants, pinned against the local binaries under test:
   697	# a control login is one yamux stream (12-byte header, version 0; only data
   698	# frames carry a payload, the length field of windowUpdate/ping frames is a
   699	# value) with one msg.Login on it: 1 type byte ('o'), 8 big-endian length
   700	# bytes, a JSON body whose metas map rides as "metas"; token auth is
   701	# privilege_key = md5(token + decimal timestamp), the test frps.toml pinning an
   702	# empty token. The answer is one msg.LoginResp ('1'): the run id, or an error.
   703	_Y_DATA, _Y_WINDOW, _Y_PING, _Y_GOAWAY = 0, 1, 2, 3
   704	_Y_SYN, _Y_ACK = 0x1, 0x2
   705	_MSG_LOGIN_RESP = b'1'
   706	
   707	
   708	class FrpsWireSession:
   709	    """One native frps control login, spoken by hand over the v1 wire (R1.3).
   710	
   711	    A plugin post cannot displace a real session, so takeover tests log in
   712	    through frps itself. The reader answers the server's keepalive pings
   713	    (a ping with the SYN flag, its id in the length field) with a ping
   714	    carrying the ACK flag and the same id, as the bundled yamux fork does.
   715	    """
   716	
   717	    def __init__(self, stack, metas: dict, client_id: str = '', run_id: str = ''):
   718	        self.sock = socket.create_connection(('127.0.0.1', stack.bind_port), timeout=15)
   719	        self.send_lock = threading.Lock()
   720	        self.incoming = bytearray()
   721	        self.closed = threading.Event()
   722	        self.reader = threading.Thread(target=self._read_frames, daemon=True)
   723	        self.reader.start()
   724	        timestamp = int(time.time())
   725	        login = {'version': '0.71.1', 'hostname': 'native-probe',
   726	                 'privilege_key': hashlib.md5(str(timestamp).encode()).hexdigest(),
   727	                 'timestamp': timestamp, 'metas': metas, 'pool_count': 0}
   728	        if client_id:
   729	            login['client_id'] = client_id
   730	        if run_id:
   731	            login['run_id'] = run_id
   732	        body = json.dumps(login).encode()
   733	        with self.send_lock:
   734	            self.sock.sendall(struct.pack('>BBHII', 0, _Y_WINDOW, _Y_SYN, 1, 0)
   735	                              + struct.pack('>BBHII', 0, _Y_DATA, 0, 1, 9 + len(body))
   736	                              + b'o' + struct.pack('>q', len(body)) + body)
   737	        self.resp = self._wait_login_resp()
   738	
   739	    def _send(self, ftype: int, flags: int, stream: int, value: int, payload: bytes = b'') -> None:
   740	        with self.send_lock:
   741	            self.sock.sendall(struct.pack('>BBHII', 0, ftype, flags, stream, value) + payload)
   742	
   743	    def _read_frames(self) -> None:
   744	        try:
   745	            while True:
   746	                header = self._exact(12)
   747	                if header is None:
   748	                    break
   749	                _, ftype, flags, stream, value = struct.unpack('>BBHII', header)
   750	                if ftype == _Y_DATA:
   751	                    payload = self._exact(value) if value else b''
   752	                    if payload is None:
   753	                        break
   754	                    if stream == 1:
   755	                        self.incoming += payload
   756	                elif ftype == _Y_PING and flags & _Y_SYN:
   757	                    self._send(_Y_PING, _Y_ACK, 0, value)
   758	                elif ftype == _Y_GOAWAY:
   759	                    break
   760	        except OSError:
   761	            pass
   762	        finally:
   763	            self.closed.set()
   764	
   765	    def _exact(self, size: int):
   766	        data = b''
   767	        while len(data) < size:
   768	            chunk = self.sock.recv(size - len(data))
   769	            if not chunk:
   770	                return None
   771	            data += chunk
   772	        return data
   773	
   774	    def _wait_login_resp(self, within: float = 15):
   775	        deadline = time.monotonic() + within
   776	        while time.monotonic() < deadline:
   777	            if len(self.incoming) >= 9:
   778	                length = struct.unpack('>q', bytes(self.incoming[1:9]))[0]
   779	                if len(self.incoming) >= 9 + length:
   780	                    if self.incoming[0:1] != _MSG_LOGIN_RESP:
   781	                        return None
   782	                    return json.loads(bytes(self.incoming[9:9 + length]))
   783	            if self.closed.is_set():
   784	                return None
   785	            time.sleep(0.02)
   786	        raise TimeoutError('frps did not answer the native Login')
   787	
   788	    @property
   789	    def accepted(self) -> bool:
   790	        return self.resp is not None and not self.resp.get('error')
   791	
   792	    def close(self) -> None:
   793	        try:
   794	            self.sock.close()
   795	        except OSError:
   796	            pass
