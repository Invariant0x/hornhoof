  1136	    def health_answer(self):
  1137	        """GET /api/v1/health (R4.1): 200 only while frps takes logins, else 503; never a guess."""
  1138	        if frps_ok():
  1139	            return self.send_json(200, {'ok': True, 'frps': True, 'relayStarted': relay_started()})
