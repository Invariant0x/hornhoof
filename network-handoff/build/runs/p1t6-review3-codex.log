  1158	        """Parse the plugin body into (op, content, error reason)."""
  1159	        try:
  1160	            req = self.read_json()
  1161	            if not isinstance(req, dict):
  1162	                raise TypeError('plugin request is not an object')
  1163	            content = req.get('content')
  1164	            if not isinstance(content, dict):
  1165	                content = {}
  1166	            return req.get('op', ''), content, None
  1167	        except Exception as e:
  1168	            return '', {}, f'relay error: {type(e).__name__}'
