   723	def peer_proxy_reason(name: str, m8: str, content: dict) -> str | None:
   724	    """R5.1: a peer offers only <name>-<m8>-data and <name>-<m8>-app, stcp with a real
   725	    secret and open to every visitor of the service."""
   726	    proxy_name = content.get('proxy_name')
   727	    label = proxy_name if isinstance(proxy_name, str) else ''
   728	    allowed = {f'{name}-{m8}-{service}' for service in PEER_SERVICES}
   729	    sk = content.get('sk')
