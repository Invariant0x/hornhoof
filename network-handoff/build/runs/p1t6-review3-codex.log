   235	def _dash_get(path: str, cap: float = 0.5) -> tuple[int, bytes]:
   236	    """One dashboard read with a cap-second timeout; less when the plugin call's budget is nearly spent.
   237	
   238	    The watcher's own probes pass cap=1. Any error, timeout or a spent budget is FrpsUnknown.
   239	    """
   240	    parsed = urlsplit(RELAY_FRPS_API)
   241	    host = parsed.hostname or '127.0.0.1'
   242	    port = parsed.port or (443 if parsed.scheme == 'https' else 80)
   243	    kind = http.client.HTTPSConnection if parsed.scheme == 'https' else http.client.HTTPConnection
   244	    left = call_deadline()
   245	    if left is not None and left <= 0:
   246	        raise FrpsUnknown(f'{path}: plugin call budget spent')
   247	    connection = kind(host, port, timeout=cap if left is None else min(cap, left))
   248	    try:
   249	        token = base64.b64encode(f'{FRPS_USER}:{FRPS_PASSWORD}'.encode()).decode()
   250	        connection.request('GET', path, headers={'Authorization': f'Basic {token}'})
   251	        response = connection.getresponse()
   252	        return response.status, response.read()
   253	    except (OSError, http.client.HTTPException) as e:
   254	        raise FrpsUnknown(f'{path}: {type(e).__name__}') from None
   255	    finally:
   256	        connection.close()
