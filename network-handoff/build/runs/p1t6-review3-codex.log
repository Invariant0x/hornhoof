   429	    def test_newproxy_malformed_run_id_keeps_existing_route(self) -> None:
   430	        # I6 on a live route: the malformed NewProxy must refuse before any
   431	        # route lookup that could straighten the row. The row is set pending in
   432	        # SQLite (a registration frps has not shown yet): any route API read
   433	        # before validation would flip it back to held against the online frps
   434	        # route, so the row is inspected directly, with no route read in between.
   435	        client = self.stack.client('acme', self.key, settings='network', client='acme-3f2a9c1b-link')
   436	        self.assertTrue(client.started('acme'), client.log())
   437	        status, before = self.stack.api('GET', '/api/v1/links/acme/route', key=self.key)
   438	        self.assertEqual(status, 200, before)
   439	        self.assertEqual(before['state'], 'held')
   440	        row_before = self.route_row()
   441	        self.assertEqual(row_before[2], 'held')
   442	        with sqlite3.connect(self.stack.env['RELAY_DB']) as conn:
   443	            conn.execute("UPDATE routes SET state = 'pending' WHERE name = 'acme'")
   444	        answer = self.plugin_post('NewProxy', {
   445	            'user': {'user': '', 'metas': self.link_metas('acme-3f2a9c1b-link'), 'run_id': []},
   446	            'proxy_name': 'acme', 'proxy_type': 'http', 'subdomain': 'acme'})
   447	        self.assertEqual(answer, {'reject': True,
   448	                                  'reject_reason': 'this run id belongs to another client'})
   449	        row_after = self.route_row()
   450	        self.assertEqual(row_after[0], row_before[0], 'the malformed NewProxy moved the generation')
   451	        self.assertEqual(row_after[1], row_before[1], 'the malformed NewProxy moved the route client')
   452	        self.assertEqual(row_after[2], 'pending', 'a route read straightened the row before validation')
   453	        self.assertEqual(row_after[3], row_before[3], 'the malformed NewProxy moved the run id')
