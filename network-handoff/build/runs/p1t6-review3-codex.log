   663	def login_reason(name: str, kind: str, content: dict, metas: dict) -> str | None:
   664	    """R1.3: the client id fits the session; a live run id is this client's own.
   665	
   666	    Every non-empty run id is checked, a legacy login too (C1): frps would let it replace
   667	    the live session with that run id.
   668	    """
   669	    reason = malformed_id_reason(name, content, metas)
   670	    if reason is not None:
   671	        return reason
   672	    client_id = content.get('client_id') or ''
   673	    reason = client_id_reason(name, kind, client_id, metas.get('client'))
   674	    if reason is not None:
   675	        return reason
   676	    run_id = content.get('run_id')
   677	    if not isinstance(run_id, str) or not run_id:
   678	        return None
   679	    if run_id_recorded_elsewhere(run_id, name):
   680	        return 'this run id belongs to another client'
   681	    return run_id_conflict(run_id, client_id, name)
