from contextlib import closing
import gc
from pathlib import Path
import sqlite3
import sys
import tempfile
from types import SimpleNamespace
import warnings
sys.path.insert(0, 'relay/test')
from test_restart import RestartTests
with tempfile.TemporaryDirectory(prefix='hornhoof-warning-origin-') as tmp:
    database = str(Path(tmp) / 'relay.db')
    with closing(sqlite3.connect(database)) as conn:
        conn.execute('CREATE TABLE bindings (name TEXT, key_hash TEXT, created_at INTEGER, created_ip TEXT)')
        conn.commit()
    case = RestartTests()
    case.stack = SimpleNamespace(env={'RELAY_DB': database}, private=[])
    with warnings.catch_warnings(record=True) as observed:
        warnings.simplefilter('always', ResourceWarning)
        case.make_binding('acme')
        gc.collect()
    count = sum(issubclass(item.category, ResourceWarning) for item in observed)
    print('ResourceWarnings from unchanged RestartTests.make_binding:', count)
