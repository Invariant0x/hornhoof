+def release_binding(name: str) -> None:
+    """Drop a binding and its visitor credentials in one transaction (C2).
+
+    Separate deletes would let a concurrent visitor-key issuer plant a credential for the
+    name between them. The transaction takes the write lock within the same budget as a
+    single write(): past it, WriteBusy and the caller refuses instead of waiting.
+    """
+    conn = db()
+    left = call_deadline()
+    if left is not None and left <= 0:
+        raise WriteBusy('plugin call budget spent')
+    budget = 0.8 if left is None else min(0.8, left)
+    conn.execute(f'PRAGMA busy_timeout = {max(0, int(budget * 1000))}')
+    try:
+        conn.execute('BEGIN IMMEDIATE')
+        try:
+            write('DELETE FROM visitor_keys WHERE name = ?', (name,))
+            write('DELETE FROM bindings WHERE name = ?', (name,))
+            conn.execute('COMMIT')
+        except BaseException:
+            if conn.in_transaction:
+                conn.execute('ROLLBACK')
+            raise
+    except sqlite3.OperationalError as e:
+        if 'locked' in str(e):
+            raise WriteBusy(f'database is locked for {budget:.2f} s') from None
