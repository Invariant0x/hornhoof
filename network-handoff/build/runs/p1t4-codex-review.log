   120	def reserved_names() -> frozenset:
   121	    """The names on the Caddyfile's @reserved line, reread when the file changes."""
   122	    try:
   123	        mtime = os.stat(CADDYFILE).st_mtime
   124	    except OSError:
   125	        return _reserved['names']
   126	    if mtime != _reserved['mtime']:
   127	        names = set()
   128	        with open(CADDYFILE) as f:
   129	            for line in f:
   130	                parts = line.split()
   131	                if parts[:2] == ['@reserved', 'host']:
   132	                    names.update(h[: -len('.' + DOMAIN)] for h in parts[2:] if h.endswith('.' + DOMAIN))
   133	        _reserved.update(mtime=mtime, names=frozenset(names))
   134	    return _reserved['names']
