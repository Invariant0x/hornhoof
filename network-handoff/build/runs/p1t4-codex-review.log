   329	    def api(self, method: str, path: str, body: dict | None = None,
   330	            key: str | None = None) -> tuple[int, dict | None]:
   331	        headers = {}
   332	        if key is not None:
   333	            headers['Authorization'] = f'Bearer {key}'
   334	        payload = None
   335	        if body is not None:
   336	            payload = json.dumps(body).encode()
   337	            headers['Content-Type'] = 'application/json'
   338	        status, data = _request(self.relay_port, method, path, payload, headers)
   339	        return status, json.loads(data) if data else None
