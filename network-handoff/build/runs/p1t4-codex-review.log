   275	def check_route_holder(name: str, row, status: str, client_id: str | None, proxy_type: str | None) -> None:
   276	    """An online route must match the relay's own record, else the answer is unknown, never empty (R2.3).
   277	
   278	    A missing row means the record was lost while frps holds the route: unknown too.
   279	    """
   280	    if status != 'online':
   281	        return
   282	    matches = (row is not None and proxy_type == row[3]
   283	               and client_id == (row[2] if row[1] == 'legacy' else row[1]))
   284	    if matches:
   285	        return
   286	    log_line(f'route of {name} is online outside the relay record')
   287	    raise FrpsUnknown(f'frps route of {name} does not match the relay record')
