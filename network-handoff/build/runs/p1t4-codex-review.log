   451	def proxy_check(name: str, content: dict) -> str | None:
   452	    """Today's NewProxy checks, then whether this registration may hold the name; None lets it through."""
   453	    if (content.get('user') or {}).get('user'):
   454	        return 'set no user in the tunnel config'
   455	    if content.get('proxy_type') != 'http':
   456	        return 'only http proxies are allowed'
   457	    if content.get('proxy_name') != name:
   458	        return f'the proxy must be named {name}'
   459	    if content.get('subdomain') != name:
   460	        return f'this key serves only {name}.{DOMAIN}'
   461	    if content.get('custom_domains'):
   462	        return 'custom domains are not allowed'
   463	    reason = shared_route_fields(content)
   464	    if reason is not None:
   465	        return reason
   466	    return register_route(name, content)
