   238	def dash_answer(name: str, proxy_type: str) -> tuple[str, str] | None:
   239	    """One proxy type's dashboard record: (status, clientID), None on 404, FrpsUnknown otherwise.
   240	
   241	    A record is trusted only with a status of online or offline and a non-empty clientID:
   242	    a missing field reads as unknown, never as empty.
   243	    """
   244	    status, body = _dash_get(f'/api/proxy/{proxy_type}/{name}')
   245	    if status == 404:
   246	        return None
   247	    if status != 200:
   248	        raise FrpsUnknown(f'dashboard answered {status} for {proxy_type} {name}')
   249	    try:
   250	        answer = json.loads(body)
   251	        route_status = answer['status']
   252	        client_id = answer['clientID']
   253	    except (ValueError, KeyError, TypeError):
   254	        raise FrpsUnknown(f'dashboard body for {proxy_type} {name} has no route record') from None
   255	    if route_status not in ('online', 'offline') or not isinstance(client_id, str) or not client_id:
   256	        raise FrpsUnknown(f'dashboard body for {proxy_type} {name} is not a route record')
   257	    return route_status, client_id
   258	
   259	
   260	def frps_route(name: str) -> tuple[str, str | None, str | None]:
   261	    """frps's own view of a name's route: ('online'|'offline', clientID, type), or ('absent', None, None).
   262	
   263	    Both proxy types are read: a name holds one route of either type, and two records is unknown.
   264	    """
   265	    http = dash_answer(name, 'http')
   266	    https = dash_answer(name, 'https')
   267	    if http is not None and https is not None:
   268	        raise FrpsUnknown(f'dashboard shows both http and https routes for {name}')
   269	    for proxy_type, answer in (('http', http), ('https', https)):
   270	        if answer is not None:
   271	            return answer[0], answer[1], proxy_type
   272	    return 'absent', None, None
   273	
