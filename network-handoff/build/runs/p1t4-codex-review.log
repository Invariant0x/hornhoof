   166	    def _free_port(self):
   167	        while True:
   168	            with socket.socket() as listener:
   169	                listener.bind(('127.0.0.1', 0))
   170	                port = listener.getsockname()[1]
   171	            if port not in self._ports:
   172	                self._ports.add(port)
   173	                return port
