    71	class _Process:
    72	    def __init__(self, command, log_path, *, env=None, private=()):
    73	        self.log_path = Path(log_path)
    74	        self.private = private
    75	        self.output = self.log_path.open('wb')
    76	        try:
    77	            self.process = subprocess.Popen(
    78	                command, cwd=ROOT, env=env, stdin=subprocess.DEVNULL,
    79	                stdout=self.output, stderr=subprocess.STDOUT,
    80	            )
    81	        except BaseException:
    82	            self.output.close()
    83	            raise
    84	
    85	    def log(self) -> str:
    86	        text = self.log_path.read_text(encoding='utf-8', errors='replace')
    87	        for value in self.private:
    88	            if value:
    89	                text = text.replace(value, '[hidden]')
    90	        return text
    91	
    92	    def resume(self):
    93	        if self.process.poll() is None:
    94	            self.process.send_signal(signal.SIGCONT)
    95	
    96	    def pause(self):
    97	        if self.process.poll() is None:
    98	            self.process.send_signal(signal.SIGSTOP)
    99	
   100	    def _finish(self, *, kill):
   101	        try:
   102	            if self.process.poll() is None:
   103	                self.resume()
   104	                if kill:
   105	                    self.process.kill()
   106	                else:
   107	                    self.process.terminate()
   108	                try:
   109	                    self.process.wait(timeout=5)
   110	                except subprocess.TimeoutExpired:
   111	                    self.process.kill()
   112	                    self.process.wait(timeout=5)
   113	            else:
   114	                self.process.wait()
   115	        finally:
   116	            self.output.close()
   117	
   118	    def stop(self):
   119	        self._finish(kill=False)
   120	
   121	    def kill(self):
   122	        self._finish(kill=True)
