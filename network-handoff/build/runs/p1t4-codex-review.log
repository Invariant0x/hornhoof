   351	    def plugin_calls(self) -> list[dict]:
   352	        calls = []
   353	        for line in self.relay.log().splitlines():
   354	            try:
   355	                value = json.loads(line.removeprefix('TRACE '))
   356	            except ValueError:
   357	                continue
   358	            if isinstance(value, dict) and 'op' in value:
   359	                calls.append(value)
   360	        return calls

