    22	    def route(self, binding: dict) -> tuple[int, dict | None]:
    23	        return self.stack.api('GET', f'/api/v1/links/{binding["name"]}/route', key=binding['key'])
    24	
    25	    def wait_route(self, binding: dict, state: str, generation: int, within: float) -> dict:
    26	        deadline = time.monotonic() + within
    27	        while True:
    28	            status, body = self.route(binding)
    29	            if status == 200 and body['state'] == state and body['generation'] == generation:
    30	                return body
    31	            remaining = deadline - time.monotonic()
    32	            self.assertGreater(remaining, 0, f'no {state} at generation {generation}: {status} {body}')
    33	            time.sleep(0.2)
    34	
    35	    def wait_health(self, status: int, within: float) -> dict:
    36	        deadline = time.monotonic() + within
    37	        while True:
    38	            current, body = self.stack.api('GET', '/api/v1/health')
    39	            if current == status:
    40	                return body
    41	            remaining = deadline - time.monotonic()
    42	            self.assertGreater(remaining, 0, f'health stayed {current}: {body}')
    43	            time.sleep(0.1)
    44	
    45	    def make_binding(self, name: str) -> dict:
    46	        """A binding written straight into the relay's database: the API's per-address limit
    47	        would stop 40 creations from one address."""
    48	        key = secrets.token_urlsafe(32)
    49	        digest = hashlib.sha256(key.encode()).hexdigest()
    50	        with sqlite3.connect(self.stack.env['RELAY_DB'], timeout=10) as conn:
    51	            conn.execute('INSERT INTO bindings (name, key_hash, created_at, created_ip) VALUES (?, ?, ?, ?)',
    52	                         (name, digest, int(time.time()), 'test'))
    53	        self.stack.private.append(key)
    54	        return {'name': name, 'key': key}
