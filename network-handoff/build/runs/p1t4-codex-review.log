   528	def frpc_config(name: str, key: str) -> str:
   529	    return f'''# Hornhoof relay tunnel for https://{name}.{DOMAIN}
   530	# Keep this file secret: it holds the key of the binding.
   531	serverAddr = "{DOMAIN}"
   532	serverPort = 443
   533	loginFailExit = false
   534	log.to = "console"
   535	log.level = "info"
   536	log.disablePrintColor = true
   537	transport.protocol = "wss"
   538	transport.tls.trustedCaFile = "/etc/ssl/certs/ca-certificates.crt"
   539	transport.heartbeatInterval = 30
   540	transport.heartbeatTimeout = 90
   541	metadatas.name = "{name}"
   542	metadatas.key = "{key}"
   543	
   544	[[proxies]]
   545	name = "{name}"
   546	type = "http"
   547	subdomain = "{name}"
   548	localIP = "{TARGET_HOST}"
   549	localPort = {TARGET_PORT}
   550	# frps speaks plain http to the tunnel; the visitor came over https.
   551	requestHeaders.set.x-forwarded-proto = "https"
   552	'''
