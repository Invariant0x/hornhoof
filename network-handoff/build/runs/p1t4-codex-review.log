   281	    def client(self, name: str, key: str | None, *, settings: str = 'today',
   282	               client: str | None = None, proxies: str | None = None,
   283	               visitor_key: str | None = None) -> Client:
   284	        if settings not in {'today', 'network'}:
   285	            raise ValueError('Unknown client settings')
   286	        config = [
   287	            'serverAddr = "127.0.0.1"', f'serverPort = {self.bind_port}',
   288	            'loginFailExit = false', 'log.to = "console"', 'log.level = "info"',
   289	            'log.disablePrintColor = true', 'transport.protocol = "websocket"',
   290	        ]
   291	        if settings == 'today':
   292	            config.extend(['transport.heartbeatInterval = 30', 'transport.heartbeatTimeout = 90'])
   293	        else:
   294	            config.extend(['transport.heartbeatInterval = -1', 'transport.tcpMuxKeepaliveInterval = 10'])
   295	        if client is not None:
   296	            config.extend([f'clientID = {json.dumps(client)}', f'metadatas.client = {json.dumps(client)}'])
   297	        config.append(f'metadatas.name = {json.dumps(name)}')
   298	        if key is not None:
   299	            config.append(f'metadatas.key = {json.dumps(key)}')
   300	            self.private.append(key)
   301	        if visitor_key is not None:
   302	            config.append(f'metadatas.visitor = {json.dumps(visitor_key)}')
   303	            self.private.append(visitor_key)
   304	        if proxies is None:
   305	            proxies = f'''
   306	[[proxies]]
   307	name = {json.dumps(name)}
   308	type = "http"
   309	subdomain = {json.dumps(name)}
   310	localIP = "127.0.0.1"
   311	localPort = {self.echo_port}
   312	requestHeaders.set.x-forwarded-proto = "https"
   313	'''
   314	        config.append(proxies)
   315	        number = len(self.clients)
   316	        config_path = self.tmp / f'frpc-{number}.toml'
   317	        self._write_config(config_path, '\n'.join(config) + '\n')
   318	        process = Client(
   319	            [str(BIN / 'frpc'), '-c', str(config_path)], self.tmp / f'frpc-{number}.log',
   320	            private=self.private,
   321	        )
   322	        self.clients.append(process)
   323	        return process
