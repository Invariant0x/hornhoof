   274	    def bind(self, name: str | None = None) -> dict:
   275	        status, body = self.api('POST', '/api/v1/bindings', {} if name is None else {'name': name})
   276	        if status != 201 or not isinstance(body, dict):
   277	            raise AssertionError(f'Binding failed with HTTP {status}')
   278	        self.private.append(body['key'])
   279	        return body
