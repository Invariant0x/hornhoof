[Unit]
Description=frps for the Hornhoof relay
After=network.target hornhoof-relay.service
Wants=hornhoof-relay.service

[Service]
User=frps
Group=frps
ExecStart=/usr/local/bin/frps -c /etc/frp/frps.toml
# systemd owns /run/frps; the relay reads the file to know when frps last started.
RuntimeDirectory=frps
RuntimeDirectoryMode=0755
ExecStartPost=/bin/sh -c 'date +%%s > /run/frps/started'
Restart=always
RestartSec=2
LimitNOFILE=1048576
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
[Unit]
Description=Hornhoof relay: link API and frps plugin
After=network.target

[Service]
User=hornhoof-relay
Group=hornhoof-relay
EnvironmentFile=/etc/hornhoof-relay.env
ExecStart=/usr/bin/python3 /usr/local/lib/hornhoof-relay/relay.py
StateDirectory=hornhoof-relay
StateDirectoryMode=0700
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=200M

[Install]
WantedBy=multi-user.target
