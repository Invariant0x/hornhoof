   502	class Window:
   503	    """Counts events per key in a sliding window, in memory."""
   504	
   505	    def __init__(self, limit: int, seconds: int):
   506	        self.limit, self.seconds, self.hits, self.lock = limit, seconds, {}, threading.Lock()
   507	
   508	    def allow(self, key: str) -> int:
   509	        """0 if allowed (and counted), else seconds to wait."""
   510	        t = time.time()
   511	        with self.lock:
   512	            if len(self.hits) > 50000:
   513	                self.hits = {k: v for k, v in self.hits.items() if v and v[-1] > t - self.seconds}
   514	            recent = [x for x in self.hits.get(key, []) if x > t - self.seconds]
   515	            if len(recent) >= self.limit:
   516	                self.hits[key] = recent
   517	                return int(recent[0] + self.seconds - t) + 1
   518	            recent.append(t)
   519	            self.hits[key] = recent
   520	            return 0
   521	
