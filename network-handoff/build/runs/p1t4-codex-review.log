   194	    def close(self):
   195	        # ExitStack runs every cleanup even if one process fails to stop.
   196	        with ExitStack() as cleanup:
   197	            if self.echo is not None:
   198	                cleanup.callback(self.echo.server_close)
   199	                if self.echo_thread is not None and self.echo_thread.ident is not None:
   200	                    cleanup.callback(self.echo_thread.join, timeout=5)
   201	                    cleanup.callback(self.echo.shutdown)
   202	            if self.relay is not None:
   203	                cleanup.callback(self.relay.stop)
   204	            if self.frps is not None:
   205	                cleanup.callback(self.frps.stop)
   206	            for client in self.clients:
   207	                cleanup.callback(client.stop)
