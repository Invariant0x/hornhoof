   400	def register_route(name: str, content: dict) -> str | None:
   401	    """Record a registration the plugin let through; a reason when the name cannot be taken (R1.1)."""
   402	    user = content.get('user') or {}
   403	    if not hold_route_lock(name):
   404	        return 'relay error: frps does not answer'
   405	    try:
   406	        return register_locked(name, content, user)
   407	    finally:
   408	        route_lock(name).release()
   409	
   410	
   411	def register_locked(name: str, content: dict, user: dict) -> str | None:
   412	    """The locked half of register_route: refuse a held name, else record the registration."""
   413	    try:
   414	        held = locked_route_of(name)['state'] == 'held'
   415	    except FrpsUnknown:
   416	        return 'relay error: frps does not answer'
   417	    except WriteBusy:
   418	        return 'relay error: busy'
   419	    if held:
   420	        return f'router config conflict: {name} is held'
   421	    return upsert_route(name, content, user)
   422	
   423	
   424	def upsert_route(name: str, content: dict, user: dict) -> str | None:
   425	    """Write the pending row for a let-through registration; a refusal when the write cannot land."""
   426	    row = db().execute('SELECT generation FROM routes WHERE name = ?', (name,)).fetchone()
   427	    generation = (row[0] if row else 0) + 1
   428	    metas = user.get('metas') or {}
   429	    try:
   430	        write(
   431	            'INSERT INTO routes (name, generation, client, run_id, type, state, since) VALUES (?, ?, ?, ?, ?, ?, ?) '
   432	            'ON CONFLICT(name) DO UPDATE SET generation = excluded.generation, client = excluded.client, '
   433	            'run_id = excluded.run_id, type = excluded.type, state = excluded.state, since = excluded.since',
   434	            (name, generation, metas.get('client') or 'legacy', user.get('run_id') or '',
   435	             content.get('proxy_type') or 'http', 'pending', now()))
   436	    except WriteBusy:
   437	        return 'relay error: busy'
   438	    except sqlite3.Error:
   439	        return 'relay error: frps does not answer'
   440	    return None
   441	
