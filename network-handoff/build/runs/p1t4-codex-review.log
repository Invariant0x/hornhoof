   620	class Handler(BaseHTTPRequestHandler):
   621	    server_version = 'hornhoof-relay'
   622	    sys_version = ''
   623	    protocol_version = 'HTTP/1.1'
   624	
   625	    def log_message(self, fmt, *args):
   626	        pass
   627	
   628	    def client_ip(self) -> str:
   629	        fwd = self.headers.get('X-Forwarded-For')
   630	        return fwd.split(',')[0].strip() if fwd else self.client_address[0]
   631	
   632	    def send_json(self, status: int, body=None, headers=None) -> None:
   633	        data = b'' if body is None else json.dumps(body).encode()
   634	        self.send_response(status)
   635	        if body is not None:
   636	            self.send_header('Content-Type', 'application/json')
   637	        self.send_header('Content-Length', str(len(data)))
   638	        self.send_header('Cache-Control', 'no-store')
   639	        for k, v in (headers or {}).items():
   640	            self.send_header(k, v)
   641	        self.end_headers()
   642	        self.wfile.write(data)
   643	
   644	    def error(self, status: int, code: str, message: str, headers=None) -> None:
   645	        self.send_json(status, {'error': code, 'message': message}, headers)
   646	
   647	    def read_json(self):
   648	        length = int(self.headers.get('Content-Length') or 0)
   649	        if length > MAX_BODY:
   650	            raise ValueError('body too large')
   651	        raw = self.rfile.read(length) if length else b''
   652	        return json.loads(raw) if raw.strip() else {}
   653	
   654	    def path_parts(self):
   655	        return [p for p in self.path.split('?', 1)[0].split('/') if p]
   656	
   657	    def bearer_key(self) -> str:
   658	        auth = self.headers.get('Authorization') or ''
   659	        return auth[7:].strip() if auth.lower().startswith('bearer ') else ''
   660	
   661	    def wrong_key(self, ip: str):
   662	        """The 401 for a bad key, counted like DELETE; 429 once an address passes 30 bad keys in an hour."""
   663	        wait = bad_keys.allow(ip)
   664	        if wait:
   665	            return self.error(429, 'rate_limited', 'Too many wrong keys, try again later.', {'Retry-After': str(wait)})
   666	        return self.error(401, 'unauthorized', 'Send the binding key as Authorization: Bearer <key>.')
   667	
   668	    def do_GET(self):
   669	        parts = self.path_parts()
   670	        if parts[:3] == ['api', 'v1', 'names'] and len(parts) == 4:
   671	            return self.name_answer(parts[3].lower())
   672	        if parts[:3] == ['api', 'v1', 'links'] and len(parts) == 5 and parts[4] == 'route':
   673	            return self.route_answer(parts[3].lower())
   674	        if parts == ['api', 'v1', 'health']:
   675	            return self.health_answer()
   676	        self.error(404, 'not_found', 'Not found.')
   677	
   678	    def name_answer(self, name: str):
   679	        wait = name_checks.allow(self.client_ip())
   680	        if wait:
   681	            return self.error(429, 'rate_limited', 'Too many checks, try again later.', {'Retry-After': str(wait)})
   682	        reason = check_name(name)
   683	        body = {'name': name, 'free': reason is None}
   684	        if reason:
   685	            body['reason'] = reason
   686	        return self.send_json(200, body)
   687	
   688	    def route_answer(self, name: str):
   689	        """GET /api/v1/links/<name>/route: who holds the name (R2.1), never a guess (R2.3)."""
   690	        row = db().execute('SELECT key_hash FROM bindings WHERE name = ?', (name,)).fetchone()
   691	        if row is None:
   692	            return self.error(404, 'not_found', f'There is no binding {name}.')
   693	        key = self.bearer_key()
   694	        if not key or not hmac.compare_digest(row[0], key_hash(key)):
   695	            return self.wrong_key(self.client_ip())
   696	        try:
   697	            return self.send_json(200, route_of(name))
   698	        except (FrpsUnknown, WriteBusy):
   699	            return self.error(503, 'unknown', 'The relay cannot tell whether the route is live.')
   700	
   701	    def health_answer(self):
   702	        """GET /api/v1/health (R4.1): 200 only while frps takes logins, else 503; never a guess."""
   703	        if frps_ok():
   704	            return self.send_json(200, {'ok': True, 'frps': True, 'relayStarted': relay_started()})
   705	        return self.send_json(503, {'ok': False, 'frps': False})
   706	
   707	    def handle_plugin(self):
   708	        # frps only: Caddy never routes /frp/ here and always adds X-Forwarded-For.
   709	        if self.headers.get('X-Forwarded-For') or self.client_address[0] != '127.0.0.1':
