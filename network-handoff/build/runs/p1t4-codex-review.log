   290	class WriteBusy(Exception):
   291	    """A SQLite write could not take the lock within its budget: refuse the op, never guess."""
   292	
   293	
   294	def write(sql: str, args: tuple) -> None:
   295	    """The one SQLite write of the plugin and the API.
   296	
   297	    SQLite itself retries database is locked for the write's budget (0.8 s, or the plugin
   298	    call's time left, whichever is less); past the budget the write raises WriteBusy and a
   299	    plugin call refuses with 'relay error: busy' (Review Focus 3).
   300	    """
   301	    conn = db()
   302	    left = call_deadline()
   303	    budget = 0.8 if left is None else min(0.8, left)
   304	    conn.execute(f'PRAGMA busy_timeout = {max(0, int(budget * 1000))}')
   305	    try:
   306	        conn.execute(sql, args)
   307	    except sqlite3.OperationalError as e:
   308	        if 'locked' in str(e):
   309	            raise WriteBusy(f'database is locked for {budget:.2f} s') from None
   310	        raise
   311	    finally:
   312	        conn.execute('PRAGMA busy_timeout = 10000')
   313	
   314	
   315	def straighten_route(name: str, row, status: str, t: int) -> None:
   316	    """Move the row to what frps shows; each UPDATE is guarded by the generation as read, so a row
   317	    rewritten since we read frps keeps its newer registration. The per-name lock is held.
   318	
   319	    A pending row younger than PENDING_S is a registration frps has not shown yet: it reads held
   320	    even when frps still shows the previous registration's offline record, because frps keeps that
   321	    record until the new one shows. Only an online record turns it held, age or absence empties it.
   322	    """
   323	    state, generation = row[4], row[0]
   324	    if status == 'online':
   325	        write("UPDATE routes SET state = 'held' WHERE name = ? AND generation = ? "
   326	              "AND state IN ('pending', 'empty')", (name, generation))
   327	    elif state == 'held':
   328	        write("UPDATE routes SET state = 'empty', since = ? WHERE name = ? AND generation = ? "
   329	              "AND state = 'held'", (t, name, generation))
   330	    elif state == 'pending' and t - row[5] > PENDING_S:
   331	        write("UPDATE routes SET state = 'empty', since = ? WHERE name = ? AND generation = ? "
   332	              "AND state = 'pending'", (t, name, generation))
   333	
   334	
   335	def route_body(name: str, row) -> dict:
   336	    """The R2.1 answer from a routes row; a name with no row is empty at generation 0."""
   337	    if row is None:
   338	        binding = db().execute('SELECT created_at FROM bindings WHERE name = ?', (name,)).fetchone()
   339	        since = binding[0] if binding else None
   340	        state, client, generation = 'empty', None, 0
   341	    else:
   342	        since = row[5]
   343	        state = 'empty' if row[4] == 'empty' else 'held'
   344	        client = row[1] if state == 'held' else None
   345	        generation = row[0]
   346	    return {'state': state, 'client': client, 'since': since, 'generation': generation,
   347	            'relayStarted': relay_started(), 'evictionBound': EVICTION_BOUND_S, 'sync': None}
   348	
   349	
   350	def locked_route_of(name: str) -> dict:
   351	    """The R2.1 body with the per-name lock already held: the row straightened against frps."""
   352	    status, client_id, proxy_type = frps_route(name)
   353	    row = db().execute('SELECT generation, client, run_id, type, state, since FROM routes WHERE name = ?',
   354	                       (name,)).fetchone()
   355	    if row is not None:
   356	        check_route_holder(name, row, status, client_id, proxy_type)
   357	        try:
   358	            straighten_route(name, row, status, now())
   359	        except sqlite3.Error as e:
   360	            raise FrpsUnknown(f'route store is not writable: {type(e).__name__}') from None
   361	        row = db().execute('SELECT generation, client, run_id, type, state, since FROM routes WHERE name = ?',
   362	                           (name,)).fetchone()
   363	    else:
   364	        check_route_holder(name, None, status, client_id, proxy_type)
   365	    return route_body(name, row)
   366	
   367	
   368	def route_of(name: str) -> dict:
   369	    """The R2.1 body for a name: the routes row straightened against what frps shows right now.
   370	
   371	    The per-name lock serializes every read-and-straighten against registrations.
   372	    """
   373	    with route_lock(name):
   374	        return locked_route_of(name)
   375	
   376	
   377	_route_locks_guard = threading.Lock()
   378	_route_locks: dict[str, threading.Lock] = {}
   379	
   380	
   381	def route_lock(name: str) -> threading.Lock:
   382	    with _route_locks_guard:
   383	        lock = _route_locks.get(name)
   384	        if lock is None:
   385	            lock = threading.Lock()
   386	            _route_locks[name] = lock
   387	    return lock
   388	
   389	
   390	def hold_route_lock(name: str) -> bool:
   391	    """Take the per-name lock within the plugin call's remaining budget; False when the budget ran out."""
   392	    lock = route_lock(name)
   393	    left = call_deadline()
   394	    if left is None:
   395	        lock.acquire()
   396	        return True
   397	    return left > 0 and lock.acquire(timeout=left)
