   443	def shared_route_fields(content: dict) -> str | None:
   444	    """R1.2: a name is one company's one route, never shared or split across locations or users."""
   445	    for field in ('locations', 'route_by_http_user', 'group'):
   446	        if content.get(field):
   447	            return f'{field} is not allowed'
   448	    return None
