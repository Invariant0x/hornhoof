   248	            if key in replacements:
   249	                line = f'{key} = {replacements[key]}'
   250	            lines.append(line.replace('@WEB_PASSWORD@', self.password))
   251	        config_path = self.tmp / 'frps.toml'
   252	        self._write_config(config_path, '\n'.join(lines) + '\n')
   253	        Path(self.env['RELAY_FRPS_STARTED']).write_text(str(int(time.time())))
   254	        self.frps = _Process(
   255	            [str(BIN / 'frps'), '-c', str(config_path)], self.tmp / 'frps.log',
   256	            private=self.private,
   257	        )
   258	        self._ready(self.frps, self.dash_port, '/healthz')
