   341	    def dash(self, path: str) -> tuple[int, object]:
   342	        auth = base64.b64encode(f'admin:{self.password}'.encode()).decode()
   343	        status, data = _request(self.dash_port, 'GET', path, headers={'Authorization': f'Basic {auth}'})
   344	        if not data:
   345	            return status, None
   346	        try:
   347	            return status, json.loads(data)
   348	        except ValueError:
   349	            return status, data.decode('utf-8', errors='replace')
