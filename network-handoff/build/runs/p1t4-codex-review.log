   570	def binding_ok(name: str, key: str):
   571	    """None if the name exists, is not banned and the key matches, else a reason."""
   572	    if not isinstance(name, str) or not isinstance(key, str) or not name or not key:
   573	        return 'this tunnel has no Hornhoof relay binding (metadatas.name and metadatas.key)'
   574	    row = db().execute('SELECT key_hash, banned_at FROM bindings WHERE name = ?', (name,)).fetchone()
   575	    if row is None or not hmac.compare_digest(row[0], key_hash(key)):
   576	        return f'no binding {name} with this key'
   577	    if row[1]:
   578	        return f'{name}.{DOMAIN} is blocked'
   579	    return None
   580	
   581	
   582	_seen = {}
   583	
   584	
   585	def touch(name: str) -> None:
   586	    t = now()
   587	    if t - _seen.get(name, 0) <= 600:
   588	        return
   589	    try:
   590	        write('UPDATE bindings SET last_seen = ? WHERE name = ?', (t, name))
   591	    except WriteBusy:
   592	        return  # the next plugin call tries the touch again
   593	    _seen[name] = t
   594	
   595	
   596	def plugin(op: str, content: dict) -> dict:
   597	    """One plugin call gets one 1 s budget; a spent budget refuses the op, fail closed (Review Focus 3)."""
   598	    call_state.end = time.monotonic() + PLUGIN_CALL_S
   599	    try:
   600	        return plugin_decide(op, content)
   601	    finally:
   602	        call_state.end = None
   603	
   604	
   605	def plugin_decide(op: str, content: dict) -> dict:
   606	    if op == 'Login':
   607	        metas = content.get('metas') or {}
   608	    else:
   609	        metas = (content.get('user') or {}).get('metas') or {}
   610	    name, key = metas.get('name'), metas.get('key')
   611	    reason = binding_ok(name, key)
   612	    if reason is None and op == 'NewProxy':
   613	        reason = proxy_check(name, content)
   614	    if reason is not None:
   615	        return {'reject': True, 'reject_reason': reason}
   616	    touch(name)
   617	    return {'reject': False, 'unchange': True}
