   218	    """
   219	    parsed = urlsplit(RELAY_FRPS_API)
   220	    host = parsed.hostname or '127.0.0.1'
   221	    port = parsed.port or (443 if parsed.scheme == 'https' else 80)
   222	    kind = http.client.HTTPSConnection if parsed.scheme == 'https' else http.client.HTTPConnection
   223	    left = call_deadline()
   224	    if left is not None and left <= 0:
   225	        raise FrpsUnknown(f'{path}: plugin call budget spent')
   226	    connection = kind(host, port, timeout=0.5 if left is None else min(0.5, left))
   227	    try:
   228	        token = base64.b64encode(f'{FRPS_USER}:{FRPS_PASSWORD}'.encode()).decode()
   229	        connection.request('GET', path, headers={'Authorization': f'Basic {token}'})
   230	        response = connection.getresponse()
   231	        return response.status, response.read()
   232	    except (OSError, http.client.HTTPException) as e:
   233	        raise FrpsUnknown(f'{path}: {type(e).__name__}') from None
   234	    finally:
   235	        connection.close()
