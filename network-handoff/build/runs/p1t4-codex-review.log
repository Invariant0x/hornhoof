   136	class Stack:
   137	    def __init__(self, tmp: str, dashboard: bool = True):
   138	        self.tmp = Path(tmp)
   139	        self.tmp.mkdir(parents=True, exist_ok=True)
   140	        self.dashboard = dashboard
   141	        self.clients = []
   142	        self.relay = None
   143	        self.frps = None
   144	        self.echo = None
   145	        self.echo_thread = None
   146	        self.password = secrets.token_hex(24)
   147	        self.private = [self.password]
   148	        self._ports = set()
   149	        self.relay_port = self._free_port()
   150	        self.bind_port = self._free_port()
   151	        self.vhost_port = self._free_port()
   152	        self.dash_port = self._free_port()
   153	        self.api_port = self.dash_port if dashboard else self._free_port()
   154	        self.env = dict(os.environ, **{
   155	            'RELAY_DB': str(self.tmp / 'relay.db'),
   156	            'RELAY_PORT': str(self.relay_port),
   157	            'RELAY_CADDYFILE': str(self.tmp / 'Caddyfile'),
   158	            'RELAY_TRACE': '1',
   159	            'RELAY_FRPS_API': f'http://127.0.0.1:{self.api_port}',
   160	            'RELAY_FRPS_USER': 'admin',
   161	            'RELAY_FRPS_PASSWORD': self.password,
   162	            'RELAY_FRPS_BIND': f'127.0.0.1:{self.bind_port}',
   163	            'RELAY_FRPS_STARTED': str(self.tmp / 'frps-started'),
   164	        })
