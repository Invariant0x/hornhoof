   268	    @staticmethod
   269	    def _write_config(path, text):
   270	        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
   271	        with os.fdopen(descriptor, 'w', encoding='utf-8') as output:
   272	            output.write(text)
