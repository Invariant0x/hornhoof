import json
import pathlib
import unittest
from relay.test.test_peers import NativeLoginTakeoverTests, VisitorKeyDiagnosticTests
cases = [
    (NativeLoginTakeoverTests, 'test_wire_legacy_reserved_identity_absent_refused', 'a legacy login reserved an absent network identity'),
    (NativeLoginTakeoverTests, 'test_wire_legacy_reserved_identity_offline_refused', 'a legacy login reserved an offline network identity'),
    (NativeLoginTakeoverTests, 'test_wire_genuine_legacy_absent_and_offline_reconnect_kept', None),
    (VisitorKeyDiagnosticTests, 'test_api_release_diagnostic_hides_visitor_key', 'the captured lifecycle failure rendered a visitor key'),
    (VisitorKeyDiagnosticTests, 'test_admin_release_diagnostic_hides_visitor_key', 'the captured lifecycle failure rendered a visitor key'),
]
summary = []
for cls, name, expected in cases:
    result = unittest.TestResult()
    cls(name).run(result)
    expected_assertion = (not result.failures if expected is None else
                          len(result.failures) == 1 and expected in result.failures[0][1])
    row = {'case': name, 'tests': result.testsRun, 'failures': len(result.failures),
           'errors': len(result.errors), 'expected_assertion': expected_assertion}
