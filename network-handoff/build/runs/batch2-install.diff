 has() { case " $* " in *" $WORD "*) return 0 ;; esac; return 1; }
 # STUB_NODE_RUNNING is the image the server's built-in node runs now; STUB_IMAGE_IDS words are "ref=id" for tags that
 # point at the same image.
 id_of() {
   for w in ${STUB_IMAGE_IDS:-}; do [ "${w%%=*}" = "$1" ] && { printf '%s\n' "${w#*=}"; return; }; done
   printf 'id-%s\n' "$1"
 }
+# The services a "compose ... up" names: nothing when it starts them all.
+up_services() {
+  while [ $# -gt 0 ] && [ "$1" != up ]; do shift; done
+  [ $# -gt 0 ] && shift
+  for word in "$@"; do case "$word" in -*) ;; *) printf '%s ' "$word" ;; esac; done
+}
+# STUB_MIGRATE=fail: compose runs migrate first for every up that starts the app, and migrate fails.
+migrate_runs() {
+  case " $(up_services "$@") " in '  ' | *' app '*) ;; *) return 0 ;; esac
+  if [ "${STUB_MIGRATE:-}" = fail ]; then echo "service \"migrate\" didn't complete successfully: exit 1" >&2; exit 1; fi
+}
 case "$1" in
   info) echo "Server Version: 28.0.0" ;;
   pull) [ "${STUB_PULL:-ok}" = fail ] && { echo "pull access denied" >&2; exit 1; } ;;
   create) echo cid-app ;;
   cp) case "$2" in *:/app/compose.yaml) echo 'services: {}' > "$3" ;; esac ;;
   image)
     if [ "${2:-}" = inspect ] && [ "${3:-}" = --format ]; then
       [ -n "${STUB_NODE_RUNNING:-}${STUB_IMAGE_IDS:-}" ] || exit 1
       id_of "${!#}"
     else
       [ "${STUB_IMAGE_LOCAL:-0}" = 1 ] || exit 1
     fi ;;
   inspect) [ "${!#}" = nodecid ] && [ -n "${STUB_NODE_RUNNING:-}" ] && id_of "$STUB_NODE_RUNNING" ;;
   # STUB_CONTAINERS words are "name" or "name=server", the server label of a node.
   # The server's own command line in its container: STUB_SETUP_LINK is the setup link of a server not set up yet.
   compose)
