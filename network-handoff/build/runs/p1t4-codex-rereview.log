   439	    def _refuse_in_worker(self, hold_s: float) -> tuple[list, float]:
   440	        """Run one real NewProxy plugin call on a worker thread while this thread holds the lock
   441	        for hold_s seconds; return (results, seconds from the call's start to its answer)."""
   442	        lock = self.relay.route_lock('acme')
   443	        lock.acquire()
   444	        entered = threading.Event()
   445	        result = []
   446	
   447	        def run():
   448	            entered.set()
   449	            result.append(self.relay.plugin('NewProxy', self._newproxy_content('acme', 'k', 'acme-c1-link')))
   450	
   451	        worker = threading.Thread(target=run)
   452	        worker.start()
   453	        self.assertTrue(entered.wait(timeout=5))
   454	        started = time.monotonic()
   455	        timer = threading.Timer(hold_s, lock.release)
   456	        timer.start()
   457	        try:
   458	            worker.join(timeout=8)
   459	            elapsed = time.monotonic() - started
   460	        finally:
   461	            timer.cancel()
   462	            _release_lock(lock)
   463	        self.assertFalse(worker.is_alive(), 'plugin call outlived its 1 s budget')
   464	        return result, elapsed
   465	
   466	    def test_newproxy_call_is_refused_within_one_second(self):
   467	        # A registration waiting behind a slow route read must not wait it out (Review Focus 3):
   468	        # one plugin call gets one 1 s budget, and a lock that cannot be taken in time refuses.
   469	        self._bind('acme', 'k')
   470	        result, elapsed = self._refuse_in_worker(2.0)
   471	        self.assertLess(elapsed, 1.1, f'refusal took {elapsed:.2f} s')
   472	        self.assertEqual(result[-1], {'reject': True, 'reject_reason': 'relay error: frps does not answer'})
   473	
   474	    def test_newproxy_read_uses_the_time_left_after_waiting_for_the_lock(self):
   475	        # After waiting for the lock, a dashboard read may use only the budget left:
   476	        # 0.7 s waiting + a 0.3 s read cap against a 0.6 s dashboard refuses within 1 s.
   477	        self._bind('acme', 'k')
