     1	# Writes one private file, atomically. Sourced by setup-relay.sh.
     2	# Usage: write_private <dest> <mode> [group]   (content on stdin)
     3	# The destination ends with <mode> (root:<group> when a group is given). Prints "changed"
     4	# when the content replaced the destination, "unchanged" when the old file was kept.
     5	write_private() {
     6	  dest=$1
     7	  mode=$2
     8	  group=${3:-}
     9	  tmp=$dest.new
    10	  rm -f "$tmp"
    11	  # The temp file is created already private, so a secret is never readable by others,
    12	  # not even for a moment while the content arrives.
    13	  ( umask 077 && : > "$tmp" ) || return 1
    14	  cat > "$tmp" || return 1
    15	  if [ -n "$group" ]; then
    16	    chgrp "$group" "$tmp" || return 1
    17	  fi
    18	  chmod "$mode" "$tmp" || return 1
    19	  if [ -f "$dest" ] && cmp -s "$tmp" "$dest"; then
    20	    rm -f "$tmp"
    21	    echo unchanged
    22	  else
    23	    mv -f "$tmp" "$dest"
    24	    echo changed
    25	  fi
    26	}
