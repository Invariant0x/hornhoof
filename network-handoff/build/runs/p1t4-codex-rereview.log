    17	def start_write_private(dest: Path, mode: str, group: str | None = None) -> subprocess.Popen:
    18	    """Start write_private on a pipe the test controls; the caller writes the content."""
    19	    command = ['sh', '-c', '. "$1"; shift; write_private "$@"', 'write_private',
    20	               str(HELPER), str(dest), mode] + ([group] if group else [])
    21	    return subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
    22	                            stderr=subprocess.PIPE, text=True)
    23	
    24	
    25	def finish(process: subprocess.Popen) -> tuple[int, str, str]:
    26	    out, err = process.stdout.read(), process.stderr.read()
    27	    process.stdout.close()
    28	    process.stderr.close()
    29	    return process.wait(timeout=5), out.strip(), err
