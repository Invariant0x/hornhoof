   422	    def test_young_pending_reads_held_against_an_offline_record(self):
   423	        # R1.1: frps keeps the previous registration's offline record until the new one shows,
   424	        # so an offline record must not empty a pending row younger than PENDING_S, or two
   425	        # racing registrations would both get through.
   426	        t = self.relay.now()
   427	        self.relay.db().execute("INSERT INTO routes (name, generation, client, run_id, type, state, since) "
   428	                                "VALUES ('acme', 1, 'acme-c1-link', 'r1', 'http', 'pending', ?)", (t,))
   429	        self.server.records['/api/proxy/http/acme'] = _record(200, {'status': 'offline', 'clientID': 'acme-c0-link'})
   430	        body = self.relay.route_of('acme')
   431	        self.assertEqual(body['state'], 'held')
   432	        self.assertEqual(body['generation'], 1)
   433	        self._bind('acme', 'k')
   434	        reason = self.relay.plugin('NewProxy', self._newproxy_content('acme', 'k', 'acme-c2-link'))
   435	        self.assertEqual(reason, {'reject': True, 'reject_reason': 'router config conflict: acme is held'})
   436	        row = self.relay.db().execute("SELECT generation, state FROM routes WHERE name = 'acme'").fetchone()
   437	        self.assertEqual((row[0], row[1]), (1, 'pending'))
