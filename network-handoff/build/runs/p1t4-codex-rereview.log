   595	def plugin(op: str, content: dict) -> dict:
   596	    """One plugin call gets one 1 s budget; a spent budget refuses the op, fail closed (Review Focus 3)."""
   597	    call_state.end = time.monotonic() + PLUGIN_CALL_S
   598	    try:
   599	        return plugin_decide(op, content)
   600	    except WriteBusy:
   601	        return {'reject': True, 'reject_reason': 'relay error: busy'}
   602	    finally:
   603	        call_state.end = None
