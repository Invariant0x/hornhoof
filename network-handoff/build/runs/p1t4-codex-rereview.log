   410	    def test_straighten_never_clears_a_fresher_generation(self):
   411	        # A straighten from a read taken before a newer registration landed in the same
   412	        # second must not clear that registration: every UPDATE is guarded by the
   413	        # generation (and state) as read, not by the second-resolution since.
   414	        t = self.relay.now()
   415	        self.relay.db().execute("INSERT INTO routes (name, generation, client, run_id, type, state, since) "
   416	                                "VALUES ('acme', 5, 'c1', 'r1', 'http', 'pending', ?)", (t,))
   417	        stale = (4, 'c0', 'r0', 'http', 'held', t)
   418	        self.relay.straighten_route('acme', stale, 'offline', t)
   419	        row = self.relay.db().execute("SELECT generation, state FROM routes WHERE name = 'acme'").fetchone()
   420	        self.assertEqual((row[0], row[1]), (5, 'pending'))
