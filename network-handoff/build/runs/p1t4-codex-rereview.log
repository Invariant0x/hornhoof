   606	def plugin_decide(op: str, content: dict) -> dict:
   607	    if op == 'Login':
   608	        metas = content.get('metas') or {}
   609	    else:
   610	        metas = (content.get('user') or {}).get('metas') or {}
   611	    name, key = metas.get('name'), metas.get('key')
   612	    reason = binding_ok(name, key)
   613	    if reason is None and op == 'NewProxy':
   614	        reason = proxy_check(name, content)
   615	    if reason is not None:
   616	        return {'reject': True, 'reject_reason': reason}
   617	    touch(name)
   618	    return {'reject': False, 'unchange': True}
