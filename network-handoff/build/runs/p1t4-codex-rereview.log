    35	            dest = Path(tmp) / 'secret.env'
    36	            process = start_write_private(dest, '640')
    37	            process.stdin.write('first half\n')
    38	            process.stdin.flush()
    39	            tmp_file = Path(str(dest) + '.new')
    40	            deadline = time.monotonic() + 5
    41	            while not tmp_file.exists() and process.poll() is None and time.monotonic() < deadline:
    42	                time.sleep(0.02)
    43	            self.assertTrue(tmp_file.exists(),
    44	                            'the temp file never appeared: write_private is not waiting on stdin')
    45	            mode = stat.S_IMODE(tmp_file.stat().st_mode)
    46	            self.assertEqual(mode & 0o077, 0, f'the temp file is readable by others: {oct(mode)}')
    47	            process.stdin.write('second half\n')
    48	            process.stdin.close()
    49	            code, out, err = finish(process)
    50	            self.assertEqual(code, 0, err)
    51	            self.assertEqual(out, 'changed')
    52	            self.assertEqual(dest.read_text(), 'first half\nsecond half\n')
    53	            self.assertEqual(stat.S_IMODE(dest.stat().st_mode), 0o640)
