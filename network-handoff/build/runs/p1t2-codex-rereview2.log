   153	def _dash_get(path: str) -> tuple[int, bytes]:
   154	    """One dashboard read with a 0.5 s timeout; any error or timeout is FrpsUnknown."""
   155	    parsed = urlsplit(RELAY_FRPS_API)
   156	    host = parsed.hostname or '127.0.0.1'
   157	    port = parsed.port or (443 if parsed.scheme == 'https' else 80)
   158	    kind = http.client.HTTPSConnection if parsed.scheme == 'https' else http.client.HTTPConnection
   159	    connection = kind(host, port, timeout=0.5)
   160	    try:
   161	        token = base64.b64encode(f'{FRPS_USER}:{FRPS_PASSWORD}'.encode()).decode()
   162	        connection.request('GET', path, headers={'Authorization': f'Basic {token}'})
   163	        response = connection.getresponse()
   164	        return response.status, response.read()
   165	    except (OSError, http.client.HTTPException) as e:
   166	        raise FrpsUnknown(f'{path}: {type(e).__name__}') from None
   167	    finally:
   168	        connection.close()
