   250	    def do_GET(self):
   251	        status, body, delay = self.server.records.get(self.path, (404, b'{}', 0.0))
   252	        if delay:
   253	            time.sleep(delay)
   254	        try:
   255	            self.send_response(status)
   256	            self.send_header('Content-Type', 'application/json')
   257	            self.send_header('Content-Length', str(len(body)))
   258	            self.end_headers()
   259	            self.wfile.write(body)
   260	        except (BrokenPipeError, ConnectionResetError):
   261	            pass  # the relay hung up when its budget-capped read timed out
