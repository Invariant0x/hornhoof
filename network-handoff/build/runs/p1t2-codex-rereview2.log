import contextlib
import importlib.util
import io
import json
import os
from pathlib import Path
import threading
import time
os.environ['RELAY_TRACE'] = '1'
paths = {
    'old_plain_print':Path(os.environ['TMPDIR'])/'hornhoof-task2-review-80rs2fss/snapshot/relay/relay.py',
    'current_atomic_write':Path.cwd()/'relay/relay.py',
}
count = 16
class ScheduledStream(io.StringIO):
    def __init__(self):
        super().__init__()
        self.partial_writes = threading.Barrier(count)
    def write(self, value):
        result = super().write(value)
        if value and not value.endswith('\\n'):
            self.partial_writes.wait(timeout=5)
        return result
for label,path in paths.items():
    spec = importlib.util.spec_from_file_location(label,path)
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    output = ScheduledStream()
    start = threading.Barrier(count)
    errors = []
    def emit(i):
        try:
            start.wait(timeout=5)
            m.trace_plugin('Ping',{'user':{'run_id':f'r{i}','metas':{'client':f'c{i}'}}},{'reject':False},time.monotonic())
        except BaseException as exc:
            errors.append(type(exc).__name__)
    with contextlib.redirect_stdout(output):
        threads = [threading.Thread(target=emit,args=(i,)) for i in range(count)]
        for thread in threads:
            thread.start()
        for thread in threads:
            thread.join(timeout=10)
    records = []
    for line in output.getvalue().splitlines():
        try:
            records.append(json.loads(line.removeprefix('TRACE ')))
        except ValueError:
            pass
    print(label,{'valid_records':len(records),'distinct_clients':len({r['client'] for r in records}),'thread_errors':errors,'alive_threads':sum(t.is_alive() for t in threads)})
