   171	def dash_answer(name: str, proxy_type: str) -> tuple[str, str] | None:
   172	    """One proxy type's dashboard record: (status, clientID), None on 404, FrpsUnknown otherwise.
   173	
   174	    A record is trusted only with a status of online or offline and a non-empty clientID:
   175	    a missing field reads as unknown, never as empty.
   176	    """
   177	    status, body = _dash_get(f'/api/proxy/{proxy_type}/{name}')
   178	    if status == 404:
   179	        return None
   180	    if status != 200:
   181	        raise FrpsUnknown(f'dashboard answered {status} for {proxy_type} {name}')
   182	    try:
   183	        answer = json.loads(body)
   184	        route_status = answer['status']
   185	        client_id = answer['clientID']
   186	    except (ValueError, KeyError, TypeError):
   187	        raise FrpsUnknown(f'dashboard body for {proxy_type} {name} has no route record') from None
   188	    if route_status not in ('online', 'offline') or not isinstance(client_id, str) or not client_id:
   189	        raise FrpsUnknown(f'dashboard body for {proxy_type} {name} is not a route record')
   190	    return route_status, client_id
