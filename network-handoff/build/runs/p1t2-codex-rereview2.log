    50	    def race(self, clients, ids, base):
    51	        """Wait until every client has its first outcome (started, or its refusal reason) and the
    52	        trace holds one NewProxy record per client id; return (records, outcomes).
    53	        base is the trace length before the clients were created."""
    54	        deadline = time.monotonic() + 30
    55	        while time.monotonic() < deadline:
    56	            calls = self.newproxy_calls()[base:]
    57	            outcomes = [first_outcome(client.log()) for client in clients]
    58	            traced = {call['client'] for call in calls}
    59	            if all(outcomes) and all(client_id in traced for client_id in ids):
    60	                return calls, outcomes
    61	            time.sleep(0.1)
    62	        raise AssertionError('no outcome: ' + ' | '.join(c.log()[-200:] for c in clients))
