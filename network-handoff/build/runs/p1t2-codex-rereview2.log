   199	    https = dash_answer(name, 'https')
   200	    if http is not None and https is not None:
   201	        raise FrpsUnknown(f'dashboard shows both http and https routes for {name}')
   202	    for proxy_type, answer in (('http', http), ('https', https)):
   203	        if answer is not None:
