   378	    def test_newproxy_call_is_refused_within_one_second(self):
   379	        # A registration waiting behind a slow route read must not wait it out (Review Focus 3):
   380	        # one plugin call gets one 1 s budget, and a lock that cannot be taken in time refuses.
   381	        self._bind('acme', 'k')
   382	        lock = self.relay.route_lock('acme')
   383	        lock.acquire()
   384	        timer = threading.Timer(2.0, lock.release)
   385	        timer.start()
   386	        try:
   387	            result = []
   388	            worker = threading.Thread(target=lambda: result.append(
   389	                self.relay.plugin('NewProxy', self._newproxy_content('acme', 'k', 'acme-c1-link'))))
   390	            started = time.monotonic()
   391	            worker.start()
   392	            worker.join(timeout=5)
   393	            elapsed = time.monotonic() - started
   394	        finally:
   395	            timer.cancel()
   396	            _release_lock(lock)
   397	        self.assertFalse(worker.is_alive())
   398	        self.assertLess(elapsed, 1.6, f'refusal took {elapsed:.2f} s')
   399	        self.assertEqual(result[-1], {'reject': True, 'reject_reason': 'relay error: frps does not answer'})
