    27	def first_outcome(log: str):
    28	    """A tunnel client's first outcome: 'started', or the refusal reason of its first start error."""
    29	    for line in log.splitlines():
    30	        if 'start proxy success' in line:
    31	            return 'started'
    32	        if 'start error:' in line:
    33	            return line.split('start error:', 1)[1].strip()
    34	    return None
