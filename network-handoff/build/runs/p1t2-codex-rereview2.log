   405	    def allow(self, key: str) -> int:
   406	        """0 if allowed (and counted), else seconds to wait."""
   407	        t = time.time()
   408	        with self.lock:
   409	            if len(self.hits) > 50000:
   410	                self.hits = {k: v for k, v in self.hits.items() if v and v[-1] > t - self.seconds}
   411	            recent = [x for x in self.hits.get(key, []) if x > t - self.seconds]
   412	            if len(recent) >= self.limit:
   413	                self.hits[key] = recent
   414	                return int(recent[0] + self.seconds - t) + 1
   415	            recent.append(t)
