timport blocked.caddy\n\n\t# Companies on the Mac's SSH tunnel (managed by company.sh), until they move to the relay.\n\timport companies/*.caddy\n\n\t# Everything else goes to frps, which knows the name of every live tunnel.\n\thandle {\n\t\treverse_proxy 127.0.0.1:8080 {\n\t\t\tflush_interval -1\n\t\t\tstream_close_delay 1h\n\t\t\t# Caddy sets X-Forwarded-For, -Host and -Proto itself; drop the client-address headers it does not set.\n\t\t\theader_up -X-Real-IP\n\t\t\theader_up -Forwarded\n\t\t}\n\t}\n}\n", 'pages/build.py': '#!/usr/bin/env python3\n"""Builds the relay\'s pages from page.html, with the two fonts (OFL-1.1, from @fontsource) inlined, since frps\nserves its 404 page as one file. Run it after editing page.html; setup.sh and setup-relay.sh install the results."""\nimport base64\nimport pathlib\n\nHERE = pathlib.Path(__file__).resolve().parent\nROOT = HERE.parent\n\nPAGES = {\n    # The hornhoof.org stub.\n    ROOT / \'www\' / \'index.html\': {\n        \'TITLE\': \'Hornhoof\',\n        \'CODE\': \'\',\n        \'WIDE\': \' wide\',\n        \'HEAD\': \'A company of AI agents on your own machines\',\n        \'TEXT\': \'Start yours: run this command in a terminal on a Mac or a Linux machine. It installs Docker if it is missing, starts Hornhoof and gives you a link to set it up, where you pick your company\\\'s address.\',\n        \'EXTRA\': (HERE / \'start.html\').read_text().rstrip(\'\\n\'),\n        \'FOOT\': \'Self-hosted. Each company lives at its own address.\',\n    },\n    # A company name with no live tunnel (frps) and the reserved names (Caddy).\n    ROOT / \'relay\' / \'404.html\': {\n        \'TITLE\': \'No company here - Hornhoof\',\n        \'WIDE\': \'\',\n        \'EXTRA\': \'\',\n        \'CODE\': \'<span class="code"><b>404</b></span>\',\n        \'HEAD\': \'No company here\',\n        \'TEXT\': \'This address has no Hornhoof, or its server is offline right now.\',\n        \'FOOT\': \'<a href="https://hornhoof.org/">hornhoof.org</a>\',\n    },\n    # A name the relay\'s operator blocked.\n    ROOT / \'relay\' / \'410.html\': {\n        \'TITLE\': \'Address blocked - Hornhoof\',\n        \'WIDE\': \'\',\n        \'EXTRA\': \'\',\n        \'CODE\': \'<span class="code"><b>410</b></span>\',\n        \'HEAD\': \'Address blocked\',\n        \'TEXT\': \'This address was closed and no longer opens a company.\',\n        \'FOOT\': \'<a href="https://hornhoof.org/">hornhoof.org</a>\',\n    },\n}\n\n\ndef font(name: str) -> str:\n    return base64.b64encode((HERE / \'fonts\' / name).read_bytes()).decode()\n\n\ndef main() -> None:\n    template = (HERE / \'page.html\').read_text()\n    fonts = {\'TEKTUR\': font(\'tektur-latin-600-normal.woff2\'), \'ONEST\': font(\'onest-latin-400-normal.woff2\')}\n    for path, words in PAGES.items():\n        page = template\n        for key, value in {**fonts, **words}.items():\n            page = page.replace(\'{{\' + key + \'}}\', value)\n        assert \'{{\' not in page, path\n        path.write_text(page)\n        print(f\'{path.relative_to(ROOT)}: {len(page)} bytes\')\n\n\nif __name__ == \'__main__\':\n    main()\n', 'pages/page.html': '<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n<meta name="viewport" content="width=device-width, initial-scale=1">\n<meta name="robots" content="noindex">\n<meta name="color-scheme" content="dark">\n<title>{{TITLE}}</title>\n<style>\n@font-face { font-family: \'Tektur\'; font-weight: 600; font-display: swap; src: url(data:font/woff2;base64,{{TEKTUR}}) format(\'woff2\'); }\n@font-face { font-family: \'Onest\'; font-weight: 400; font-display: swap; src: url(data:font/woff2;base64,{{ONEST}}) format(\'woff2\'); }\n:root {\n  --bg: #141A22; --surface: #1B232D; --line: #2C3845; --line2: #3D4C5C; --ink: #E3EAF1; --muted: #93A0AE;\n  --cyan: #46E0EF; --cyan-ink: #6FE9F5; --amber: #FFB54A; --dot: rgba(140,175,205,.15);\n  --f-display: \'Tektur\', ui-sans-serif, system-ui, sans-serif; --f-body: \'Onest\', ui-sans-serif, system-ui, sans-serif;\n}\n* { box-sizing: border-box; }\nhtml, body { height: 100%; }\nbody {\n  margin: 0; display: grid; place-items: center; padding: 24px 16px;\n  background-color: var(--bg);\n  background-image: radial-gradient(ellipse 60% 45% at 50% 42%, rgba(70,224,239,.07), transparent 70%), radial-gradient(var(--dot) 1px, transparent 1px);\n  background-size: 100% 100%, 22px 22px;\n  color: var(--ink); font: 16px/1.55 var(--f-body);\n}\n.frame {\n  --cut: 16px;\n  width: min(var(--w, 460px), 100%); padding: 1px; background: var(--line2); position: relative;\n  clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, var(--cut) 100%, 0 calc(100% - var(--cut)));\n}\n.panel {\n  --cut: 15px;\n  background: var(--surface); padding: 34px 32px 26px;\n  clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, var(--cut) 100%, 0 calc(100% - var(--cut)));\n}\n.corner { position: absolute; left: 0; top: 0; width: 26px; height: 26px; border-left: 2px solid var(--cyan); border-top: 2px solid var(--cyan); }\n.brand { display: flex; align-items: center; gap: 12px; font: 600 20px/1 var(--f-display); letter-spacing: .01em; }\n.brand svg { width: 34px; height: 34px; filter: drop-shadow(0 0 8px rgba(70,224,239,.45)); }\n/* The status code, chamfered like the frame: the outer box is its border. */\n.code, .code b { --cut: 6px; clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, var(--cut) 100%, 0 calc(100% - var(--cut))); }\n.code { margin-left: auto; padding: 1px; background: rgba(255,181,74,.5); }\n.code b { display: block; padding: 5px 10px 4px; font: 600 13px/1 var(--f-display); color: var(--amber); background: #2B2D2F; }\nh1 { margin: 30px 0 10px; font: 600 30px/1.15 var(--f-display); letter-spacing: .005em; }\np { margin: 0; color: var(--muted); max-width: 40ch; }\nfooter { margin-top: 30px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 14px; color: var(--muted); }\na { color: var(--cyan-ink); text-decoration: none; }\na:hover, a:focus-visible { text-decoration: underline; text-underline-offset: 3px; }\na:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; }\n.mk-dome { fill: none; stroke: var(--cyan); stroke-width: 2.4; stroke-dasharray: 32; animation: draw 1.1s ease-out both; }\n.mk-base { stroke: var(--ink); stroke-width: 2.4; }\n.mk-dot { fill: var(--ink); animation: light .5s ease-out 1s both; }\n@keyframes draw { from { stroke-dashoffset: 32; } }\n@keyframes light { from { fill: var(--line2); } 60% { fill: var(--cyan-ink); } }\n@media (prefers-reduced-motion: reduce) { .mk-dome, .mk-dot { animation: none; } }\n/* The stub: the command that starts a company, to copy into a terminal. */\n.frame.wide { --w: 600px; }\n.cmd { margin-top: 24px; }\n.cmd-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 8px; }\n.cmd-label { font-size: 14px; color: var(--muted); }\n.copy { --cut: 6px; flex: none; padding: 1px; border: 0; background: var(--line2); cursor: pointer; clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, var(--cut) 100%, 0 calc(100% - var(--cut))); }\n.copy span { --cut: 5px; display: block; min-width: 92px; padding: 8px 14px 7px; background: var(--surface); color: var(--ink); font: 600 13px/1 var(--f-display); clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, var(--cut) 100%, 0 calc(100% - var(--cut))); }\n.copy:hover span, .copy.done span { color: var(--cyan-ink); }\n.copy:hover, .copy.done { background: var(--cyan); }\n.copy:focus-visible { outline: 2px solid var(--cyan); outline-offset: 3px; }\n.cmd code { display: block; padding: 13px 16px; border: 1px solid var(--line2); border-left: 2px solid var(--cyan); background: #10151C; color: var(--cyan-ink); font: 13px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; white-space: pre-wrap; overflow-wrap: anywhere; user-select: all; }\n.small { margin-top: 18px; font-size: 14px; }\n@media (max-width: 420px) { .panel { padding: 26px 22px 22px; } h1 { font-size: 26px; } .copy span { padding: 13px 16px 12px; } }\n</style>\n</head>\n<body>\n<main class="frame{{WIDE}}">\n  <div class="panel">\n    <div class="brand">\n      <svg viewBox="0 0 30 30" aria-hidden="true"><path class="mk-dome" d="M 5 20 A 10 10 0 0 1 25 20"/><path class="mk-base" d="M 2 24.5 L 28 24.5"/><circle class="mk-dot" cx="15" cy="16" r="2.4"/></svg>\n      Hornhoof{{CODE}}\n    </div>\n    <h1>{{HEAD}}</h1>\n    <p>{{TEXT}}</p>{{EXTRA}}\n    <footer>{{FOOT}}</footer>\n  </div>\n  <span class="corner"></span>\n</main>\n</body>\n</html>\n', 'pages/start.html': '\n    <div class="cmd">\n      <div class="cmd-head">\n        <span class="cmd-label">Run in a terminal</span>\n        <button class="copy" type="button" id="copy"><span>Copy</span></button>\n      </div>\n      <code id="cmd">curl -fsSL https://hornhoof.org/install.sh | bash -s -- server</code>\n    </div>\n    <p class="small">Already have a company? Open it with its link.</p>\n    <script>\n    (() => {\n      const copy = document.getElementById(\'copy\');\n      const cmd = document.getElementById(\'cmd\');\n      let timer;\n      copy.addEventListener(\'click\', async () => {\n        try {\n          await navigator.clipboard.writeText(cmd.textContent);\n        } catch {\n          /* No clipboard here: the command is selected for the reader to copy. */\n          const range = document.createRange();\n          range.selectNodeContents(cmd);\n          const sel = getSelection();\n          sel.removeAllRanges();\n          sel.addRange(range);\n          return;\n        }\n        copy.firstChild.textContent = \'Copied\';\n        copy.classList.add(\'done\');\n        clearTimeout(timer);\n        timer = setTimeout(() => { copy.firstChild.textContent = \'Copy\'; copy.classList.remove(\'done\'); }, 2000);\n      });\n    })();\n    </script>\n', 'relay/404.html': '<!doctype html>\n<