name: Images

on:
  push:
    branches: [main]
    # A push that changes only texts and pictures builds no new images, so no update is offered for it.
    paths-ignore:
      - 'README.md'
      - 'EXAMPLES.md'
      - 'guide/**'
      - 'CONTRIBUTING.md'
      - 'SECURITY.md'
      - 'CODE_OF_CONDUCT.md'
      - 'LICENSE'
      - '.github/assets/**'
      - '.github/ISSUE_TEMPLATE/**'
      - '.github/CODEOWNERS'
      - '.github/pull_request_template.md'
  # Pull requests run the tests only; images are built and pushed from main.
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - run: npm test
      - run: bash -n scripts/install.sh
      - run: shellcheck scripts/install.sh

  images:
    needs: test
    if: github.event_name != 'pull_request'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    strategy:
      matrix:
        include:
          - name: hornhoof
            file: Dockerfile
          - name: hornhoof-node
            file: apps/node/Dockerfile
          - name: hornhoof-updater
            file: apps/updater/Dockerfile
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      # The product version, the commit's title and how many database migrations the build carries.
      - id: build
        run: |
          echo "version=$(node -p "require('./package.json').version")" >> "$GITHUB_OUTPUT"
          echo "title=$(git log -1 --format=%s | tr -d '\r"')" >> "$GITHUB_OUTPUT"
          echo "migrations=$(ls apps/server/drizzle/*.sql | wc -l | tr -d ' ')" >> "$GITHUB_OUTPUT"
      - uses: docker/setup-qemu-action@99012661954931238ded8c8b007157a8430204e1 # v4.4.0
      - uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4.4.1
      - uses: docker/login-action@81c6f93d4bc991e510b342a00b419b3bb4efc5c6 # v4.7.0
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7.4.0
        with:
          context: .
          file: ${{ matrix.file }}
          platforms: linux/amd64,linux/arm64
          # The node image goes out through its own output, so the push and the timestamps it rewrites are one export.
          push: ${{ matrix.name != 'hornhoof-node' }}
          # The source label links each package to this repository on GitHub; the rest tell Hornhoof what a build is.
          # The node image carries none of a commit's own labels, timestamps or provenance, so its digest changes only
          # when its own layers change.
          labels: |
            org.opencontainers.image.source=https://github.com/${{ github.repository }}
            ${{ matrix.name != 'hornhoof-node' && format('org.opencontainers.image.version={0}', steps.build.outputs.version) || '' }}
            ${{ matrix.name != 'hornhoof-node' && format('org.opencontainers.image.revision={0}', github.sha) || '' }}
            ${{ matrix.name != 'hornhoof-node' && format('io.hornhoof.title={0}', steps.build.outputs.title) || '' }}
            ${{ matrix.name != 'hornhoof-node' && format('io.hornhoof.migrations={0}', steps.build.outputs.migrations) || '' }}
          build-args: |
            ${{ matrix.name == 'hornhoof' && format('HORNHOOF_VERSION={0}', steps.build.outputs.version) || '' }}
            ${{ matrix.name == 'hornhoof' && format('HORNHOOF_COMMIT={0}', github.sha) || '' }}
            ${{ matrix.name == 'hornhoof-node' && 'SOURCE_DATE_EPOCH=315532800' || '' }}
          outputs: ${{ matrix.name == 'hornhoof-node' && 'type=registry,rewrite-timestamp=true' || '' }}
          provenance: ${{ matrix.name != 'hornhoof-node' }}
          # Every company updates to latest, so only a build of main moves it and the version; a run started by hand from a
          # branch pushes its commit's tag alone. The action skips the empty lines.
          tags: |
            ${{ github.ref == 'refs/heads/main' && format('ghcr.io/invariant0x/{0}:latest', matrix.name) || '' }}
            ${{ github.ref == 'refs/heads/main' && format('ghcr.io/invariant0x/{0}:{1}', matrix.name, steps.build.outputs.version) || '' }}
            ghcr.io/invariant0x/${{ matrix.name }}:${{ github.sha }}
          cache-from: type=gha,scope=${{ matrix.name }}
          cache-to: type=gha,mode=max,scope=${{ matrix.name }}
name: Sign-off

on:
  pull_request:

permissions:
  contents: read

jobs:
  sign-off:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          ref: ${{ github.event.pull_request.head.sha }}
      # Every commit of the pull request carries a Signed-off-by line with its author, as CONTRIBUTING.md asks.
      - env:
          BASE: ${{ github.event.pull_request.base.sha }}
          HEAD: ${{ github.event.pull_request.head.sha }}
        run: |
          missing=0
          for c in $(git rev-list --no-merges "$BASE..$HEAD"); do
            author=$(git log -1 --format='%an <%ae>' "$c")
            if ! git log -1 --format=%B "$c" | grep -qiF "Signed-off-by: $author"; then
              echo "Commit $(git rev-parse --short "$c") has no Signed-off-by line with its author's name and email."
              missing=1
            fi
          done
          if [ "$missing" = 1 ]; then
            echo "Add it with: git rebase --signoff $BASE, then push the branch again."
          fi
          exit "$missing"

