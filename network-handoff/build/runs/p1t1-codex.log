# frps for the Hornhoof relay. Everything listens on loopback: Caddy brings tunnels in over wss
# (https://hornhoof.org/~!frp -> 7000) and company traffic (*.hornhoof.org -> 8080).
# Every login, proxy and heartbeat is checked by hornhoof-relay (127.0.0.1:7600); if it does not answer, frps refuses.
bindAddr = "127.0.0.1"
bindPort = 7000
proxyBindAddr = "127.0.0.1"
vhostHTTPPort = 8080
vhostHTTPTimeout = 60
subDomainHost = "hornhoof.org"
custom404Page = "/etc/frp/404.html"
detailedErrorsToClient = true
userConnTimeout = 10

auth.method = "token"
auth.token = ""

transport.tcpMux = true
transport.maxPoolCount = 5
# A client that stops sending heartbeats (or whose binding was released or blocked) is dropped after 90 s.
transport.heartbeatTimeout = 90

log.to = "console"
log.level = "info"

webServer.addr = "127.0.0.1"
webServer.port = 7500
webServer.user = "admin"
webServer.password = "@WEB_PASSWORD@"

[[httpPlugins]]
name = "hornhoof-relay"
addr = "127.0.0.1:7600"
path = "/frp/handler"
ops = ["Login", "NewProxy", "Ping"]
#!/bin/sh
# Installs the Hornhoof relay on the edge droplet: frps, the relay API, their users and services.
# Run as root from the folder that holds the files next to it. Safe to run again: frps restarts (and every tunnel
# reconnects) only when its binary or config changed.
set -eu
cd "$(dirname "$0")"
FRP_VERSION=0.71.1
FRP_SHA256=1d9875210972a5d1a62b2dc4c48df45ab0af05d3ca1b5e494a014428259df803
restart_frps=''

if [ "$(/usr/local/bin/frps -v 2> /dev/null || true)" != "$FRP_VERSION" ]; then
  tmp=$(mktemp -d)
  curl -fsSL -o "$tmp/frp.tgz" "https://github.com/fatedier/frp/releases/download/v$FRP_VERSION/frp_${FRP_VERSION}_linux_amd64.tar.gz"
  echo "$FRP_SHA256  $tmp/frp.tgz" | sha256sum -c - > /dev/null
  tar -xzf "$tmp/frp.tgz" -C "$tmp"
  install -m 755 "$tmp/frp_${FRP_VERSION}_linux_amd64/frps" /usr/local/bin/frps
  rm -rf "$tmp"
  restart_frps=1
fi

id frps > /dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin frps
id hornhoof-relay > /dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin hornhoof-relay

install -d -m 755 /usr/local/lib/hornhoof-relay
install -m 755 relay.py /usr/local/lib/hornhoof-relay/relay.py
install -m 755 hornhoof-relay /usr/local/sbin/hornhoof-relay

install -d -m 750 -o root -g frps /etc/frp
install -m 644 404.html /etc/frp/404.html
pass=$(sed -n 's/^webServer.password = "\([0-9a-f]*\)"$/\1/p' /etc/frp/frps.toml 2> /dev/null || true)
[ -n "$pass" ] || pass=$(openssl rand -hex 16)
sed "s/@WEB_PASSWORD@/$pass/" frps.toml > /etc/frp/frps.toml.new
if ! cmp -s /etc/frp/frps.toml.new /etc/frp/frps.toml; then restart_frps=1; fi
install -m 640 -o root -g frps /etc/frp/frps.toml.new /etc/frp/frps.toml
rm -f /etc/frp/frps.toml.new

[ -f /etc/caddy/blocked.caddy ] || echo '# Generated by hornhoof-relay from blocked bindings. Do not edit.' > /etc/caddy/blocked.caddy

for unit in hornhoof-relay.service frps.service; do
  if ! cmp -s "$unit" "/etc/systemd/system/$unit"; then
    install -m 644 "$unit" "/etc/systemd/system/$unit"
    [ "$unit" = frps.service ] && restart_frps=1
  fi
done
systemctl daemon-reload
systemctl enable hornhoof-relay frps > /dev/null 2>&1
systemctl restart hornhoof-relay
if [ -n "$restart_frps" ] || ! systemctl is-active -q frps; then systemctl restart frps; fi
echo "relay setup done"
#!/bin/sh
# Operator commands for the Hornhoof relay. Run as root on the droplet.
#   hornhoof-relay list                 every binding, when it was made and last seen
#   hornhoof-relay add <name>           a binding made by us (no rate limit); prints {name, key} once, keep it secret
#   hornhoof-relay ban <name> [reason]  block a name now: 410 at once, its tunnel dropped within 90 s, nobody can take it
#   hornhoof-relay unban <name>
#   hornhoof-relay release <name>       free a name (its tunnel is dropped within 90 s)
set -eu
relay() { runuser -u hornhoof-relay -- /usr/bin/python3 /usr/local/lib/hornhoof-relay/relay.py admin "$@"; }
relay "$@"
case "${1:-}" in
  ban | unban)
    relay banned-caddy > /etc/caddy/blocked.caddy.new
    mv /etc/caddy/blocked.caddy.new /etc/caddy/blocked.caddy
    chmod 644 /etc/caddy/blocked.caddy
    systemctl reload caddy
    ;;
esac
[Unit]
Description=frps for the Hornhoof relay
After=network.target hornhoof-relay.service
Wants=hornhoof-relay.service

[Service]
User=frps
Group=frps
ExecStart=/usr/local/bin/frps -c /etc/frp/frps.toml
Restart=always
RestartSec=2
LimitNOFILE=1048576
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
[Unit]
Description=Hornhoof relay: link API and frps plugin
After=network.target

[Service]
User=hornhoof-relay
Group=hornhoof-relay
ExecStart=/usr/bin/python3 /usr/local/lib/hornhoof-relay/relay.py
StateDirectory=hornhoof-relay
StateDirectoryMode=0700
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=200M

[Install]
WantedBy=multi-user.target
![Hornhoof](.github/assets/logo.svg)

# Hornhoof

**Your own company of AI agents, on your own computers.**

Hornhoof turns the AI plans you already pay for, like Claude, ChatGPT, Kimi, GLM or Google AI, into a company that works for you.

You write what you want in plain words. The orchestrator, the main agent, splits it into tasks and gives them to departments. Every department has a head and employees, and every employee is an AI agent. You watch all of them on one map, see what each one is doing right now, and step in only when someone asks you.

It all runs on your own computers. There is no account to make, nothing to sign up for, and no Hornhoof server that holds your company.

Hornhoof is young. It works, and it changes fast. Expect rough edges, and tell us about them.

## Hornhoof is for you if

- ✅ You pay for more than one AI plan and want all of them working, not waiting.
- ✅ You have ten Claude Code or Codex windows open and no longer remember which one does what.
- ✅ You want to give a goal and get the result, not watch every step.
- ✅ You and a few friends each have a plan and want to build something together.
- ✅ You have an old laptop, a home server or a spare Mac that sits idle most of the day.
- ✅ You want the company to keep going when one of your computers turns off.
- ✅ You want to look in from your phone, wherever you are.
- ✅ You want it all on your own machines, under your own control.

## What changes

| | AI programs on their own | With Hornhoof |
| --- | :---: | :---: |
| All your AI plans work at the same time, on one job | ❌ | ✅ |
| Work goes on when a plan hits its limit | ❌ | ✅ |
| Agents hand work to each other, without you copying it over | ❌ | ✅ |
| Every change is reviewed by an AI of another maker | ❌ | ✅ |
| Nothing reaches the main branch before its exact commit is approved | ❌ | ✅ |
| One map shows what every agent is doing right now | ❌ | ✅ |
| Spare computers take tests and heavy jobs | ❌ | ✅ |
| The company keeps running when one of your computers stops | ❌ | ✅ |
| Friends join with their own plans | ❌ | ✅ |
| Runs on your own machines, with no sign-up | ✅ | ✅ |

"AI programs on their own" means Claude Code, Codex, Kimi Code and the like, each in its own window. Hornhoof runs them for you as one team.

## How it works

The pictures show Moonfern, a made-up company. Its people, plans and work are invented for the demo.

1. Install Hornhoof with one line in the terminal.

2. Open the link it shows. Name your company and pick a template, or start empty.

   ![Setting up a company](.github/assets/setup.gif)

3. Connect your AI plans. Each runs on your own computer, in a small locked box of its own, and you sign it in once in Hornhoof for all your machines.

   ![Connecting AI plans](.github/assets/subscriptions.png)

4. Tell the orchestrator about your company. He proposes departments and people for them. You tick what you want and click once.

   ![Building the departments](.github/assets/build.gif)

5. Write what you need. The orchestrator packs it into a turn of tasks, the heads hand out the work, and you watch it move on the map.

   ![The company map](.github/assets/map.gif)

