+class RenderTests(unittest.TestCase):
+    def test_every_replacement_is_applied_in_order(self) -> None:
+        rendered = render_caddyfile('one\ntwo\n', [('one', 'uno'), ('two\n', 'dos\n'), ('uno', 'eins')])
+        self.assertEqual(rendered, 'eins\ndos\n')
