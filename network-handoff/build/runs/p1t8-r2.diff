+    _openssl('ecparam', '-genkey', '-name', 'prime256v1', '-noout', '-out', key)
+    _openssl('req', '-new', '-key', key, '-config', config, '-subj', '/CN=hornhoof.org', '-out', request)
+    _openssl('x509', '-req', '-in', request, '-CA', ca, '-CAkey', ca_key, '-CAcreateserial', '-days', 2,
