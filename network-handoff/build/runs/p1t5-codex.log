+          (body['state'], body['copy'], body['epoch'], now(), name, body['generation'], body['client']))
+    return db().execute('SELECT changes()').fetchone()[0] == 1
 
 
+def set_sync(name: str, body: dict) -> tuple[str | None, dict | None]:
