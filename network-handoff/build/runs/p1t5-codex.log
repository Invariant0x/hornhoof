+        self.assertTrue(_wait(lambda: self.route()['state'] == 'empty', 5))
+        status, body = self.post(epoch=2)
+        self.assertEqual(status, 409, body)
+        self.assertEqual(body['error'], 'not_holder')
+        self.assertEqual(self.route()['sync'], saved)
+
