+                response = connection.getresponse()
+                self.assertEqual(response.status, 503)
+                self.assertEqual(response.getheader('Retry-After'), '1')
+                self.assertEqual(json.loads(response.read())['error'], 'busy')
+            finally:
+                conn.execute('ROLLBACK')
