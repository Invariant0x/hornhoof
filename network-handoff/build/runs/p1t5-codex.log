\"\"\"Record test-owned children and fail if a test leaves any running.\"\"\"
import atexit
import os
import subprocess
import sys

_started = []
_original_init = subprocess.Popen.__init__


def _track_start(self, *args, **kwargs):
    _original_init(self, *args, **kwargs)
    _started.append(self)


subprocess.Popen.__init__ = _track_start


def _check_children():
    live = [child for child in _started if child.poll() is None]
    for child in live:
        child.terminate()
        try:
            child.wait(timeout=5)
        except subprocess.TimeoutExpired:
            child.kill()
            child.wait(timeout=5)
    if _started:
        print(f'process audit: {len(_started)} children started, {len(live)} left running', flush=True)
    if live:
        sys.stderr.write('A test left a child running; the process audit stopped it.\\n')
        sys.stderr.flush()
        os._exit(1)


atexit.register(_check_children)
