            generation INTEGER NOT NULL,
            client TEXT NOT NULL,
            run_id TEXT NOT NULL,
            type TEXT NOT NULL CHECK (type IN ('http', 'https')),
            state TEXT NOT NULL CHECK (state IN ('pending', 'held', 'empty')),
            since INTEGER NOT NULL
