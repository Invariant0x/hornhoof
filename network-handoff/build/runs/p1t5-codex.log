+    return dict(zip(('state', 'copy', 'epoch', 'generation', 'at'), row))
+
+
+def sync_text(value: object) -> bool:
+    return isinstance(value, str) and 1 <= len(value) <= 100
+
+
+def sync_integer(value: object) -> bool:
+    return type(value) is int and value >= 1
