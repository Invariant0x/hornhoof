diff --git a/relay/test/test_today.py b/relay/test/test_today.py
new file mode 100644
index 0000000000000000000000000000000000000000..97557be0b5e098aa57e10f7c7bd26b5eaa86fc7c
--- /dev/null
+++ b/relay/test/test_today.py
@@ -0,0 +1,49 @@
+"""The relay's existing behavior, through real frps and frpc processes."""
+
+import tempfile
+import unittest
+
+if __package__:
+    from .harness import Stack
+else:
+    from harness import Stack
+
+
+class TodayTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = self.enterContext(tempfile.TemporaryDirectory(prefix='hornhoof-relay-'))
+        self.stack = self.enterContext(Stack(self.tmp))
+        self.binding = self.stack.bind('acme')
+
+    def test_binding_serves_its_name(self):
+        client = self.stack.client('acme', self.binding['key'])
+        self.assertTrue(client.started('acme'), client.log())
+        self.assertEqual(self.stack.get('acme.hornhoof.org'), 200)
+
+    def test_wrong_key_refused(self):
+        client = self.stack.client('acme', 'x')
+        self.assertFalse(client.started('acme', within=2), client.log())
+        self.assertIn('no binding acme with this key', client.log())
+
+    def test_second_copy_refused(self):
+        first = self.stack.client('acme', self.binding['key'])
+        self.assertTrue(first.started('acme'), first.log())
+        second = self.stack.client('acme', self.binding['key'])
+        self.assertFalse(second.started('acme', within=2), second.log())
+        self.assertEqual(self.stack.get('acme.hornhoof.org'), 200)
+
+    def test_tcp_proxy_refused(self):
+        client = self.stack.client('acme', self.binding['key'], proxies='''
+[[proxies]]
+name = "acme"
+type = "tcp"
+localIP = "127.0.0.1"
+localPort = 1
+remotePort = 0
+''')
+        self.assertFalse(client.started('acme', within=2), client.log())
+        self.assertIn('only http proxies are allowed', client.log())
+
+
+if __name__ == '__main__':
+    unittest.main()

exec
/bin/zsh -lc "nice -n 10 python3 - <<'PY'
import http.client
import json
from pathlib import Path
import socket
import tempfile
from relay.test.harness import Stack

with tempfile.TemporaryDirectory(prefix='hornhoof-harness-check-') as tmp:
    with Stack(tmp, dashboard=False) as stack:
        binding = stack.bind('acme')
        client = stack.client('acme', binding['key'])
        assert client.started('acme'), client.log()
        connection = http.client.HTTPConnection('127.0.0.1', stack.vhost_port, timeout=2)
        try:
            connection.request('GET', '/echo?check=1', headers={'Host': 'acme.hornhoof.org'})
            response = connection.getresponse()
            assert response.status == 200
            assert json.loads(response.read()) == {'host': 'acme.hornhoof.org', 'path': '/echo?check=1'}
        finally:
            connection.close()
        assert Path(stack.env['RELAY_FRPS_STARTED']).read_text().isdigit()
        with socket.socket() as probe:
            assert probe.connect_ex(('127.0.0.1', stack.api_port)) "'!= 0
        old_relay = stack.relay
        stack.restart_relay()
        assert old_relay.process.poll() is not None
        assert stack.get('"'acme.hornhoof.org') == 200
        client.pause()
        client.resume()
        client.kill()
        assert client.process.poll() is not None
        old_frps = stack.frps
        stack.stop_frps()
        assert old_frps.process.poll() is not None
        stack.start_frps()
        old_frps = stack.frps
        stack.restart_frps()
        assert old_frps.process.poll() is not None
        assert stack.plugin_calls() == []
        ports = [stack.relay_port, stack.bind_port, stack.vhost_port, stack.dash_port, stack.echo_port]
        processes = [stack.relay, stack.frps, *stack.clients]
        client = stack.client('acme', binding['key'])
        assert client.started('acme'), client.log()
        client.pause()
        processes.append(client)
    assert all(process.process.poll() is not None and process.output.closed for process in processes)
    assert not stack.echo_thread.is_alive()
    for port in ports:
        with socket.socket() as probe:
            assert probe.connect_ex(('127.0.0.1', port)) "'!= 0
print('"'Harness restart, echo, closed-dashboard, paused-client cleanup and closed-port checks passed')
PY" in /Users/0x/Projects/hornhoof-edge
