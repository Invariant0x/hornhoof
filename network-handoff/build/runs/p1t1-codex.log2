name: Bug report
description: Something in Hornhoof does not work as it should.
labels: ["bug", "needs triage"]
body:
  - type: markdown
    attributes:
      value: |
        Thank you for reporting. A security problem goes to the Security tab instead, never here.
  - type: textarea
    id: what
    attributes:
      label: What happened
      description: What you saw. Screenshots help.
    validations:
      required: true
  - type: textarea
    id: expected
    attributes:
      label: What you expected
    validations:
      required: true
  - type: textarea
    id: steps
    attributes:
      label: How to make it happen again
      placeholder: |
        1. Open Machines
        2. Click Connect a machine
        3. ...
    validations:
      required: true
  - type: input
    id: version
    attributes:
      label: Version
      description: The build under Versions in the account menu, or the commit you run.
  - type: input
    id: system
    attributes:
      label: System
      description: The server's and the machine's system, like "macOS 15 with Colima" or "Ubuntu 24.04".
  - type: textarea
    id: logs
    attributes:
      label: Logs
      description: For example `docker compose logs app` in the ~/hornhoof folder. Remove keys, passwords and links with codes first.
      render: text
blank_issues_enabled: false
contact_links:
  - name: Security problem
    url: https://github.com/Invariant0x/hornhoof/security/advisories/new
    about: Report a security problem privately. Only the maintainers see it.
  - name: Questions and talk
    url: https://github.com/Invariant0x/hornhoof/discussions
    about: Ask how to do something, share what you built, or talk an idea through first.
name: Sign-off

on:
  pull_request:

permissions:
  contents: read

jobs:
  sign-off:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          ref: ${{ github.event.pull_request.head.sha }}
      # Every commit of the pull request carries a Signed-off-by line with its author, as CONTRIBUTING.md asks.
      - env:
          BASE: ${{ github.event.pull_request.base.sha }}
          HEAD: ${{ github.event.pull_request.head.sha }}
        run: |
          missing=0
          for c in $(git rev-list --no-merges "$BASE..$HEAD"); do
            author=$(git log -1 --format='%an <%ae>' "$c")
            if ! git log -1 --format=%B "$c" | grep -qiF "Signed-off-by: $author"; then
              echo "Commit $(git rev-parse --short "$c") has no Signed-off-by line with its author's name and email."
              missing=1
            fi
          done
          if [ "$missing" = 1 ]; then
            echo "Add it with: git rebase --signoff $BASE, then push the branch again."
          fi
          exit "$missing"

