{
  "version": 1,
  "defaultProfile": "fast",
  "runtimes": [
    {
      "id": "node",
      "version": "22"
    },
    {
      "id": "postgres",
      "version": "17"
    }
  ],
  "profiles": [
    {
      "id": "fast",
      "requiredSuiteIds": [
        "protocol",
        "node",
        "server",
        "web",
        "release-scripts"
      ]
    },
    {
      "id": "final",
      "requiredSuiteIds": [
        "protocol",
        "node",
        "server",
        "web",
        "release-scripts",
        "server-postgres",
        "browser",
        "mutation"
      ]
    },
    {
      "id": "full",
      "requiredSuiteIds": [
        "protocol",
        "node",
        "server",
        "web",
        "release-scripts",
        "server-postgres",
        "browser",
        "browser-matrix",
        "mutation"
      ]
    }
  ],
  "dependencies": {
    "adapter": "npm",
    "inputs": [
      "package.json",
      "package-lock.json",
      "apps/*/package.json",
      "packages/*/package.json"
    ],
    "install": [
      {
        "program": "npm",
        "args": [
          "ci",
          "--no-audit",
          "--no-fund"
        ],
        "cwd": "."
      }
    ],
    "paths": [
      "node_modules",
      "apps/node/node_modules",
      "apps/server/node_modules",
      "apps/web/node_modules",
      "packages/protocol/node_modules"
    ],
    "cache": "link"
  },
  "services": [
    {
      "id": "pg",
      "driver": "postgres",
      "runtime": "postgres",
      "profiles": [
        "final",
        "full"
      ],
      "options": {
        "database": "hornhoof_test",
        "locale": "C.UTF-8",
        "extensions": []
      }
    }
  ],
  "prepare": [
    {
      "id": "runtime-build",
      "profiles": [
        "fast",
        "final",
        "full"
      ],
      "serviceIds": [],
      "inputs": [
        "apps/node/src/**",
        "apps/node/tsconfig.json",
        "packages/protocol/src/**",
        "packages/protocol/tsconfig.json",
        "tsconfig.base.json"
      ],
      "commands": [
        {
          "program": "npm",
          "args": [
            "run",
            "build",
            "-w",
            "@hornhoof/protocol"
          ],
          "cwd": "."
        },
        {
          "program": "npm",
          "args": [
            "run",
            "build",
            "-w",
            "@hornhoof/node"
          ],
          "cwd": "."
        }
      ],
      "artifacts": [
        {
          "path": "packages/protocol/dist",
          "format": "directory"
        },
        {
          "path": "apps/node/dist",
          "format": "directory"
        }
      ]
    },
    {
      "id": "pglite",
      "profiles": [
        "fast",
        "final",
        "full"
      ],
      "serviceIds": [],
      "inputs": [
        "apps/server/drizzle/**/*.sql",
        "apps/server/drizzle/meta/_journal.json",
        "apps/server/src/db/schema.ts",
        "apps/server/src/db/client.ts",
        "packages/protocol/dist/**",
        "apps/server/test/prepare-environment.ts",
        "apps/server/test/global-setup.ts"
      ],
      "commands": [
        {
          "program": "node",
          "args": [
            "--import",
            "tsx",
            "test/prepare-environment.ts",
            "--output",
            "../../.hornhoof/prepared/pglite"
          ],
          "cwd": "apps/server"
        }
      ],
      "artifacts": [
        {
          "path": ".hornhoof/prepared/pglite",
          "format": "hornhoof-pglite-v1",
          "env": "HH_PGLITE_TEMPLATE"
        }
      ]
    },
    {
      "id": "postgres",
      "profiles": [
        "final",
        "full"
      ],
      "serviceIds": [
        "pg"
      ],
      "inputs": [
        "apps/server/drizzle/**/*.sql",
        "apps/server/drizzle/meta/_journal.json",
        "apps/server/src/db/schema.ts",
        "apps/server/src/db/client.ts",
        "packages/protocol/dist/**",
        "apps/server/test/prepare-environment.ts"
      ],
      "commands": [
        {
          "program": "node",
          "args": [
            "--import",
            "tsx",
            "test/prepare-environment.ts",
            "--postgres"
          ],
          "cwd": "apps/server"
        }
      ],
      "artifacts": [
        {
          "service": "pg",
          "path": "."
        }
      ]
    }
  ],
  "reset": [
    {
      "suiteIds": [
        "server"
      ],
      "scope": "file",
      "command": null,
      "inputs": [
        "apps/server/test/helpers.ts",
        "apps/server/test/global-setup.ts"
      ]
    },
    {
      "suiteIds": [
        "server-postgres"
      ],
      "scope": "file",
      "command": null,
      "inputs": [
        "apps/server/test/postgres/helpers.ts"
      ]
    }
  ],
  "suites": [
    {
      "id": "protocol",
      "root": "packages/protocol",
      "files": [
        "packages/protocol/test/**/*.test.ts"
      ],
      "run": {
        "program": "npx",
        "args": [
          "--no-install",
          "vitest",
          "run",
          "--config",
          "vitest.product.config.mjs",
          "--project=@hornhoof/protocol"
        ],
        "cwd": "."
      },
      "split": {
        "kind": "vitest-shard"
      },
      "profiles": [
        "fast",
        "final",
        "full"
      ],
      "finalChecks": []
    },
    {
      "id": "node",
      "root": "apps/node",
      "files": [
        "apps/node/test/**/*.test.ts"
      ],
      "run": {
        "program": "npx",
        "args": [
          "--no-install",
          "vitest",
          "run",
          "--config",
          "vitest.product.config.mjs",
          "--project=@hornhoof/node",
          "--project=@hornhoof/node:no-proc"
        ],
        "cwd": "."
      },
      "split": {
        "kind": "vitest-shard"
      },
      "profiles": [
        "fast",
        "final",
        "full"
      ],
      "finalChecks": []
    },
    {
      "id": "server",
      "root": "apps/server",
      "files": [
        "apps/server/test/**/*.test.ts"
      ],
      "run": {
        "program": "npx",
        "args": [
          "--no-install",
          "vitest",
          "run",
          "--config",
          "vitest.product.config.mjs",
          "--project=@hornhoof/server"
        ],
        "cwd": "."
      },
      "split": {
        "kind": "vitest-shard"
      },
      "profiles": [
        "fast",
        "final",
        "full"
      ],
      "finalChecks": []
    },
    {
      "id": "web",
      "root": "apps/web",
      "files": [
        "apps/web/test/**/*.test.ts",
        "apps/web/test/**/*.test.tsx"
      ],
      "run": {
        "program": "npx",
        "args": [
          "--no-install",
          "vitest",
          "run",
          "--config",
          "vitest.product.config.mjs",
          "--project=@hornhoof/web"
        ],
        "cwd": "."
      },
      "split": {
        "kind": "vitest-shard"
      },
      "profiles": [
        "fast",
        "final",
        "full"
      ],
      "finalChecks": []
    },
    {
      "id": "release-scripts",
      "root": "scripts",
      "files": [
        "scripts/test/*.test.mjs"
      ],
      "run": {
        "program": "node",
        "args": [
          "--test"
        ],
        "cwd": "."
      },
      "split": {
        "kind": "argv-files"
      },
      "profiles": [
        "fast",
        "final",
        "full"
      ],
      "finalChecks": []
    },
    {
      "id": "server-postgres",
      "root": "apps/server",
      "files": [
        "apps/server/test/postgres/**/*.pg.spec.ts"
      ],
      "run": {
        "program": "npx",
        "args": [
          "--no-install",
          "vitest",
          "run",
          "--config",
          "vitest.product.config.mjs",
          "--project=@hornhoof/server:postgres"
        ],
        "cwd": "."
      },
      "split": {
        "kind": "vitest-shard"
      },
      "profiles": [
        "final",
        "full"
      ],
      "finalChecks": []
    },
    {
      "id": "browser",
      "root": "apps/web/e2e",
      "files": [
        "apps/web/e2e/**/*.spec.ts"
      ],
      "run": {
        "program": "npx",
        "args": [
          "--no-install",
          "playwright",
          "test",
          "--project=chromium",
          "--workers=2",
          "--pass-with-no-tests"
        ],
        "cwd": "apps/web"
      },
      "split": {
        "kind": "argv-files"
      },
      "profiles": [
        "final",
        "full"
      ],
      "finalChecks": [],
      "scenarioSources": "apps/web/src"
    },
    {
      "id": "browser-matrix",
      "root": "apps/web/e2e",
      "files": [
        "apps/web/e2e/**/*.spec.ts"
      ],
      "run": {
        "program": "npx",
        "args": [
          "--no-install",
          "playwright",
          "test",
          "--project=matrix",
          "--workers=2",
          "--pass-with-no-tests"
        ],
        "cwd": "apps/web"
      },
      "split": {
        "kind": "argv-files"
      },
      "profiles": [
        "full"
      ],
      "finalChecks": [],
      "scenarioSources": "apps/web/src"
    },
    {
      "id": "mutation",
      "root": "scripts/mutation",
      "files": [
        "apps/node/src/redact.ts",
        "apps/node/src/terminal/operator-question.ts",
        "apps/server/src/auth/decision-owner.ts",
        "apps/server/src/auth/decisions.ts",
        "apps/server/src/auth/limit.ts",
        "apps/server/src/auth/password.ts",
        "apps/server/src/modules/outbound/checks.ts",
        "apps/server/src/modules/outbound/delivery.ts",
        "apps/server/src/modules/outbound/render.ts"
      ],
      "run": {
        "program": "node",
        "args": [
          "scripts/mutation/run.mjs"
        ],
        "cwd": "."
      },
      "split": {
        "kind": "json-file"
      },
      "profiles": [
        "final",
        "full"
      ],
      "finalChecks": [],
      "keep": [
        ".metrics/mutate"
      ]
    }
  ],
  "impact": {
    "adapter": "typescript",
    "fullPackageGlobs": [
      {
        "globs": [
          "package.json",
          "package-lock.json",
          "tsconfig.base.json",
          "eslint.config.js",
          ".hornhoof/test-environment.json"
        ],
        "suiteIds": [
          "protocol",
          "node",
          "server",
          "web",
          "release-scripts",
          "server-postgres",
          "browser",
          "browser-matrix"
        ]
      },
      {
        "globs": [
          "apps/server/drizzle/**",
          "apps/server/src/db/schema.ts",
          "apps/server/test/global-setup.ts",
          "apps/server/test/prepare-environment.ts",
          "apps/server/vitest*.config.ts"
        ],
        "suiteIds": [
          "server",
          "server-postgres"
        ]
      },
      {
        "globs": [
          "apps/node/Dockerfile",
          "apps/node/service-runtime-smoke.mjs"
        ],
        "suiteIds": [
          "node",
          "server-postgres"
        ]
      },
      {
        "globs": [
          "vitest.product.config.mjs",
          "vitest.config.mjs",
          "scripts/test/workspace-cwd.mjs",
          "apps/server/test/planned-vitest-sequencer.ts",
          "apps/server/vitest.run-planning.config.ts",
          "apps/server/test/test-run-invocations.cli.ts",
          "apps/server/test/fixtures/run-planning/**"
        ],
        "suiteIds": [
          "protocol",
          "node",
          "server",
          "web",
          "release-scripts",
          "server-postgres"
        ]
      },
      {
        "globs": [
          "apps/web/playwright.config.ts",
          "apps/web/vite.config.ts",
          "apps/web/index.html",
          "apps/web/package.json",
          "apps/web/tsconfig.json",
          "apps/web/src/App.tsx",
          "apps/web/src/main.tsx",
          "apps/web/src/theme.css"
        ],
        "suiteIds": [
          "browser",
          "browser-matrix"
        ]
      },
      {
        "globs": [
          "packages/protocol/test/**"
        ],
        "suiteIds": [
          "protocol"
        ]
      },
      {
        "globs": [
          "packages/protocol/test/fixtures/**"
        ],
        "suiteIds": [
          "protocol",
          "server"
        ]
      },
      {
        "globs": [
          "apps/node/src/test-impact*.ts",
          "apps/node/src/test-environment.ts",
          "apps/node/src/test-fingerprint.ts"
        ],
        "suiteIds": [
          "node",
          "release-scripts"
        ]
      },
      {
        "globs": [
          "templates/**"
        ],
        "suiteIds": [
          "server",
          "node"
        ]
      },
      {
        "globs": [
          ".github/workflows/**",
          "scripts/install.sh",
          "apps/updater/**",
          "Dockerfile",
          "compose.yaml",
          ".dockerignore"
        ],
        "suiteIds": [
          "release-scripts",
          "server"
        ]
      }
    ],
    "migrationCheck": {
      "status": "unsupported",
      "reason": "No down migration command is defined; tracked in #309."
    }
  },
  "mutation": {
    "status": "supported",
    "tool": "mutator",
    "language": "typescript",
    "sourcePaths": [
      "apps/node/src/redact.ts",
      "apps/node/src/terminal/operator-question.ts",
      "apps/server/src/auth/decision-owner.ts",
      "apps/server/src/auth/decisions.ts",
      "apps/server/src/auth/limit.ts",
      "apps/server/src/auth/password.ts",
      "apps/server/src/modules/outbound/checks.ts",
      "apps/server/src/modules/outbound/delivery.ts",
      "apps/server/src/modules/outbound/render.ts"
    ],
    "fastTestPaths": [
      "apps/node/test/redact.test.ts",
      "apps/node/test/operator-question.test.ts",
      "apps/server/test/crypto.test.ts",
      "apps/server/test/decision-policy.test.ts",
      "apps/server/test/limit.test.ts",
      "apps/server/test/outbound-checks.test.ts",
      "apps/server/test/outbound-delivery.test.ts",
      "apps/server/test/outbound-render.test.ts"
    ],
    "coverageCommands": [
      {
        "program": "npx",
        "args": [
          "--no-install",
          "vitest",
          "run",
          "test/redact.test.ts",
          "--coverage",
          "--coverage.include=src/redact.ts",
          "--coverage.reporter=lcov"
        ],
        "cwd": "apps/node"
      }
    ],
    "coverageFiles": [
      "apps/node/coverage/lcov.info"
    ],
    "command": {
      "program": "node",
      "args": [
        "scripts/mutation/run.mjs"
      ],
      "cwd": "."
    }
  },
  "execution": {
    "version": 2,
    "oncePreparation": {
      "profiles": [
        "final",
        "full"
      ],
      "suiteIds": [
        "protocol"
      ],
      "commands": [
        {
          "program": "node",
          "args": [
            "scripts/check-release.mjs",
            "--local"
          ],
          "cwd": "."
        },
        {
          "program": "npm",
          "args": [
            "run",
            "lint:part",
            "--workspaces",
            "--include-workspace-root",
            "--"
          ],
          "cwd": "."
        },
        {
          "program": "npx",
          "args": [
            "--no-install",
            "tsc",
            "-p",
            "packages/protocol/tsconfig.json",
            "--noEmit"
          ],
          "cwd": "."
        },
        {
          "program": "npx",
          "args": [
            "--no-install",
            "tsc",
            "-p",
            "apps/server/tsconfig.eslint.json",
            "--noEmit"
          ],
          "cwd": "."
        },
        {
          "program": "npx",
          "args": [
            "--no-install",
            "tsc",
            "-p",
            "apps/node/tsconfig.eslint.json",
            "--noEmit"
          ],
          "cwd": "."
        },
        {
          "program": "npx",
          "args": [
            "--no-install",
            "tsc",
            "-p",
            "packages/protocol/tsconfig.eslint.json",
            "--noEmit"
          ],
          "cwd": "."
        },
        {
          "program": "npx",
          "args": [
            "--no-install",
            "tsc",
            "-p",
            "apps/node/tsconfig.json",
            "--noEmit"
          ],
          "cwd": "."
        },
        {
          "program": "npx",
          "args": [
            "--no-install",
            "tsc",
            "-p",
            "apps/server/tsconfig.json",
            "--noEmit"
          ],
          "cwd": "."
        },
        {
          "program": "npx",
          "args": [
            "--no-install",
            "tsc",
            "-p",
            "apps/web/tsconfig.json",
            "--noEmit"
          ],
          "cwd": "."
        }
      ]
    },
    "fullRun": {
      "everyTurns": 5,
      "replaces": "final",
      "profile": "full"
    }
  }
}
