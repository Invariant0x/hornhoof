{
  "name": "hornhoof",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run build -w @hornhoof/protocol && npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w apps/server"
  }
}
