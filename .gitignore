node_modules/
dist/
.env
.env.*
.DS_Store
coverage/
apps/web/e2e/results/
.metrics/
target/
# Raw run logs, profiles and build output are never committed (hh-task-flow, #1286):
# proof goes into the task's submit or report, long logs are attached to the task.
*.log
*.cpuprofile
*.heapprofile
*.heapsnapshot
*.tsbuildinfo

# Raw task evidence belongs in task or release attachments; keep short reports.
/docs/evidence/**
!/docs/evidence/**/
!/docs/evidence/**/*.md
/docs/tasks/*
!/docs/tasks/*.md
/docs/task-*-evidence/
/docs/task-*-proof/
/docs/task-*.txt
/docs/task-*-series.mjs
/docs/superpowers/reports/*.json
/docs/superpowers/reports/*.sh.txt

# Licensed world pack art is served from here locally and never committed (ARTIST_CONTRACT.md).
/apps/web/public/world-art/
